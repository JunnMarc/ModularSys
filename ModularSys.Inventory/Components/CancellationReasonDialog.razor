@using Radzen
@inject DialogService DialogService

<div style="padding: 24px;">
    <div style="margin-bottom: 24px;">
        <h3 style="font-size: 1.5rem; font-weight: 600; color: #1f2937; margin: 0 0 8px 0;">@Title</h3>
        <p style="color: #6b7280; font-size: 0.95rem; margin: 0;">@Message</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-bottom: 20px;">
        @foreach (var option in Options)
        {
            var isSelected = _selectedReason == option;
            var cardStyle = isSelected 
                ? "background: #eff6ff; border: 2px solid #3b82f6; cursor: pointer; border-radius: 8px; padding: 16px; transition: all 0.2s; box-shadow: 0 2px 4px rgba(59, 130, 246, 0.2);"
                : "background: white; border: 2px solid #e5e7eb; cursor: pointer; border-radius: 8px; padding: 16px; transition: all 0.2s; box-shadow: 0 1px 2px rgba(0,0,0,0.05);";
            
            <div style="@cardStyle" @onclick="() => SelectReason(option)" @onmouseover="@((e) => HoverCard(e, true))" @onmouseout="@((e) => HoverCard(e, false))">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <div style="@(isSelected ? "width: 20px; height: 20px; border-radius: 50%; background: #3b82f6; display: flex; align-items: center; justify-content: center; flex-shrink: 0;" : "width: 20px; height: 20px; border-radius: 50%; border: 2px solid #d1d5db; flex-shrink: 0;")">
                        @if (isSelected)
                        {
                            <span style="color: white; font-size: 12px;">✓</span>
                        }
                    </div>
                    <span style="@(isSelected ? "color: #1f2937; font-weight: 500; font-size: 0.95rem;" : "color: #4b5563; font-size: 0.95rem;")">@option</span>
                </div>
            </div>
        }
    </div>

    @if (AllowCustomReason && _selectedReason == "Other")
    {
        <div style="margin-bottom: 20px;">
            <RadzenTextArea @bind-Value="_customReason"
                          Placeholder="Please specify the reason..."
                          Rows="3"
                          Style="width: 100%; border: 2px solid #e5e7eb; border-radius: 8px; padding: 12px; font-size: 0.95rem;" />
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 12px; margin-bottom: 20px;">
            <p style="color: #dc2626; font-size: 0.875rem; margin: 0;">@_errorMessage</p>
        </div>
    }

    <div style="display: flex; justify-content: flex-end; gap: 12px; padding-top: 16px; border-top: 1px solid #e5e7eb;">
        <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="Cancel" Style="min-width: 100px;" />
        <RadzenButton Text="Cancel Order" ButtonStyle="ButtonStyle.Danger" Icon="cancel" Click="Submit" Style="min-width: 140px;" />
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Cancel Order";
    [Parameter] public string Message { get; set; } = "Please select a reason:";
    [Parameter] public string[] Options { get; set; } = Array.Empty<string>();
    [Parameter] public bool AllowCustomReason { get; set; } = true;

    private string? _selectedReason;
    private string _customReason = string.Empty;
    private string _errorMessage = string.Empty;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Console.WriteLine($"Dialog initialized with {Options?.Length ?? 0} options");
        if (Options != null)
        {
            foreach (var option in Options)
            {
                Console.WriteLine($"Option: {option}");
            }
        }
    }

    private void SelectReason(string reason)
    {
        _selectedReason = reason;
        _errorMessage = string.Empty;
        StateHasChanged();
    }

    private void HoverCard(MouseEventArgs e, bool isHovering)
    {
        // Optional: Add hover effects if needed
    }

    private void Submit()
    {
        _errorMessage = string.Empty;
        Console.WriteLine($"Submit called. Selected reason: '{_selectedReason}'");

        if (string.IsNullOrEmpty(_selectedReason))
        {
            _errorMessage = "Please select a reason for cancellation.";
            Console.WriteLine("No reason selected, showing error");
            StateHasChanged();
            return;
        }

        if (_selectedReason == "Other" && AllowCustomReason)
        {
            if (string.IsNullOrWhiteSpace(_customReason))
            {
                _errorMessage = "Please provide a custom reason for cancellation.";
                StateHasChanged();
                return;
            }
            DialogService.Close(_customReason.Trim());
        }
        else
        {
            DialogService.Close(_selectedReason);
        }
    }

    private void Cancel()
    {
        DialogService.Close(null);
    }
}