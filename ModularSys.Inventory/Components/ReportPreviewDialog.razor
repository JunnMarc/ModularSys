@using ModularSys.Inventory.Models
@using ModularSys.Inventory.Interface
@using System.IO
@inject IAnalyticalReportService AnalyticalReportService
@inject NotificationService NotificationService

<RadzenCard>
    <RadzenStack Gap="1rem" Style="padding: 1rem;">
        <!-- Report Header -->
        <RadzenStack Gap="1rem">
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="8">
                    <RadzenStack Gap="0.25rem">
                        <RadzenText Text="ModularSys Enterprise" Style="font-size: 1.5rem; font-weight: 600; color: var(--rz-primary);" />
                        <RadzenText Text="123 Business District, Metro Manila, Philippines" Style="color: var(--rz-text-secondary);" />
                        <RadzenText Text="Phone: +63 2 8123 4567 | Email: info@modularsys.com" Style="color: var(--rz-text-secondary);" />
                        <RadzenText Text="Tax ID: 123-456-789-000" Style="color: var(--rz-text-secondary);" />
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenStack Gap="0.25rem" Style="text-align: right;">
                        <RadzenText Text="@ReportType.ToString().Replace("_", " ")" Style="font-size: 1.25rem; font-weight: 600; color: var(--rz-primary);" />
                        <RadzenText Text="@($"Report Date: {DateTime.Now:MMMM dd, yyyy}")" />
                        <RadzenText Text="@($"Period: {StartDate:MMM dd} - {EndDate:MMM dd, yyyy}")" />
                        <RadzenText Text="Prepared by: System Administrator" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>

            <RadzenSeparator />

            <!-- Report Preview Content -->
            <RadzenText Text="Report Preview" Style="font-size: 1.25rem; font-weight: 600; color: var(--rz-primary);" />

            @if (ReportType == AnalyticalReportType.InventoryValuation && ReportData is InventoryValuationReport valuationReport)
            {
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenCard Style="background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%); color: white;">
                            <RadzenStack Gap="0.25rem">
                                <RadzenText Text="Total Inventory Value" Style="opacity: 0.9;" />
                                <RadzenText Text="@($"₱{valuationReport.TotalInventoryValue:N2}")" Style="font-size: 1.5rem; font-weight: 600;" />
                            </RadzenStack>
                        </RadzenCard>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenCard Style="background: linear-gradient(135deg, #2196F3 0%, #1976D2 100%); color: white;">
                            <RadzenStack Gap="0.25rem">
                                <RadzenText Text="Categories" Style="opacity: 0.9;" />
                                <RadzenText Text="@valuationReport.CategoryBreakdown.Count.ToString()" Style="font-size: 1.5rem; font-weight: 600;" />
                            </RadzenStack>
                        </RadzenCard>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenCard Style="background: linear-gradient(135deg, #FF9800 0%, #F57C00 100%); color: white;">
                            <RadzenStack Gap="0.25rem">
                                <RadzenText Text="Total SKUs" Style="opacity: 0.9;" />
                                <RadzenText Text="@valuationReport.Items.Count.ToString()" Style="font-size: 1.5rem; font-weight: 600;" />
                            </RadzenStack>
                        </RadzenCard>
                    </RadzenColumn>
                </RadzenRow>
            }
            else if (ReportType == AnalyticalReportType.CostOfGoodsSold && ReportData is COGSReport cogsReport)
            {
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenCard Style="background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%); color: white;">
                            <RadzenStack Gap="0.25rem">
                                <RadzenText Text="Net Sales" Style="opacity: 0.9;" />
                                <RadzenText Text="@($"₱{cogsReport.NetSales:N2}")" Style="font-size: 1.5rem; font-weight: 600;" />
                            </RadzenStack>
                        </RadzenCard>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenCard Style="background: linear-gradient(135deg, #F44336 0%, #D32F2F 100%); color: white;">
                            <RadzenStack Gap="0.25rem">
                                <RadzenText Text="COGS" Style="opacity: 0.9;" />
                                <RadzenText Text="@($"₱{cogsReport.CostOfGoodsSold:N2}")" Style="font-size: 1.5rem; font-weight: 600;" />
                            </RadzenStack>
                        </RadzenCard>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenCard Style="background: linear-gradient(135deg, #2196F3 0%, #1976D2 100%); color: white;">
                            <RadzenStack Gap="0.25rem">
                                <RadzenText Text="Gross Profit" Style="opacity: 0.9;" />
                                <RadzenText Text="@($"₱{cogsReport.GrossProfit:N2}")" Style="font-size: 1.5rem; font-weight: 600;" />
                            </RadzenStack>
                        </RadzenCard>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenCard Style="background: linear-gradient(135deg, #9C27B0 0%, #7B1FA2 100%); color: white;">
                            <RadzenStack Gap="0.25rem">
                                <RadzenText Text="Profit Margin" Style="opacity: 0.9;" />
                                <RadzenText Text="@($"{cogsReport.GrossProfitMargin:F1}%")" Style="font-size: 1.5rem; font-weight: 600;" />
                            </RadzenStack>
                        </RadzenCard>
                    </RadzenColumn>
                </RadzenRow>
            }
            else
            {
                <RadzenAlert AlertStyle="AlertStyle.Info" Title="@($"Report preview will be available after generating the {ReportType} report.")" />
            }

            <!-- Report Description -->
            <RadzenText Text="Report Description" Style="font-size: 1.125rem; font-weight: 600; color: var(--rz-primary);" />
            
            <RadzenText Text="@($"This {ReportType.ToString().Replace("_", " ")} report provides comprehensive analysis of your inventory data using GAAP-compliant accounting methods. The report includes detailed breakdowns, performance metrics, and actionable business insights to help optimize your inventory management.")" />

            <!-- GAAP Compliance Notes -->
            <RadzenText Text="GAAP Compliance Notes" Style="font-size: 1.125rem; font-weight: 600; color: var(--rz-primary);" />
            <RadzenList>
                <RadzenListItem>
                    <RadzenIcon Icon="check_circle" Style="color: var(--rz-success); margin-right: 0.5rem;" />
                    <RadzenText Text="This report follows Generally Accepted Accounting Principles (GAAP)" />
                </RadzenListItem>
                <RadzenListItem>
                    <RadzenIcon Icon="check_circle" Style="color: var(--rz-success); margin-right: 0.5rem;" />
                    <RadzenText Text="Inventory valuation uses Weighted Average Cost method" />
                </RadzenListItem>
                <RadzenListItem>
                    <RadzenIcon Icon="check_circle" Style="color: var(--rz-success); margin-right: 0.5rem;" />
                    <RadzenText Text="COGS calculation: Beginning Inventory + Purchases - Ending Inventory" />
                </RadzenListItem>
                <RadzenListItem>
                    <RadzenIcon Icon="check_circle" Style="color: var(--rz-success); margin-right: 0.5rem;" />
                    <RadzenText Text="All figures are in Philippine Pesos (₱)" />
                </RadzenListItem>
            </RadzenList>

            <!-- Footer -->
            <RadzenSeparator />
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="6">
                    <RadzenText Text="@($"Generated on {DateTime.Now:MMMM dd, yyyy 'at' hh:mm tt}")" Style="color: var(--rz-text-secondary); font-size: 0.875rem;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenText Text="ModuERP Inventory Management System" Style="color: var(--rz-text-secondary); font-size: 0.875rem; text-align: right;" />
                </RadzenColumn>
            </RadzenRow>
        </RadzenStack>
    </RadzenStack>
</RadzenCard>

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" Style="padding: 1rem;">
    <RadzenButton Text="Close Preview" ButtonStyle="ButtonStyle.Light" Click="Cancel" />
    <RadzenButton Text="@(_exporting ? "Exporting..." : "Export to PDF")" 
                  ButtonStyle="ButtonStyle.Primary" 
                  Icon="picture_as_pdf"
                  Click="ExportToPdf"
                  Disabled="@_exporting" />
</RadzenStack>

@code {
    [Parameter] public AnalyticalReportType ReportType { get; set; }
    [Parameter] public DateTime StartDate { get; set; }
    [Parameter] public DateTime EndDate { get; set; }
    [Parameter] public object? ReportData { get; set; }
    [Parameter] public EventCallback<string> OnResult { get; set; }

    private bool _exporting = false;

    private async Task Cancel() => await OnResult.InvokeAsync("");

    private async Task ExportToPdf()
    {
        _exporting = true;
        StateHasChanged();

        try
        {
            var request = new AnalyticalReportRequest
            {
                ReportType = ReportType,
                StartDate = StartDate,
                EndDate = EndDate,
                IncludeCharts = true,
                IncludeDetailedBreakdown = true,
                ExportFormat = ReportExportFormat.PDF
            };

            // Generate PDF using QuestPDF
            var pdfBytes = await AnalyticalReportService.GenerateCrystalReportAsync(request);
            
            // Save PDF to Downloads folder
            var fileName = $"{ReportType}_Report_{DateTime.Now:yyyyMMdd_HHmmss}.pdf";
            var downloadsPath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "Downloads");
            var filePath = Path.Combine(downloadsPath, fileName);
            
            await File.WriteAllBytesAsync(filePath, pdfBytes);
            
            NotificationService.Notify(NotificationSeverity.Success, "Success", $"Report exported successfully to Downloads folder: {fileName}");
            await OnResult.InvokeAsync($"Report exported to: {fileName}");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", $"Error exporting report: {ex.Message}");
            await OnResult.InvokeAsync("");
        }
        finally
        {
            _exporting = false;
            StateHasChanged();
        }
    }
}