@using ModularSys.Data.Common.Entities.Inventory
@using ModularSys.Inventory.Interface
@using ModularSys.Inventory.Models
@using Radzen
@using Radzen.Blazor

@inject IPurchaseOrderService PurchaseOrderService
@inject IProductService ProductService
@inject DialogService DialogService
@inject NotificationService NotificationService

<div style="width: 100%; max-width: 100%; max-height: 90vh; display: flex; flex-direction: column; background: transparent;">
    <!-- Header -->
    <div style="padding: 24px; border-bottom: 1px solid #e5e7eb; flex-shrink: 0; background: transparent;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 56px; height: 56px; border-radius: 12px; background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); display: flex; align-items: center; justify-content: center;">
                <RadzenIcon Icon="shopping_bag" Style="color: white; font-size: 1.75rem;" />
            </div>
            <div>
                <h2 style="margin: 0; font-size: 1.5rem; font-weight: 600; color: #1f2937;">
                    @(_isEditMode ? "Edit Purchase Order" : "New Purchase Order")
                </h2>
                <p style="margin: 4px 0 0 0; color: #9ca3af; font-size: 0.875rem;">
                    @(_isEditMode ? "Modify existing purchase order details" : "Create a new purchase order from supplier")
                </p>
            </div>
        </div>
    </div>

    <!-- Form Content -->
    <div style="padding: 24px; flex: 1; background: transparent; overflow-y: auto;">
        <RadzenTemplateForm TItem="PurchaseOrderMultiInputModel" Data="@_model" Submit="@OnSubmit">
            <RadzenStack Gap="1.5rem">
                <!-- Order Information Section -->
                <div>
                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
                        <RadzenIcon Icon="info" Style="color: #8b5cf6;" />
                        <h3 style="margin: 0; font-size: 1rem; font-weight: 600; color: #374151;">Order Information</h3>
                    </div>
                    
                    <RadzenStack Gap="1rem">
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="6">
                                <RadzenFormField Text="Supplier Name" Variant="Variant.Outlined" Style="width: 100%;">
                                    <RadzenTextBox @bind-Value="_model.SupplierName" 
                                                  Placeholder="Enter supplier name"
                                                  Style="width: 100%; height: 40px;" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="6">
                                <RadzenFormField Text="Supplier Email" Variant="Variant.Outlined" Style="width: 100%;">
                                    <RadzenTextBox @bind-Value="_model.SupplierEmail" 
                                                  Placeholder="supplier@example.com"
                                                  Style="width: 100%; height: 40px;" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>
                        
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="6">
                                <RadzenFormField Text="Order Date" Variant="Variant.Outlined" Style="width: 100%;">
                                    <RadzenDatePicker TValue="DateTime?" 
                                                     @bind-Value="_model.OrderDate"
                                                     DateFormat="MM/dd/yyyy"
                                                     ShowTime="false"
                                                     ReadOnly="true"
                                                     Disabled="true"
                                                     Style="width: 100%; height: 40px; background: #f3f4f6; cursor: not-allowed;" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="6">
                                <RadzenFormField Text="Expected Delivery" Variant="Variant.Outlined" Style="width: 100%;">
                                    <RadzenDatePicker TValue="DateTime?" 
                                                     @bind-Value="_model.ExpectedDeliveryDate"
                                                     DateFormat="MM/dd/yyyy"
                                                     ShowTime="false"
                                                     Min="@_model.OrderDate"
                                                     Style="width: 100%; height: 40px;" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>
                        
                        <RadzenFormField Text="Order Notes" Variant="Variant.Outlined" Style="width: 100%;">
                            <RadzenTextArea @bind-Value="_model.Notes" 
                                           Placeholder="Additional notes or special instructions"
                                           Rows="3" 
                                           Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenStack>
                </div>

                <!-- Order Items Section -->
                <div>
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <RadzenIcon Icon="shopping_cart" Style="color: #8b5cf6;" />
                            <h3 style="margin: 0; font-size: 1rem; font-weight: 600; color: #374151;">Order Items (@_model.Lines.Count)</h3>
                        </div>
                        <RadzenButton Text="ADD ITEM"
                                    Icon="add"
                                    ButtonStyle="ButtonStyle.Primary"
                                    Size="ButtonSize.Small"
                                    Click="AddLine"
                                    Style="background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); border: none;" />
                    </div>

                    @if (_model.Lines.Any())
                    {
                        <RadzenStack Gap="1rem">
                            @foreach (var (line, index) in _model.Lines.Select((line, i) => (line, i)))
                            {
                                <div style="background: white; border: 1px solid #e5e7eb; border-radius: 8px; padding: 16px;">
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                                        <span style="color: #8b5cf6; font-weight: 600;">Item #@(index + 1)</span>
                                        <RadzenButton Icon="delete"
                                                    ButtonStyle="ButtonStyle.Danger"
                                                    Size="ButtonSize.Small"
                                                    Variant="Variant.Text"
                                                    Click="@(() => RemoveLine(line))" />
                                    </div>

                                    <RadzenStack Gap="1rem">
                                        <RadzenFormField Text="Product" Variant="Variant.Outlined" Style="width: 100%;">
                                            <RadzenDropDown TValue="int"
                                                          @bind-Value="line.ProductId"
                                                          Placeholder="Select a product..."
                                                          Style="width: 100%; height: 40px;"
                                                          Data="@_products"
                                                          TextProperty="Name"
                                                          ValueProperty="ProductId"
                                                          Change="@(args => OnProductChanged(line, Convert.ToInt32(args)))"
                                                          AllowClear="false" />
                                        </RadzenFormField>
                                        
                                        <RadzenRow Gap="1rem">
                                            <RadzenColumn Size="4">
                                                <RadzenFormField Text="Quantity" Variant="Variant.Outlined" Style="width: 100%;">
                                                    <RadzenNumeric TValue="int" 
                                                                 @bind-Value="line.Quantity"
                                                                 Min="1"
                                                                 ShowUpDown="false"
                                                                 Change="@(() => StateHasChanged())"
                                                                 Style="width: 100%; height: 40px;" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                            <RadzenColumn Size="4">
                                                <RadzenFormField Text="Unit Cost" Variant="Variant.Outlined" Style="width: 100%;">
                                                    <RadzenNumeric TValue="decimal" 
                                                                 @bind-Value="line.UnitCost"
                                                                 ShowUpDown="false"
                                                                 Change="@(() => StateHasChanged())"
                                                                 Style="width: 100%; height: 40px;"
                                                                 Format="C" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                            <RadzenColumn Size="4">
                                                <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; padding-top: 8px;">
                                                    <span style="font-size: 0.75rem; color: #6b7280; margin-bottom: 4px;">Line Total</span>
                                                    <span style="font-size: 1.25rem; font-weight: 600; color: #8b5cf6;">₱@line.LineTotal.ToString("#,##0.00")</span>
                                                </div>
                                            </RadzenColumn>
                                        </RadzenRow>
                                    </RadzenStack>
                                </div>
                            }
                        </RadzenStack>
                    }
                    else
                    {
                        <div style="text-align: center; padding: 40px; background: #f9fafb; border: 2px dashed #e5e7eb; border-radius: 8px;">
                            <RadzenIcon Icon="shopping_cart" Style="font-size: 48px; color: #d1d5db; margin-bottom: 12px;" />
                            <p style="color: #6b7280; margin: 8px 0;">No items added yet</p>
                            <p style="color: #9ca3af; font-size: 0.875rem; margin-bottom: 16px;">Add items to create the purchase order</p>
                            <RadzenButton Text="Add First Item"
                                        Icon="add"
                                        ButtonStyle="ButtonStyle.Primary"
                                        Click="AddLine"
                                        Style="background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); border: none;" />
                        </div>
                    }
                </div>

                <!-- Order Summary -->
                @if (_model.Lines.Any())
                {
                    <div style="background: white; border: 1px solid #e5e7eb; border-radius: 8px; padding: 20px;">
                        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
                            <RadzenIcon Icon="receipt" Style="color: #10b981;" />
                            <h3 style="margin: 0; font-size: 1rem; font-weight: 600; color: #374151;">Order Summary</h3>
                        </div>
                        <RadzenStack Gap="0.75rem">
                            <div style="display: flex; justify-content: space-between;">
                                <span style="color: #6b7280;">Subtotal:</span>
                                <span style="font-weight: 600;">₱@_model.SubTotal.ToString("#,##0.00")</span>
                            </div>
                            <div style="display: flex; justify-content: space-between;">
                                <span style="color: #6b7280;">Tax (12%):</span>
                                <span style="font-weight: 600;">₱@_model.TaxAmount.ToString("#,##0.00")</span>
                            </div>
                            <div style="height: 1px; background: #e5e7eb; margin: 8px 0;"></div>
                            <div style="display: flex; justify-content: space-between;">
                                <span style="font-size: 1.125rem; font-weight: 600; color: #10b981;">Grand Total:</span>
                                <span style="font-size: 1.125rem; font-weight: 700; color: #10b981;">₱@_model.GrandTotal.ToString("#,##0.00")</span>
                            </div>
                            <div style="text-align: center; padding-top: 8px;">
                                <span style="color: #6b7280; font-size: 0.875rem;">Total Items: </span>
                                <span style="color: #8b5cf6; font-weight: 600; font-size: 1.25rem;">@_model.Lines.Sum(l => l.Quantity)</span>
                            </div>
                        </RadzenStack>
                    </div>
                }
            </RadzenStack>
        </RadzenTemplateForm>
    </div>

    <!-- Footer Actions -->
    <div style="padding: 16px 24px; border-top: 1px solid #e5e7eb; background: white; display: flex; justify-content: flex-end; gap: 12px; flex-shrink: 0;">
        <RadzenButton Text="Cancel"
                     Icon="close"
                     ButtonStyle="ButtonStyle.Light"
                     Click="@Cancel"
                     Style="min-width: 100px;" />
        <RadzenButton Text="@(_isEditMode ? "Update" : "Create Order")"
                     Icon="@(_isEditMode ? "save" : "add")"
                     Click="@OnSubmit"
                     ButtonStyle="ButtonStyle.Primary"
                     Disabled="@(!_model.Lines.Any())"
                     Style="min-width: 120px; background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); border: none;" />
    </div>
</div>

@code {
    [Parameter] public int? Id { get; set; }
    
    private PurchaseOrderMultiInputModel _model = new();
    private List<Product> _products = new();
    private bool _isEditMode => Id.HasValue;
    
    protected override async Task OnInitializedAsync()
    {
        // Load products
        _products = (await ProductService.GetAllAsync()).ToList();

        if (_isEditMode)
        {
            // Load existing order for editing
            var order = await PurchaseOrderService.GetByIdAsync(Id.Value);
            if (order != null)
            {
                _model = new PurchaseOrderMultiInputModel
                {
                    SupplierName = order.SupplierName,
                    SupplierEmail = order.SupplierEmail,
                    OrderDate = order.OrderDate,
                    ExpectedDeliveryDate = order.ExpectedDeliveryDate,
                    Notes = order.Notes
                };
            }
        }
        else
        {
            _model.OrderDate = DateTime.Today;
        }
    }

    private void AddLine()
    {
        _model.Lines.Add(new PurchaseOrderLineInputModel
        {
            Quantity = 1,
            UnitCost = 0
        });
    }

    private void RemoveLine(PurchaseOrderLineInputModel line)
    {
        _model.Lines.Remove(line);
    }

    private void OnProductChanged(PurchaseOrderLineInputModel line, int productId)
    {
        var product = _products.FirstOrDefault(p => p.ProductId == productId);
        if (product != null)
        {
            line.UnitCost = product.CostPrice;
        }
        StateHasChanged();
    }
    
    private async Task OnSubmit()
    {
        try
        {
            // Validate that all lines have products selected
            if (_model.Lines.Any(l => l.ProductId == 0))
            {
                NotificationService.Notify(NotificationSeverity.Error, "Validation Error", "Please select a product for all order lines.");
                return;
            }

            if (_isEditMode)
            {
                var existingOrder = await PurchaseOrderService.GetByIdAsync(Id.Value);
                if (existingOrder != null)
                {
                    // Map the input model to the entity
                    existingOrder.SupplierName = _model.SupplierName;
                    existingOrder.SupplierEmail = _model.SupplierEmail;
                    existingOrder.SupplierPhone = _model.SupplierPhone;
                    existingOrder.SupplierAddress = _model.SupplierAddress;
                    existingOrder.ExpectedDeliveryDate = _model.ExpectedDeliveryDate;
                    existingOrder.Notes = _model.Notes;
                    existingOrder.UpdatedAt = DateTime.UtcNow;
                    
                    // Update lines
                    existingOrder.Lines.Clear();
                    foreach (var line in _model.Lines)
                    {
                        existingOrder.Lines.Add(new PurchaseOrderLine
                        {
                            ProductId = line.ProductId,
                            Quantity = line.Quantity,
                            UnitCost = line.UnitCost
                        });
                    }
                    
                    await PurchaseOrderService.UpdateAsync(existingOrder);
                }
                NotificationService.Notify(NotificationSeverity.Success, "Success", "Purchase order updated successfully");
            }
            else
            {
                // Create new entity from input model
                var newOrder = new PurchaseOrder
                {
                    OrderNumber = GenerateOrderNumber(),
                    OrderDate = _model.OrderDate ?? DateTime.Today,
                    ExpectedDeliveryDate = _model.ExpectedDeliveryDate,
                    SupplierName = _model.SupplierName,
                    SupplierEmail = _model.SupplierEmail,
                    SupplierPhone = _model.SupplierPhone,
                    SupplierAddress = _model.SupplierAddress,
                    Notes = _model.Notes,
                    Status = "Pending",
                    CreatedAt = DateTime.UtcNow,
                    UpdatedAt = DateTime.UtcNow,
                    Lines = _model.Lines.Select(l => new PurchaseOrderLine
                    {
                        ProductId = l.ProductId,
                        Quantity = l.Quantity,
                        UnitCost = l.UnitCost
                    }).ToList()
                };
                
                await PurchaseOrderService.CreateAsync(newOrder);
                NotificationService.Notify(NotificationSeverity.Success, "Success", "Purchase order created successfully");
            }
            
            DialogService.Close(true);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", $"Failed to save purchase order: {ex.Message}");
        }
    }
    
    private void Cancel()
    {
        DialogService.Close(false);
    }
    
    private string GenerateOrderNumber()
    {
        return $"PO-{DateTime.Now:yyyyMMdd}-{DateTime.Now.Ticks % 10000:D4}";
    }
}
