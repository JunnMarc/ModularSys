@using ModularSys.Data.Common.Entities.Inventory
@using ModularSys.Inventory.Interface
@using ModularSys.Inventory.Models
@using Radzen
@using Radzen.Blazor

@inject IPurchaseOrderService PurchaseOrderService
@inject DialogService DialogService
@inject NotificationService NotificationService

<RadzenTemplateForm TItem="PurchaseOrderMultiInputModel" Data="@_model" Submit="@OnSubmit">
    <RadzenStack Gap="1rem">
        <RadzenText TextStyle="TextStyle.H5" Text="@(_isEditMode ? "Edit Purchase Order" : "New Purchase Order")" />
        
        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenText TextStyle="TextStyle.H6" Text="Order Information" />
                
                <RadzenRow>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenLabel Text="Supplier Name" />
                        <RadzenTextBox @bind-Value="_model.SupplierName" Style="width: 100%;" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenLabel Text="Supplier Email" />
                        <RadzenTextBox @bind-Value="_model.SupplierEmail" Style="width: 100%;" />
                    </RadzenColumn>
                </RadzenRow>
                
                <RadzenRow>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenLabel Text="Order Date" />
                        <RadzenDatePicker @bind-Value="_model.OrderDate" Style="width: 100%;" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenLabel Text="Expected Delivery" />
                        <RadzenDatePicker @bind-Value="_model.ExpectedDeliveryDate" Style="width: 100%;" />
                    </RadzenColumn>
                </RadzenRow>
                
                <RadzenLabel Text="Order Notes" />
                <RadzenTextArea @bind-Value="_model.Notes" Rows="3" Style="width: 100%;" />
            </RadzenStack>
        </RadzenCard>
        
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" JustifyContent="JustifyContent.End">
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@Cancel" />
            <RadzenButton Text="@(_isEditMode ? "Update Order" : "Create Order")" ButtonType="ButtonType.Submit" />
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    [Parameter] public int? Id { get; set; }
    
    private PurchaseOrderMultiInputModel _model = new();
    private bool _isEditMode => Id.HasValue;
    
    protected override async Task OnInitializedAsync()
    {
        if (_isEditMode)
        {
            // Load existing order for editing
            var order = await PurchaseOrderService.GetByIdAsync(Id.Value);
            if (order != null)
            {
                _model = new PurchaseOrderMultiInputModel
                {
                    SupplierName = order.SupplierName,
                    SupplierEmail = order.SupplierEmail,
                    OrderDate = order.OrderDate,
                    ExpectedDeliveryDate = order.ExpectedDeliveryDate,
                    Notes = order.Notes
                };
            }
        }
        else
        {
            _model.OrderDate = DateTime.Today;
        }
    }
    
    private async Task OnSubmit()
    {
        try
        {
            if (_isEditMode)
            {
                var existingOrder = await PurchaseOrderService.GetByIdAsync(Id.Value);
                if (existingOrder != null)
                {
                    // Map the input model to the entity
                    existingOrder.SupplierName = _model.SupplierName;
                    existingOrder.SupplierEmail = _model.SupplierEmail;
                    existingOrder.SupplierPhone = _model.SupplierPhone;
                    existingOrder.SupplierAddress = _model.SupplierAddress;
                    existingOrder.ExpectedDeliveryDate = _model.ExpectedDeliveryDate;
                    existingOrder.Notes = _model.Notes;
                    existingOrder.UpdatedAt = DateTime.UtcNow;
                    
                    await PurchaseOrderService.UpdateAsync(existingOrder);
                }
                NotificationService.Notify(NotificationSeverity.Success, "Success", "Purchase order updated successfully");
            }
            else
            {
                // Create new entity from input model
                var newOrder = new PurchaseOrder
                {
                    OrderNumber = GenerateOrderNumber(),
                    OrderDate = _model.OrderDate ?? DateTime.Today,
                    ExpectedDeliveryDate = _model.ExpectedDeliveryDate,
                    SupplierName = _model.SupplierName,
                    SupplierEmail = _model.SupplierEmail,
                    SupplierPhone = _model.SupplierPhone,
                    SupplierAddress = _model.SupplierAddress,
                    Notes = _model.Notes,
                    Status = "Pending",
                    CreatedAt = DateTime.UtcNow,
                    UpdatedAt = DateTime.UtcNow
                };
                
                await PurchaseOrderService.CreateAsync(newOrder);
                NotificationService.Notify(NotificationSeverity.Success, "Success", "Purchase order created successfully");
            }
            
            DialogService.Close(true);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", $"Failed to save purchase order: {ex.Message}");
        }
    }
    
    private void Cancel()
    {
        DialogService.Close(false);
    }
    
    private string GenerateOrderNumber()
    {
        return $"PO-{DateTime.Now:yyyyMMdd}-{DateTime.Now.Ticks % 10000:D4}";
    }
}
