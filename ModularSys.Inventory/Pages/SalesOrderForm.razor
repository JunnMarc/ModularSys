@using ModularSys.Data.Common.Entities.Inventory
@using ModularSys.Inventory.Interface
@using ModularSys.Inventory.Models
@using Radzen.Blazor
@using Radzen

@inject IProductService ProductService
@inject ISalesOrderService SalesOrderService
@inject DialogService DialogService
@inject NotificationService NotificationService

<div style="width: 100%; max-width: 100%; max-height: 90vh; display: flex; flex-direction: column; background: transparent;">
    <!-- Header -->
    <div style="padding: 24px; border-bottom: 1px solid #e5e7eb; flex-shrink: 0; background: transparent;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 56px; height: 56px; border-radius: 12px; background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); display: flex; align-items: center; justify-content: center;">
                <RadzenIcon Icon="receipt_long" Style="color: white; font-size: 1.75rem;" />
            </div>
            <div>
                <h2 style="margin: 0; font-size: 1.5rem; font-weight: 600; color: #1f2937;">
                    @(_isEditMode ? "Edit Sales Order" : "New Sales Order")
                </h2>
                <p style="margin: 4px 0 0 0; color: #9ca3af; font-size: 0.875rem;">
                    @(_isEditMode ? "Modify existing sales order details" : "Create a new sales order for customer")
                </p>
            </div>
        </div>
    </div>

    <!-- Form Content -->
    <div style="padding: 24px; flex: 1; background: transparent; overflow-y: auto; overflow-x: hidden;">
        <RadzenTemplateForm TItem="SalesOrderMultiInputModel" Data="@_model" Submit="@OnSubmit">
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" 
                            Shade="Shade.Lighter"
                            Variant="Variant.Flat"
                            AllowClose="true" 
                            Close="@(() => _errorMessage = null)"
                            Style="margin-bottom: 20px; border-radius: 8px;">
                    <RadzenIcon Icon="error_outline" Style="margin-right: 8px;" />
                    @_errorMessage
                </RadzenAlert>
            }

        <RadzenStack Gap="1.5rem">
            <!-- Order Information -->
            <div>
                <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
                    <RadzenIcon Icon="info" Style="color: #8b5cf6;" />
                    <h3 style="margin: 0; font-size: 1rem; font-weight: 600; color: #374151;">Order Information</h3>
                </div>
                
                <RadzenStack Gap="1rem">
                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Customer Name" Variant="Variant.Outlined" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="_model.CustomerName"
                                             Placeholder="Enter customer name"
                                             Style="width: 100%; height: 40px;" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Customer Email" Variant="Variant.Outlined" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="_model.CustomerEmail"
                                             Placeholder="customer@example.com"
                                             Style="width: 100%; height: 40px;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>
                    
                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Order Date" Variant="Variant.Outlined" Style="width: 100%;">
                                <RadzenDatePicker TValue="DateTime?" 
                                                 @bind-Value="_model.OrderDate"
                                                 DateFormat="MM/dd/yyyy"
                                                 ShowTime="false"
                                                 ReadOnly="true"
                                                 Disabled="true"
                                                 Style="width: 100%; height: 40px; background: #f3f4f6; cursor: not-allowed;" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Expected Delivery" Variant="Variant.Outlined" Style="width: 100%;">
                                <RadzenDatePicker TValue="DateTime?" 
                                                 @bind-Value="_model.DeliveryDate"
                                                 DateFormat="MM/dd/yyyy"
                                                 ShowTime="false"
                                                 Min="@_model.OrderDate"
                                                 Style="width: 100%; height: 40px;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>
                    
                    <RadzenFormField Text="Order Notes" Variant="Variant.Outlined" Style="width: 100%;">
                        <RadzenTextArea @bind-Value="_model.Notes" 
                                       Placeholder="Additional notes or special instructions"
                                       Rows="3" 
                                       Style="width: 100%;" />
                    </RadzenFormField>
                </RadzenStack>
            </div>

            <!-- Order Items Section -->
            <div>
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <RadzenIcon Icon="shopping_cart" Style="color: #8b5cf6;" />
                        <h3 style="margin: 0; font-size: 1rem; font-weight: 600; color: #374151;">Order Items (@_model.Lines.Count)</h3>
                    </div>
                    <RadzenButton Text="ADD ITEM"
                                Icon="add"
                                ButtonStyle="ButtonStyle.Primary"
                                Size="ButtonSize.Small"
                                Click="AddLine"
                                Style="background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); border: none;" />
                </div>
                @if (_model.Lines.Any())
                {
                    <RadzenStack Gap="1rem">
                        @foreach (var (line, index) in _model.Lines.Select((line, i) => (line, i)))
                        {
                            <div style="background: white; border: 1px solid #e5e7eb; border-radius: 8px; padding: 16px;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                                    <span style="color: #8b5cf6; font-weight: 600;">Item #@(index + 1)</span>
                                    <RadzenButton Icon="delete"
                                                ButtonStyle="ButtonStyle.Danger"
                                                Size="ButtonSize.Small"
                                                Variant="Variant.Text"
                                                Click="@(() => RemoveLine(line))" />
                                </div>

                                        <RadzenStack Gap="1rem">
                                            <RadzenFormField Text="Product" Variant="Variant.Outlined" Style="width: 100%;">
                                                <RadzenDropDown TValue="int"
                                                              @bind-Value="line.ProductId"
                                                              Placeholder="Select a product..."
                                                              Style="width: 100%; height: 40px;"
                                                              Data="@_products"
                                                              TextProperty="Name"
                                                              ValueProperty="ProductId"
                                                              Change="@(args => OnProductChanged(line, Convert.ToInt32(args)))"
                                                              AllowClear="false" />
                                            </RadzenFormField>
                                            
                                            <RadzenRow Gap="1rem">
                                                <RadzenColumn Size="4">
                                                    <RadzenFormField Text="Quantity" Variant="Variant.Outlined" Style="width: 100%;">
                                                        <RadzenNumeric TValue="int" 
                                                                     @bind-Value="line.Quantity"
                                                                     Min="1"
                                                                     ShowUpDown="false"
                                                                     Style="width: 100%; height: 40px;" />
                                                    </RadzenFormField>
                                                </RadzenColumn>
                                                <RadzenColumn Size="4">
                                                    <RadzenFormField Text="Unit Price" Variant="Variant.Outlined" Style="width: 100%;">
                                                        <RadzenNumeric TValue="decimal" 
                                                                     @bind-Value="line.UnitPrice"
                                                                     ReadOnly="true"
                                                                     ShowUpDown="false"
                                                                     Style="width: 100%; height: 40px;"
                                                                     Format="C" />
                                                    </RadzenFormField>
                                                </RadzenColumn>
                                                <RadzenColumn Size="4">
                                                    <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; padding-top: 8px;">
                                                        <span style="font-size: 0.75rem; color: #6b7280; margin-bottom: 4px;">Line Total</span>
                                                        <span style="font-size: 1.25rem; font-weight: 600; color: #8b5cf6;">₱@line.LineTotal.ToString("#,##0.00")</span>
                                                    </div>
                                                </RadzenColumn>
                                            </RadzenRow>
                                        </RadzenStack>
                                    </div>
                        }
                    </RadzenStack>
                }
                else
                {
                    <div style="text-align: center; padding: 40px; background: #f9fafb; border: 2px dashed #e5e7eb; border-radius: 8px;">
                        <RadzenIcon Icon="shopping_cart" Style="font-size: 48px; color: #d1d5db; margin-bottom: 12px;" />
                        <p style="color: #6b7280; margin: 8px 0;">No items added yet</p>
                        <p style="color: #9ca3af; font-size: 0.875rem; margin-bottom: 16px;">Add items to create the sales order</p>
                        <RadzenButton Text="Add First Item"
                                    Icon="add"
                                    ButtonStyle="ButtonStyle.Primary"
                                    Click="AddLine"
                                    Style="background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); border: none;" />
                    </div>
                }
            </div>

            <!-- Order Summary -->
            @if (_model.Lines.Any())
            {
                <div style="background: white; border: 1px solid #e5e7eb; border-radius: 8px; padding: 20px;">
                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
                        <RadzenIcon Icon="receipt" Style="color: #10b981;" />
                        <h3 style="margin: 0; font-size: 1rem; font-weight: 600; color: #374151;">Order Summary</h3>
                    </div>
                    <RadzenStack Gap="0.75rem">
                        <div style="display: flex; justify-content: space-between;">
                            <span style="color: #6b7280;">Subtotal:</span>
                            <span style="font-weight: 600;">₱@_model.SubTotal.ToString("#,##0.00")</span>
                        </div>
                        <div style="display: flex; justify-content: space-between;">
                            <span style="color: #6b7280;">Tax (12%):</span>
                            <span style="font-weight: 600;">₱@_model.TaxAmount.ToString("#,##0.00")</span>
                        </div>
                        <div style="height: 1px; background: #e5e7eb; margin: 8px 0;"></div>
                        <div style="display: flex; justify-content: space-between;">
                            <span style="font-size: 1.125rem; font-weight: 600; color: #10b981;">Grand Total:</span>
                            <span style="font-size: 1.125rem; font-weight: 700; color: #10b981;">₱@_model.GrandTotal.ToString("#,##0.00")</span>
                        </div>
                        <div style="text-align: center; padding-top: 8px;">
                            <span style="color: #6b7280; font-size: 0.875rem;">Total Items: </span>
                            <span style="color: #8b5cf6; font-weight: 600; font-size: 1.25rem;">@_model.Lines.Sum(l => l.Quantity)</span>
                        </div>
                    </RadzenStack>
                </div>
            }
        </RadzenStack>
        </RadzenTemplateForm>
    </div>

    <!-- Footer Actions -->
    <div style="padding: 16px 24px; border-top: 1px solid #e5e7eb; background: transparent; display: flex; justify-content: flex-end; gap: 12px; flex-shrink: 0;">
        <RadzenButton Text="Cancel"
                    Icon="close"
                    ButtonStyle="ButtonStyle.Light"
                    Click="@Cancel"
                    Style="min-width: 100px;" />
        <RadzenButton Text="@(_isEditMode ? "Update" : "Create Order")"
                    Icon="@(_saving ? null : (_isEditMode ? "save" : "add"))"
                    Click="@OnSubmit"
                    ButtonStyle="ButtonStyle.Primary"
                    Disabled="@(!_model.Lines.Any() || _saving)"
                    IsBusy="_saving"
                    Style="min-width: 120px; background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); border: none;" />
    </div>
</div>

@code {
    private SalesOrderMultiInputModel _model = new();
    private List<Product> _products = new();
    private string _errorMessage;
    private bool _saving = false;
    private bool _isEditMode => Id.HasValue;

    [Parameter] public int? Id { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _products = (await ProductService.GetAllAsync()).ToList();

            if (_isEditMode)
            {
                await LoadExistingOrder();
            }
            else
            {
                _model.OrderDate = DateTime.Today;
                if (!ReadOnly)
                {
                    AddLine();
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading data: {ex.Message}";
        }
    }

    private async Task LoadExistingOrder()
    {
        try
        {
            var order = await SalesOrderService.GetByIdAsync(Id.Value);
            if (order != null)
            {
                _model = new SalesOrderMultiInputModel
                {
                    CustomerName = order.CustomerName,
                    CustomerEmail = order.CustomerEmail,
                    OrderDate = order.OrderDate,
                    DeliveryDate = order.DeliveryDate,
                    Notes = order.Notes,
                    Lines = order.Lines.Select(l => new SalesOrderLineInputModel
                    {
                        ProductId = l.ProductId,
                        Quantity = l.Quantity,
                        UnitPrice = l.UnitPrice
                    }).ToList()
                };
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading order: {ex.Message}";
        }
    }

    private void AddLine()
    {
        _model.Lines.Add(new SalesOrderLineInputModel
        {
            ProductId = 0,
            Quantity = 1,
            UnitPrice = 0
        });
    }

    private void RemoveLine(SalesOrderLineInputModel line)
    {
        _model.Lines.Remove(line);
    }

    private void OnProductChanged(SalesOrderLineInputModel line, int productId)
    {
        line.ProductId = productId;
        var selected = _products.FirstOrDefault(p => p.ProductId == productId);
        if (selected != null)
        {
            line.UnitPrice = selected.UnitPrice;
        }
    }

    private async Task OnSubmit()
    {
        if (_saving) return;

        _errorMessage = null;
        _saving = true;

        try
        {
            // Validate that all lines have products selected
            if (_model.Lines.Any(l => l.ProductId == 0))
            {
                _errorMessage = "Please select a product for all order lines.";
                return;
            }

            if (_isEditMode)
            {
                var existingOrder = await SalesOrderService.GetByIdAsync(Id.Value);
                if (existingOrder != null)
                {
                    existingOrder.CustomerName = _model.CustomerName;
                    existingOrder.CustomerEmail = _model.CustomerEmail;
                    existingOrder.DeliveryDate = _model.DeliveryDate;
                    existingOrder.Notes = _model.Notes;
                    existingOrder.SubTotal = _model.SubTotal;
                    existingOrder.DiscountAmount = _model.DiscountAmount;
                    existingOrder.ShippingCost = _model.ShippingCost;
                    existingOrder.PaymentMethod = _model.PaymentMethod;

                    // Update lines
                    existingOrder.Lines.Clear();
                    foreach (var line in _model.Lines)
                    {
                        existingOrder.Lines.Add(new SalesOrderLine
                        {
                            ProductId = line.ProductId,
                            Quantity = line.Quantity,
                            UnitPrice = line.UnitPrice
                        });
                    }

                    await SalesOrderService.UpdateAsync(existingOrder);
                    NotificationService.Notify(NotificationSeverity.Success, "Success", "Sales order updated successfully");
                }
            }
            else
            {
                var order = new SalesOrder
                {
                    OrderDate = _model.OrderDate ?? DateTime.Today,
                    CustomerName = _model.CustomerName,
                    CustomerEmail = _model.CustomerEmail,
                    DeliveryDate = _model.DeliveryDate,
                    Notes = _model.Notes,
                    Status = "Pending",
                    SubTotal = _model.SubTotal,
                    DiscountAmount = _model.DiscountAmount,
                    ShippingCost = _model.ShippingCost,
                    PaymentMethod = _model.PaymentMethod,
                    Lines = _model.Lines.Select(l => new SalesOrderLine
                    {
                        ProductId = l.ProductId,
                        Quantity = l.Quantity,
                        UnitPrice = l.UnitPrice
                    }).ToList()
                };

                await SalesOrderService.CreateAsync(order);
                NotificationService.Notify(NotificationSeverity.Success, "Success", "Sales order created successfully");
            }

            DialogService.Close(true);
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel()
    {
        DialogService.Close(false);
    }
}
