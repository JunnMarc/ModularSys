@using ModularSys.Data.Common.Entities.Inventory
@using ModularSys.Inventory.Interface
@using ModularSys.Inventory.Models
@using Radzen.Blazor
@using Radzen

@inject IProductService ProductService
@inject ISalesOrderService SalesOrderService
@inject DialogService DialogService
@inject NotificationService NotificationService

<RadzenTemplateForm TItem="SalesOrderMultiInputModel" Data="@_model" Submit="@OnSubmit">
    <RadzenStack Gap="1rem">
        <!-- Header -->
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Class="pb-2">
            <RadzenIcon Icon="receipt_long" Size="IconSize.Large" Style="color: var(--rz-primary-color);" />
            <RadzenStack Gap="0">
                <RadzenText TextStyle="TextStyle.H5" Text="@(_isEditMode ? "Edit Sales Order" : "New Sales Order")" />
                <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-secondary-text-color);">
                    @(_isEditMode ? "Modify existing sales order details" : "Create a new sales order for customer")
                </RadzenText>
            </RadzenStack>
        </RadzenStack>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="true" Close="@(() => _errorMessage = null)">
                @_errorMessage
            </RadzenAlert>
        }

        <RadzenStack Gap="1rem">
            <!-- Order Information -->
            <RadzenCard Elevation="1" Class="pa-4">
                <RadzenCardHeader>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenIcon Icon="info" Style="color: var(--rz-primary-color);" />
                        <RadzenText TextStyle="TextStyle.H6" Text="Order Information" />
                    </RadzenStack>
                </RadzenCardHeader>
                <RadzenCardContent>
                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenLabel Text="Customer Name" />
                            <RadzenTextBox @bind-Value="_model.CustomerName"
                                         Placeholder="Enter customer name"
                                         Style="width: 100%;"
                                         Required="true" />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenLabel Text="Customer Email" />
                            <RadzenTextBox @bind-Value="_model.CustomerEmail"
                                         Placeholder="customer@example.com"
                                         Style="width: 100%;" />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenLabel Text="Order Date" />
                            <RadzenDatePicker @bind-Value="_model.OrderDate"
                                            Style="width: 100%;"
                                            Required="true" />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenLabel Text="Expected Delivery" />
                            <RadzenDatePicker @bind-Value="_model.DeliveryDate"
                                            Style="width: 100%;"
                                            AllowClear="true" />
                        </RadzenColumn>
                        <RadzenColumn Size="12">
                            <RadzenLabel Text="Order Notes" />
                            <RadzenTextArea @bind-Value="_model.Notes"
                                          Placeholder="Additional order notes or special instructions"
                                          Rows="3"
                                          Style="width: 100%;" />
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenCardContent>
            </RadzenCard>

            <!-- Order Lines -->
            <RadzenCard Elevation="1" Class="pa-4">
                <RadzenCardHeader>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenIcon Icon="shopping_cart" Style="color: var(--rz-primary-color);" />
                            <RadzenText TextStyle="TextStyle.H6" Text="@($"Order Items ({_model.Lines.Count})")" />
                        </RadzenStack>
                        <RadzenButton Text="Add Item"
                                    Icon="add"
                                    ButtonStyle="ButtonStyle.Primary"
                                    Size="ButtonSize.Small"
                                    Click="AddLine" />
                    </RadzenStack>
                </RadzenCardHeader>
                <RadzenCardContent>
                    @if (_model.Lines.Any())
                    {
                        <RadzenStack Gap="1rem">
                            @foreach (var (line, index) in _model.Lines.Select((line, i) => (line, i)))
                            {
                                <RadzenCard Elevation="0" Style="border: 1px solid var(--rz-base-300); border-radius: 8px;" Class="pa-3">
                                    <RadzenStack Gap="1rem">
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                                            <RadzenText TextStyle="TextStyle.Subtitle2" Style="color: var(--rz-primary-color);">Item #@(index + 1)</RadzenText>
                                            <RadzenButton Icon="delete"
                                                        ButtonStyle="ButtonStyle.Danger"
                                                        Size="ButtonSize.Small"
                                                        Variant="Variant.Text"
                                                        Click="@(() => RemoveLine(line))" />
                                        </RadzenStack>

                                        <RadzenRow Gap="1rem">
                                            <RadzenColumn Size="12" SizeMD="5">
                                                <RadzenLabel Text="Product" />
                                                <RadzenDropDown @bind-Value="line.ProductId"
                                                              Placeholder="Select a product..."
                                                              Style="width: 100%;"
                                                              Required="true"
                                                              Data="@_products"
                                                              TextProperty="Name"
                                                              ValueProperty="ProductId"
                                                              Change="@(args => OnProductChanged(line, Convert.ToInt32(args)))"
                                                              AllowClear="false">
                                                    <Template Context="product">
                                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                                                            <RadzenStack Gap="0">
                                                                <RadzenText Text="@product.Name" />
                                                                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-secondary-text-color);">
                                                                    SKU: @product.SKU | Stock: @product.QuantityOnHand
                                                                </RadzenText>
                                                            </RadzenStack>
                                                            <RadzenText TextStyle="TextStyle.Body2" Text="@product.UnitPrice.ToString("C")" />
                                                        </RadzenStack>
                                                    </Template>
                                                </RadzenDropDown>
                                            </RadzenColumn>
                                            <RadzenColumn Size="6" SizeMD="2">
                                                <RadzenLabel Text="Quantity" />
                                                <RadzenNumeric @bind-Value="line.Quantity"
                                                             Min="1"
                                                             Style="width: 100%;"
                                                             Required="true" />
                                            </RadzenColumn>
                                            <RadzenColumn Size="6" SizeMD="2">
                                                <RadzenLabel Text="Unit Price" />
                                                <RadzenNumeric @bind-Value="line.UnitPrice"
                                                             ReadOnly="true"
                                                             Style="width: 100%;"
                                                             Format="C" />
                                            </RadzenColumn>
                                            <RadzenColumn Size="12" SizeMD="3">
                                                <RadzenStack AlignItems="AlignItems.Center" Gap="0.5rem">
                                                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-secondary-text-color);">Line Total</RadzenText>
                                                    <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-success-color);">
                                                        ₱@line.LineTotal.ToString("#,##0.00")
                                                    </RadzenText>
                                                </RadzenStack>
                                            </RadzenColumn>
                                        </RadzenRow>
                                    </RadzenStack>
                                </RadzenCard>
                            }
                        </RadzenStack>
                    }
                    else
                    {
                        <RadzenStack AlignItems="AlignItems.Center" Class="pa-8">
                            <RadzenIcon Icon="shopping_cart_checkout" Size="IconSize.Large" Style="color: var(--rz-secondary-text-color);" />
                            <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-secondary-text-color);">No items added</RadzenText>
                            <RadzenText Style="color: var(--rz-secondary-text-color);">Add items to create the sales order</RadzenText>
                            <RadzenButton Text="Add First Item"
                                        Icon="add"
                                        ButtonStyle="ButtonStyle.Primary"
                                        Click="AddLine"
                                        Class="mt-2" />
                        </RadzenStack>
                    }
                </RadzenCardContent>
            </RadzenCard>

            <!-- Order Summary -->
            @if (_model.Lines.Any())
            {
                <RadzenCard Elevation="2" Class="pa-4" Style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
                    <RadzenCardHeader>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenIcon Icon="receipt" Style="color: var(--rz-success-color);" />
                            <RadzenText TextStyle="TextStyle.H6" Text="Order Summary" />
                        </RadzenStack>
                    </RadzenCardHeader>
                    <RadzenCardContent>
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenStack Gap="1rem">
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                                        <RadzenText TextStyle="TextStyle.Body1" Text="Subtotal:" />
                                        <RadzenText TextStyle="TextStyle.Body1" Text="@_model.SubTotal.ToString("₱#,##0.00")" />
                                    </RadzenStack>
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                                        <RadzenText TextStyle="TextStyle.Body1" Text="Tax (12%):" />
                                        <RadzenText TextStyle="TextStyle.Body1" Text="@_model.TaxAmount.ToString("₱#,##0.00")" />
                                    </RadzenStack>
                                    <RadzenDivider />
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                                        <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-success-color);">Grand Total:</RadzenText>
                                        <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-success-color);">@_model.GrandTotal.ToString("₱#,##0.00")</RadzenText>
                                    </RadzenStack>
                                </RadzenStack>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack AlignItems="AlignItems.Center" Gap="0.5rem">
                                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-secondary-text-color);">Total Items</RadzenText>
                                    <RadzenText TextStyle="TextStyle.H4" Style="color: var(--rz-primary-color);">@_model.Lines.Sum(l => l.Quantity)</RadzenText>
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenCardContent>
                </RadzenCard>
            }
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" JustifyContent="JustifyContent.End" Class="pt-4">
            <RadzenButton Text="Cancel"
                        ButtonStyle="ButtonStyle.Light"
                        Click="@Cancel"
                        Icon="cancel" />
            <RadzenButton Text="@(_isEditMode ? "Update Order" : "Create Order")"
                        ButtonType="ButtonType.Submit"
                        ButtonStyle="ButtonStyle.Primary"
                        Icon="@(_saving ? null : "save")"
                        Disabled="@(!_model.Lines.Any() || _saving)"
                        Loading="_saving" />
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    private SalesOrderMultiInputModel _model = new();
    private List<Product> _products = new();
    private string _errorMessage;
    private bool _saving = false;
    private bool _isEditMode => Id.HasValue;

    [Parameter] public int? Id { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _products = (await ProductService.GetAllAsync()).ToList();

            if (_isEditMode)
            {
                await LoadExistingOrder();
            }
            else
            {
                _model.OrderDate = DateTime.Today;
                if (!ReadOnly)
                {
                    AddLine();
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading data: {ex.Message}";
        }
    }

    private async Task LoadExistingOrder()
    {
        try
        {
            var order = await SalesOrderService.GetByIdAsync(Id.Value);
            if (order != null)
            {
                _model = new SalesOrderMultiInputModel
                {
                    CustomerName = order.CustomerName,
                    CustomerEmail = order.CustomerEmail,
                    OrderDate = order.OrderDate,
                    DeliveryDate = order.DeliveryDate,
                    Notes = order.Notes,
                    Lines = order.Lines.Select(l => new SalesOrderLineInputModel
                    {
                        ProductId = l.ProductId,
                        Quantity = l.Quantity,
                        UnitPrice = l.UnitPrice
                    }).ToList()
                };
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading order: {ex.Message}";
        }
    }

    private void AddLine()
    {
        _model.Lines.Add(new SalesOrderLineInputModel
        {
            ProductId = 0,
            Quantity = 1,
            UnitPrice = 0
        });
    }

    private void RemoveLine(SalesOrderLineInputModel line)
    {
        _model.Lines.Remove(line);
    }

    private void OnProductChanged(SalesOrderLineInputModel line, int productId)
    {
        line.ProductId = productId;
        var selected = _products.FirstOrDefault(p => p.ProductId == productId);
        if (selected != null)
        {
            line.UnitPrice = selected.UnitPrice;
        }
    }

    private async Task OnSubmit()
    {
        if (_saving) return;

        _errorMessage = null;
        _saving = true;

        try
        {
            // Validate that all lines have products selected
            if (_model.Lines.Any(l => l.ProductId == 0))
            {
                _errorMessage = "Please select a product for all order lines.";
                return;
            }

            if (_isEditMode)
            {
                var existingOrder = await SalesOrderService.GetByIdAsync(Id.Value);
                if (existingOrder != null)
                {
                    existingOrder.CustomerName = _model.CustomerName;
                    existingOrder.CustomerEmail = _model.CustomerEmail;
                    existingOrder.DeliveryDate = _model.DeliveryDate;
                    existingOrder.Notes = _model.Notes;
                    existingOrder.SubTotal = _model.SubTotal;
                    existingOrder.DiscountAmount = _model.DiscountAmount;
                    existingOrder.ShippingCost = _model.ShippingCost;
                    existingOrder.PaymentMethod = _model.PaymentMethod;

                    // Update lines
                    existingOrder.Lines.Clear();
                    foreach (var line in _model.Lines)
                    {
                        existingOrder.Lines.Add(new SalesOrderLine
                        {
                            ProductId = line.ProductId,
                            Quantity = line.Quantity,
                            UnitPrice = line.UnitPrice
                        });
                    }

                    await SalesOrderService.UpdateAsync(existingOrder);
                    NotificationService.Notify(NotificationSeverity.Success, "Success", "Sales order updated successfully");
                }
            }
            else
            {
                var order = new SalesOrder
                {
                    OrderDate = _model.OrderDate ?? DateTime.Today,
                    CustomerName = _model.CustomerName,
                    CustomerEmail = _model.CustomerEmail,
                    DeliveryDate = _model.DeliveryDate,
                    Notes = _model.Notes,
                    Status = "Pending",
                    SubTotal = _model.SubTotal,
                    DiscountAmount = _model.DiscountAmount,
                    ShippingCost = _model.ShippingCost,
                    PaymentMethod = _model.PaymentMethod,
                    Lines = _model.Lines.Select(l => new SalesOrderLine
                    {
                        ProductId = l.ProductId,
                        Quantity = l.Quantity,
                        UnitPrice = l.UnitPrice
                    }).ToList()
                };

                await SalesOrderService.CreateAsync(order);
                NotificationService.Notify(NotificationSeverity.Success, "Success", "Sales order created successfully");
            }

            DialogService.Close(true);
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel()
    {
        DialogService.Close(false);
    }
}
