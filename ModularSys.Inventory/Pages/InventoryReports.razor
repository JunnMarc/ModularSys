@page "/inventory/reports"
@using ModularSys.Inventory.Interface
@using ModularSys.Inventory.Models
@using ModularSys.Inventory.Components
@using Microsoft.JSInterop
@using System.IO
@using Radzen.Blazor
@inject IBusinessAnalyticsService BusinessAnalyticsService
@inject IInventoryDashboardService InventoryDashboardService
@inject IAnalyticalReportService AnalyticalReportService
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject IJSRuntime JSRuntime

<RadzenStack Style="padding: 16px;">
    <RadzenStack Spacing="4">
        <!-- Enhanced ERP-Style Header -->
        <RadzenCard Elevation="3">
            <RadzenCardContent Style="padding: 24px;">
                <RadzenStack Row="true" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                    <RadzenStack Spacing="2">
                        <RadzenText Style="font-weight: 400; font-size: 2rem; color: #1976D2;">
                            <RadzenIcon Icon="analytics" Style="margin-right: 12px; font-size: 2rem;" />
                            Analytical Accounting Reports
                        </RadzenText>
                        <RadzenText Style="font-size: 1.125rem; color: #1976D2; font-weight: 400;">
                            Comprehensive financial analysis with GAAP-compliant inventory accounting reports
                        </RadzenText>
                    </RadzenStack>
                    <RadzenStack Spacing="2" AlignItems="AlignItems.End">
                        <RadzenButton Variant="Variant.Outlined" 
                                      Icon="refresh"
                                      Click="RefreshReports"
                                      Loading="_loading"
                                      Style="action-button">
                            Refresh Data
                        </RadzenButton>
                    </RadzenStack>
                </RadzenStack>
            </RadzenCardContent>
        </RadzenCard>

        @if (_loading)
        {
            <RadzenStack AlignItems="AlignItems.Center" Style="padding: 32px;">
                <RadzenProgressBarCircular Indeterminate="true" Size="ProgressBarCircularSize.Large" />
                <RadzenText>Loading analytical reports...</RadzenText>
            </RadzenStack>
        }
        else if (_errorMessage != null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Dense="true" Style="margin-bottom: 16px;">
                @_errorMessage
            </RadzenAlert>
        }
        else
        {
            <!-- Report Type Selection Section -->
            <RadzenCard Elevation="2" Style="margin-bottom: 16px;">
                <RadzenCardContent Style="padding: 16px;">
                    <RadzenStack Row="true" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                        <RadzenStack Spacing="2">
                        </RadzenStack>
                        <RadzenStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <RadzenDatePicker @bind-Value="_startDate"
                                              Placeholder="Start Date"
                                              Style="min-width: 140px;" />
                            <RadzenDatePicker @bind-Value="_endDate"
                                              Placeholder="End Date"
                                              Style="min-width: 140px;" />
                            <RadzenDropDown T="AnalyticalReportType" @bind-Value="_selectedReportType"
                                            Placeholder="Report Type"
                                            Style="min-width: 250px;">
                                <RadzenDropDownItem TValue="AnalyticalReportType" Value="AnalyticalReportType.InventoryValuation">Inventory Valuation Report</RadzenDropDownItem>
                                <RadzenDropDownItem TValue="AnalyticalReportType" Value="AnalyticalReportType.CostOfGoodsSold">Cost of Goods Sold (COGS)</RadzenDropDownItem>
                                <RadzenDropDownItem TValue="AnalyticalReportType" Value="AnalyticalReportType.InventoryTurnover">Inventory Turnover Analysis</RadzenDropDownItem>
                                <RadzenDropDownItem TValue="AnalyticalReportType" Value="AnalyticalReportType.ProfitAndLossStatement">Profit & Loss Statement</RadzenDropDownItem>
                            </RadzenDropDown>
                            <RadzenButton Variant="Variant.Filled" 
                                          Style="background-color: #1976D2; color: white;"
                                          Icon="analytics"
                                          Click="GenerateAnalyticalReport"
                                          Disabled="_loading || _generatingReport">
                                Generate Report
                            </RadzenButton>
                            <RadzenButton Variant="Variant.Outlined" 
                                          Style="border-color: #2196F3; color: #2196F3;"
                                          Icon="preview"
                                          Click="PreviewReport"
                                          Disabled="_loading || _generatingReport || _currentReportData == null">
                                Preview Report
                            </RadzenButton>
                            <RadzenButton Variant="Variant.Filled" 
                                          Style="background-color: #9C27B0; color: white;"
                                          Icon="picture_as_pdf"
                                          Click="ExportToCrystalReports"
                                          Disabled="_loading || _generatingReport || _currentReportData == null">
                                Export PDF
                            </RadzenButton>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenCardContent>
            </RadzenCard>

            <!-- Report Display Section -->
            @if (_generatingReport)
            {
                <RadzenCard Elevation="2" Style="margin-bottom: 16px;">
                    <RadzenCardContent Style="padding: 24px;">
                        <RadzenStack AlignItems="AlignItems.Center" Spacing="3">
                            <RadzenProgressBarCircular Indeterminate="true" Size="ProgressBarCircularSize.Large" Style="color: #1976D2;" />
                            <RadzenText Style="font-size: 1.25rem;">Generating @_selectedReportType Report...</RadzenText>
                            <RadzenText Style="color: #666; font-size: 0.875rem;">
                                Processing data with GAAP-compliant calculations
                            </RadzenText>
                        </RadzenStack>
                    </RadzenCardContent>
                </RadzenCard>
            }
            else if (_currentReportData != null)
            {
                <!-- Dynamic Report Display -->
                @if (_selectedReportType == AnalyticalReportType.InventoryValuation && _inventoryValuationReport != null)
                {
                    <RadzenCard Elevation="2" Style="margin-bottom: 16px;">
                        <RadzenCardHeader>
                            <RadzenText Style="font-weight: 600; font-size: 1.25rem; color: #1976D2;">
                                <RadzenIcon Icon="inventory" Style="margin-right: 8px;" />
                                Inventory Valuation Report
                            </RadzenText>
                            <RadzenText Style="color: #666; font-size: 0.875rem;">
                                As of @_inventoryValuationReport.ReportDate.ToString("MMMM dd, yyyy") • Method: @_inventoryValuationReport.ValuationMethod
                            </RadzenText>
                        </RadzenCardHeader>
                        <RadzenCardContent>
                            <!-- Summary Cards -->
                            <RadzenRow Style="margin-bottom: 16px;">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenCard Style="background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%); color: white;">
                                        <RadzenCardContent>
                                            <RadzenStack AlignItems="AlignItems.Center" Spacing="2">
                                                <RadzenIcon Icon="account_balance" Size="ButtonSize.Large" />
                                                <RadzenText Style="font-size: 2rem;">@_inventoryValuationReport.TotalInventoryValue.ToString("C0")</RadzenText>
                                                <RadzenText Style="font-size: 0.875rem;">Total Inventory Value</RadzenText>
                                            </RadzenStack>
                                        </RadzenCardContent>
                                    </RadzenCard>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenCard Style="background: linear-gradient(135deg, #2196F3 0%, #1976D2 100%); color: white;">
                                        <RadzenCardContent>
                                            <RadzenStack AlignItems="AlignItems.Center" Spacing="2">
                                                <RadzenIcon Icon="category" Size="ButtonSize.Large" />
                                                <RadzenText Style="font-size: 2rem;">@_inventoryValuationReport.CategoryBreakdown.Count</RadzenText>
                                                <RadzenText Style="font-size: 0.875rem;">Categories</RadzenText>
                                            </RadzenStack>
                                        </RadzenCardContent>
                                    </RadzenCard>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenCard Style="background: linear-gradient(135deg, #FF9800 0%, #F57C00 100%); color: white;">
                                        <RadzenCardContent>
                                            <RadzenStack AlignItems="AlignItems.Center" Spacing="2">
                                                <RadzenIcon Icon="inventory_2" Size="ButtonSize.Large" />
                                                <RadzenText Style="font-size: 2rem;">@_inventoryValuationReport.Items.Count</RadzenText>
                                                <RadzenText Style="font-size: 0.875rem;">SKUs</RadzenText>
                                            </RadzenStack>
                                        </RadzenCardContent>
                                    </RadzenCard>
                                </RadzenColumn>
                            </RadzenRow>

                            <!-- Category Breakdown Table -->
                            <RadzenText Style="font-size: 1.125rem; margin-bottom: 12px;">Category Breakdown</RadzenText>
                            <RadzenDataGrid Data="_inventoryValuationReport.CategoryBreakdown" Dense="true" AllowSorting="true" AllowFiltering="true" Style="margin-bottom: 16px;">
                                <Columns>
                                    <RadzenDataGridColumn TItem="CategoryValuation" Property="CategoryName" Title="Category" />
                                    <RadzenDataGridColumn TItem="CategoryValuation" Property="ProductCount" Title="Products" TextAlign="TextAlign.Right" />
                                    <RadzenDataGridColumn TItem="CategoryValuation" Property="TotalQuantity" Title="Total Quantity" TextAlign="TextAlign.Right" FormatString="N0" />
                                    <RadzenDataGridColumn TItem="CategoryValuation" Property="TotalValue" Title="Total Value" TextAlign="TextAlign.Right" FormatString="C" />
                                    <RadzenDataGridColumn TItem="CategoryValuation" Property="PercentageOfTotal" Title="% of Total" TextAlign="TextAlign.Right" FormatString="F1%" />
                                    <RadzenDataGridColumn TItem="CategoryValuation" Property="AverageCost" Title="Avg Cost" TextAlign="TextAlign.Right" FormatString="C" />
                                </Columns>
                            </RadzenDataGrid>
                        </RadzenCardContent>
                    </RadzenCard>
                }

                @if (_selectedReportType == AnalyticalReportType.CostOfGoodsSold && _cogsReport != null)
                {
                    <RadzenCard Elevation="2" Style="margin-bottom: 16px;">
                        <RadzenCardHeader>
                            <RadzenText Style="font-weight: 600; font-size: 1.25rem; color: #1976D2;">
                                <RadzenIcon Icon="trending_down" Style="margin-right: 8px;" />
                                Cost of Goods Sold (COGS) Report
                            </RadzenText>
                            <RadzenText Style="color: #666; font-size: 0.875rem;">
                                Period: @_cogsReport.StartDate.ToString("MMM dd, yyyy") - @_cogsReport.EndDate.ToString("MMM dd, yyyy")
                            </RadzenText>
                        </RadzenCardHeader>
                        <RadzenCardContent>
                            <!-- COGS Summary -->
                            <RadzenRow Style="margin-bottom: 16px;">
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenCard Style="background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%); color: white;">
                                        <RadzenCardContent>
                                            <RadzenStack AlignItems="AlignItems.Center" Spacing="2">
                                                <RadzenIcon Icon="attach_money" Size="ButtonSize.Large" />
                                                <RadzenText Style="font-size: 1.25rem;">@_cogsReport.NetSales.ToString("C0")</RadzenText>
                                                <RadzenText Style="font-size: 0.875rem;">Net Sales</RadzenText>
                                            </RadzenStack>
                                        </RadzenCardContent>
                                    </RadzenCard>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenCard Style="background: linear-gradient(135deg, #F44336 0%, #D32F2F 100%); color: white;">
                                        <RadzenCardContent>
                                            <RadzenStack AlignItems="AlignItems.Center" Spacing="2">
                                                <RadzenIcon Icon="trending_down" Size="ButtonSize.Large" />
                                                <RadzenText Style="font-size: 1.25rem;">@_cogsReport.CostOfGoodsSold.ToString("C0")</RadzenText>
                                                <RadzenText Style="font-size: 0.875rem;">COGS</RadzenText>
                                            </RadzenStack>
                                        </RadzenCardContent>
                                    </RadzenCard>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenCard Style="background: linear-gradient(135deg, #2196F3 0%, #1976D2 100%); color: white;">
                                        <RadzenCardContent>
                                            <RadzenStack AlignItems="AlignItems.Center" Spacing="2">
                                                <RadzenIcon Icon="trending_up" Size="ButtonSize.Large" />
                                                <RadzenText Style="font-size: 1.25rem;">@_cogsReport.GrossProfit.ToString("C0")</RadzenText>
                                                <RadzenText Style="font-size: 0.875rem;">Gross Profit</RadzenText>
                                            </RadzenStack>
                                        </RadzenCardContent>
                                    </RadzenCard>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenCard Style="background: linear-gradient(135deg, #9C27B0 0%, #7B1FA2 100%); color: white;">
                                        <RadzenCardContent>
                                            <RadzenStack AlignItems="AlignItems.Center" Spacing="2">
                                                <RadzenIcon Icon="percent" Size="ButtonSize.Large" />
                                                <RadzenText Style="font-size: 1.25rem;">@_cogsReport.GrossProfitMargin.ToString("F1")%</RadzenText>
                                                <RadzenText Style="font-size: 0.875rem;">Profit Margin</RadzenText>
                                            </RadzenStack>
                                        </RadzenCardContent>
                                    </RadzenCard>
                                </RadzenColumn>
                            </RadzenRow>

                            <!-- Category COGS Breakdown -->
                            <RadzenText Style="font-size: 1.125rem; margin-bottom: 12px;">COGS by Category</RadzenText>
                            <RadzenDataGrid Data="_cogsReport.CategoryBreakdown" Dense="true" AllowSorting="true" AllowFiltering="true">
                                <Columns>
                                    <RadzenDataGridColumn TItem="COGSByCategory" Property="CategoryName" Title="Category" />
                                    <RadzenDataGridColumn TItem="COGSByCategory" Property="COGS" Title="COGS" TextAlign="TextAlign.Right" FormatString="C" />
                                    <RadzenDataGridColumn TItem="COGSByCategory" Property="Revenue" Title="Revenue" TextAlign="TextAlign.Right" FormatString="C" />
                                    <RadzenDataGridColumn TItem="COGSByCategory" Property="GrossProfit" Title="Gross Profit" TextAlign="TextAlign.Right" FormatString="C" />
                                    <RadzenDataGridColumn TItem="COGSByCategory" Property="GrossProfitMargin" Title="Margin %" TextAlign="TextAlign.Right">
                                        <Template Context="data">
                                            <RadzenBadge Text="@($"{data.GrossProfitMargin:F1}%")"
                                                        BadgeStyle="@(data.GrossProfitMargin >= 30 ? BadgeStyle.Success : data.GrossProfitMargin >= 15 ? BadgeStyle.Warning : BadgeStyle.Danger)" />
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="COGSByCategory" Property="PercentageOfTotalCOGS" Title="% of Total COGS" TextAlign="TextAlign.Right" FormatString="F1%" />
                                </Columns>
                            </RadzenDataGrid>
                        </RadzenCardContent>
                    </RadzenCard>
                }

                @if (_selectedReportType == AnalyticalReportType.InventoryTurnover && _turnoverReport != null)
                {
                    <RadzenCard Elevation="2" Style="margin-bottom: 16px;">
                        <RadzenCardHeader>
                            <RadzenText Style="font-weight: 600; font-size: 1.25rem; color: #1976D2;">
                                <RadzenIcon Icon="autorenew" Style="margin-right: 8px;" />
                                Inventory Turnover Analysis
                            </RadzenText>
                            <RadzenText Style="color: #666; font-size: 0.875rem;">
                                As of @_turnoverReport.ReportDate.ToString("MMMM dd, yyyy")
                            </RadzenText>
                        </RadzenCardHeader>
                        <RadzenCardContent>
                            <!-- Turnover Summary -->
                            <RadzenRow Style="margin-bottom: 16px;">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenCard Style="background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%); color: white;">
                                        <RadzenCardContent>
                                            <RadzenStack AlignItems="AlignItems.Center" Spacing="2">
                                                <RadzenIcon Icon="autorenew" Size="ButtonSize.Large" />
                                                <RadzenText Style="font-size: 2rem;">@_turnoverReport.OverallTurnoverRatio.ToString("F1")</RadzenText>
                                                <RadzenText Style="font-size: 0.875rem;">Overall Turnover Ratio</RadzenText>
                                            </RadzenStack>
                                        </RadzenCardContent>
                                    </RadzenCard>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenCard Style="background: linear-gradient(135deg, #2196F3 0%, #1976D2 100%); color: white;">
                                        <RadzenCardContent>
                                            <RadzenStack AlignItems="AlignItems.Center" Spacing="2">
                                                <RadzenIcon Icon="schedule" Size="ButtonSize.Large" />
                                                <RadzenText Style="font-size: 2rem;">@_turnoverReport.DaysSalesInInventory.ToString("F0")</RadzenText>
                                                <RadzenText Style="font-size: 0.875rem;">Days Sales in Inventory</RadzenText>
                                            </RadzenStack>
                                        </RadzenCardContent>
                                    </RadzenCard>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenCard Style="background: linear-gradient(135deg, #FF9800 0%, #F57C00 100%); color: white;">
                                        <RadzenCardContent>
                                            <RadzenStack AlignItems="AlignItems.Center" Spacing="2">
                                                <RadzenIcon Icon="account_balance" Size="ButtonSize.Large" />
                                                <RadzenText Style="font-size: 2rem;">@_turnoverReport.AverageInventoryValue.ToString("C0")</RadzenText>
                                                <RadzenText Style="font-size: 0.875rem;">Avg Inventory Value</RadzenText>
                                            </RadzenStack>
                                        </RadzenCardContent>
                                    </RadzenCard>
                                </RadzenColumn>
                            </RadzenRow>

                            <!-- Top Products by Turnover -->
                            <RadzenText Style="font-size: 1.125rem; margin-bottom: 12px;">Top Products by Turnover Ratio</RadzenText>
                            <RadzenDataGrid Data="_turnoverReport.ProductTurnover.Take(15)" Dense="true" AllowSorting="true" AllowFiltering="true">
                                <Columns>
                                    <RadzenDataGridColumn TItem="ProductTurnover" Property="ProductName" Title="Product" />
                                    <RadzenDataGridColumn TItem="ProductTurnover" Property="Category" Title="Category" />
                                    <RadzenDataGridColumn TItem="ProductTurnover" Property="TurnoverRatio" Title="Turnover Ratio" TextAlign="TextAlign.Right" FormatString="F2" />
                                    <RadzenDataGridColumn TItem="ProductTurnover" Property="DaysSalesInInventory" Title="Days in Inventory" TextAlign="TextAlign.Right" FormatString="F0" />
                                    <RadzenDataGridColumn TItem="ProductTurnover" Property="TurnoverClassification" Title="Classification" TextAlign="TextAlign.Center">
                                        <Template Context="data">
                                            <RadzenBadge Text="@data.TurnoverClassification" 
                                                        BadgeStyle="@(data.TurnoverClassification == "Fast" ? BadgeStyle.Success : data.TurnoverClassification == "Medium" ? BadgeStyle.Warning : BadgeStyle.Danger)" />
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="ProductTurnover" Property="RecommendedAction" Title="Recommendation" />
                                </Columns>
                            </RadzenDataGrid>
                        </RadzenCardContent>
                    </RadzenCard>
                }

                @if (_selectedReportType == AnalyticalReportType.ProfitAndLossStatement && _profitAndLossReport != null)
                {
                    <RadzenCard Elevation="2" Style="margin-bottom: 16px;">
                        <RadzenCardHeader>
                            <RadzenText Style="font-weight: 600; font-size: 1.25rem; color: #1976D2;">
                                <RadzenIcon Icon="assessment" Style="margin-right: 8px;" />
                                Profit & Loss Statement
                            </RadzenText>
                            <RadzenText Style="color: #666; font-size: 0.875rem;">
                                Period: @_profitAndLossReport.PeriodStart.ToString("MMM dd") - @_profitAndLossReport.PeriodEnd.ToString("MMM dd, yyyy") • Status: @_profitAndLossReport.ProfitabilityStatus
                            </RadzenText>
                        </RadzenCardHeader>
                        <RadzenCardContent>
                            <!-- Profitability Status Alert -->
                            <RadzenAlert AlertStyle="@(_profitAndLossReport.NetIncome >= 0 ? AlertStyle.Success : AlertStyle.Danger)" 
                                         Dense="true" Style="margin-bottom: 16px;">
                                <RadzenText Style="font-weight: 600; font-size: 1.125rem;">
                                    🏢 Business Status: @_profitAndLossReport.ProfitabilityStatus (@_profitAndLossReport.HealthRating)
                                </RadzenText>
                                <RadzenText>💰 Net Income: ₱@_profitAndLossReport.NetIncome.ToString("N2") | 📊 Net Profit Margin: @_profitAndLossReport.NetProfitMargin.ToString("F1")%</RadzenText>
                            </RadzenAlert>
                            
                            <!-- Summary Cards -->
                            <RadzenRow Style="margin-bottom: 16px;">
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenCard Style="background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%); color: white;">
                                        <RadzenCardContent>
                                            <RadzenStack AlignItems="AlignItems.Center" Spacing="2">
                                                <RadzenIcon Icon="trending_up" Size="ButtonSize.Large" />
                                                <RadzenText Style="font-size: 1.25rem;">₱@_profitAndLossReport.Revenue.NetRevenue.ToString("N0")</RadzenText>
                                                <RadzenText Style="font-size: 0.875rem;">Net Revenue</RadzenText>
                                            </RadzenStack>
                                        </RadzenCardContent>
                                    </RadzenCard>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenCard Style="background: linear-gradient(135deg, #F44336 0%, #D32F2F 100%); color: white;">
                                        <RadzenCardContent>
                                            <RadzenStack AlignItems="AlignItems.Center" Spacing="2">
                                                <RadzenIcon Icon="trending_down" Size="ButtonSize.Large" />
                                                <RadzenText Style="font-size: 1.25rem;">₱@_profitAndLossReport.CostOfGoodsSold.TotalCOGS.ToString("N0")</RadzenText>
                                                <RadzenText Style="font-size: 0.875rem;">Total COGS</RadzenText>
                                            </RadzenStack>
                                        </RadzenCardContent>
                                    </RadzenCard>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenCard Style="background: linear-gradient(135deg, #2196F3 0%, #1976D2 100%); color: white;">
                                        <RadzenCardContent>
                                            <RadzenStack AlignItems="AlignItems.Center" Spacing="2">
                                                <RadzenIcon Icon="account_balance" Size="ButtonSize.Large" />
                                                <RadzenText Style="font-size: 1.25rem;">₱@_profitAndLossReport.GrossProfit.ToString("N0")</RadzenText>
                                                <RadzenText Style="font-size: 0.875rem;">Gross Profit</RadzenText>
                                            </RadzenStack>
                                        </RadzenCardContent>
                                    </RadzenCard>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenCard Style="@($"background: linear-gradient(135deg, {(_profitAndLossReport.NetIncome >= 0 ? "#4CAF50 0%, #45a049 100%" : "#F44336 0%, #D32F2F 100%")}); color: white;")">
                                        <RadzenCardContent>
                                            <RadzenStack AlignItems="AlignItems.Center" Spacing="2">
                                                <RadzenIcon Icon="@(_profitAndLossReport.NetIncome >= 0 ? "attach_money" : "money_off")" Size="ButtonSize.Large" />
                                                <RadzenText Style="font-size: 1.25rem;">₱@_profitAndLossReport.NetIncome.ToString("N0")</RadzenText>
                                                <RadzenText Style="font-size: 0.875rem;">Net Income</RadzenText>
                                            </RadzenStack>
                                        </RadzenCardContent>
                                    </RadzenCard>
                                </RadzenColumn>
                            </RadzenRow>

                            <!-- Monthly P&L Breakdown -->
                            @if (_profitAndLossReport.MonthlyBreakdown.Any())
                            {
                                <RadzenText Style="font-size: 1.125rem; margin-bottom: 12px;">Monthly Profit & Loss Breakdown</RadzenText>
                                <RadzenDataGrid Data="_profitAndLossReport.MonthlyBreakdown" Dense="true" AllowSorting="true" AllowFiltering="true">
                                    <Columns>
                                        <RadzenDataGridColumn TItem="MonthlyProfitLoss" Property="Month" Title="Month" />
                                        <RadzenDataGridColumn TItem="MonthlyProfitLoss" Property="Revenue" Title="Revenue" TextAlign="TextAlign.Right" FormatString="N0" />
                                        <RadzenDataGridColumn TItem="MonthlyProfitLoss" Property="COGS" Title="COGS" TextAlign="TextAlign.Right" FormatString="N0" />
                                        <RadzenDataGridColumn TItem="MonthlyProfitLoss" Property="GrossProfit" Title="Gross Profit" TextAlign="TextAlign.Right" FormatString="N0" />
                                        <RadzenDataGridColumn TItem="MonthlyProfitLoss" Property="OperatingExpenses" Title="Operating Expenses" TextAlign="TextAlign.Right" FormatString="N0" />
                                        <RadzenDataGridColumn TItem="MonthlyProfitLoss" Property="NetIncome" Title="Net Income" TextAlign="TextAlign.Right">
                                            <Template Context="data">
                                                <span style="color: @(data.NetIncome >= 0 ? "green" : "red")">₱@data.NetIncome.ToString("N0")</span>
                                            </Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="MonthlyProfitLoss" Property="NetMargin" Title="Net Margin" TextAlign="TextAlign.Right" FormatString="F1%" />
                                        <RadzenDataGridColumn TItem="MonthlyProfitLoss" Property="Status" Title="Status" TextAlign="TextAlign.Center">
                                            <Template Context="data">
                                                <RadzenBadge Text="@data.Status" 
                                                            BadgeStyle="@(data.Status == "Profit" ? BadgeStyle.Success : BadgeStyle.Danger)" />
                                            </Template>
                                        </RadzenDataGridColumn>
                                    </Columns>
                                </RadzenDataGrid>
                            }

                            <!-- Key Business Insights -->
                            @if (_profitAndLossReport.KeyInsights.Any())
                            {
                                <RadzenText Style="font-size: 1.125rem; margin-top: 16px; margin-bottom: 12px;">📊 Key Business Insights</RadzenText>
                                <RadzenListBox TValue="string" Data="_profitAndLossReport.KeyInsights" Dense="true" Style="margin-top: 16px;">
                                    <Template Context="insight">
                                        <RadzenStack Row="true" AlignItems="AlignItems.Center">
                                            <RadzenIcon Icon="trending_up" Style="color: #2196F3; margin-right: 8px;" />
                                            <RadzenText>@insight</RadzenText>
                                        </RadzenStack>
                                    </Template>
                                </RadzenListBox>
                            }

                            <!-- Business Recommendations -->
                            @if (_profitAndLossReport.Recommendations.Any())
                            {
                                <RadzenText Style="font-size: 1.125rem; margin-top: 16px; margin-bottom: 12px;">💡 Business Recommendations</RadzenText>
                                <RadzenListBox TValue="string" Data="_profitAndLossReport.Recommendations" Dense="true" Style="margin-top: 16px;">
                                    <Template Context="recommendation">
                                        <RadzenStack Row="true" AlignItems="AlignItems.Center">
                                            <RadzenIcon Icon="lightbulb" Style="@($"color: {(recommendation.StartsWith("URGENT") ? "#F44336" : "#FF9800")}; margin-right: 8px;")" />
                                            <RadzenText>@recommendation</RadzenText>
                                        </RadzenStack>
                                    </Template>
                                </RadzenListBox>
                            }
                        </RadzenCardContent>
                    </RadzenCard>
                }
            }

            <!-- Executive Dashboard Section -->
            <RadzenText Style="font-weight: 600; font-size: 1.5rem; margin-bottom: 12px;">
                <RadzenIcon Icon="trending_up" Style="margin-right: 8px;" />
                Executive Dashboard
            </RadzenText>

            <!-- KPI Cards -->
            <RadzenRow>
                <RadzenColumn Size="12" SizeSM="6" SizeMD="3">
                    <RadzenCard Style="padding: 16px; background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%); color: white; min-height: 120px;">
                        <RadzenCardContent Style="padding: 0;">
                            <RadzenStack Spacing="2">
                                <RadzenStack Row="true" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                                    <RadzenIcon Icon="trending_up" Size="ButtonSize.Large" Style="opacity: 0.8;" />
                                    <RadzenText Style="font-size: 2rem; font-weight: 700;">
                                        ₱@(_analyticsData?.TotalRevenue.ToString("N0") ?? "0")
                                    </RadzenText>
                                </RadzenStack>
                                <RadzenText Style="font-size: 0.875rem; font-weight: 500;">Total Revenue</RadzenText>
                                <RadzenText Style="font-size: 0.75rem; opacity: 0.9;">
                                    @(_analyticsData?.TotalOrders ?? 0) transactions
                                </RadzenText>
                            </RadzenStack>
                        </RadzenCardContent>
                    </RadzenCard>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeSM="6" SizeMD="3">
                    <RadzenCard Style="padding: 16px; background: linear-gradient(135deg, #2196F3 0%, #1976D2 100%); color: white; min-height: 120px;">
                        <RadzenCardContent Style="padding: 0;">
                            <RadzenStack Spacing="2">
                                <RadzenStack Row="true" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                                    <RadzenIcon Icon="account_balance" Size="ButtonSize.Large" Style="opacity: 0.8;" />
                                    <RadzenText Style="font-size: 2rem; font-weight: 700;">
                                        ₱@(_analyticsData?.GrossProfit.ToString("N0") ?? "0")
                                    </RadzenText>
                                </RadzenStack>
                                <RadzenText Style="font-size: 0.875rem; font-weight: 500;">Gross Profit</RadzenText>
                                <RadzenText Style="font-size: 0.75rem; opacity: 0.9;">
                                    @(_analyticsData?.ProfitMargin.ToString("F1") ?? "0")% margin
                                </RadzenText>
                            </RadzenStack>
                        </RadzenCardContent>
                    </RadzenCard>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeSM="6" SizeMD="3">
                    <RadzenCard Style="padding: 16px; background: linear-gradient(135deg, #FF9800 0%, #F57C00 100%); color: white; min-height: 120px;">
                        <RadzenCardContent Style="padding: 0;">
                            <RadzenStack Spacing="2">
                                <RadzenStack Row="true" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                                    <RadzenIcon Icon="inventory" Size="ButtonSize.Large" Style="opacity: 0.8;" />
                                    <RadzenText Style="font-size: 2rem; font-weight: 700;">
                                        @(_dashboardData?.TotalProducts.ToString("N0") ?? "0")
                                    </RadzenText>
                                </RadzenStack>
                                <RadzenText Style="font-size: 0.875rem; font-weight: 500;">Active Products</RadzenText>
                                <RadzenText Style="font-size: 0.75rem; opacity: 0.9;">
                                    @(_dashboardData?.LowStockCount ?? 0) alerts
                                </RadzenText>
                            </RadzenStack>
                        </RadzenCardContent>
                    </RadzenCard>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeSM="6" SizeMD="3">
                    <RadzenCard Style="padding: 16px; background: linear-gradient(135deg, #9C27B0 0%, #7B1FA2 100%); color: white; min-height: 120px;">
                        <RadzenCardContent Style="padding: 0;">
                            <RadzenStack Spacing="2">
                                <RadzenStack Row="true" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                                    <RadzenIcon Icon="cancel" Size="ButtonSize.Large" Style="opacity: 0.8;" />
                                    <RadzenText Style="font-size: 2rem; font-weight: 700;">
                                        @(_analyticsData?.CancellationRate.ToString("F1") ?? "0")%
                                    </RadzenText>
                                </RadzenStack>
                                <RadzenText Style="font-size: 0.875rem; font-weight: 500;">Cancellation Rate</RadzenText>
                                <RadzenText Style="font-size: 0.75rem; opacity: 0.9;">
                                    @(_analyticsData?.CancelledOrders ?? 0) cancelled
                                </RadzenText>
                            </RadzenStack>
                        </RadzenCardContent>
                    </RadzenCard>
                </RadzenColumn>
            </RadzenRow>

            <!-- AI Business Summary Section -->
            @if (_analyticsData != null)
            {
                <RadzenCard Elevation="2" Style="margin-bottom: 16px;">
                    <RadzenCardHeader Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                        <RadzenCardContent>
                            <RadzenStack Row="true" AlignItems="AlignItems.Center">
                                <RadzenIcon Icon="psychology" Size="ButtonSize.Large" />
                                <RadzenStack Spacing="0">
                                    <RadzenText Style="font-size: 1.25rem; font-weight: 600;">AI Business Insights</RadzenText>
                                    <RadzenText Style="font-size: 0.75rem; opacity: 0.9;">Automated analysis of your business performance</RadzenText>
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenCardContent>
                    </RadzenCardHeader>
                    <RadzenCardContent Style="padding: 16px;">
                        <RadzenStack Spacing="3">
                            <!-- Performance Summary -->
                            <div Style="padding: 12px; background: #f5f5f5; border-left: 4px solid #4CAF50;">
                                <RadzenText Style="font-size: 0.875rem; font-weight: 600; color: #4CAF50;">
                                    📊 Performance Summary
                                </RadzenText>
                                <RadzenText Style="font-size: 0.875rem; margin-top: 8px;">
                                    Your business generated ₱@(_analyticsData?.TotalRevenue.ToString("N0") ?? "0") in revenue with @(_analyticsData?.ProfitMargin.ToString("F1") ?? "0")% profit margin. Total orders: @(_analyticsData?.TotalOrders ?? 0) with @(_analyticsData?.CancellationRate.ToString("F1") ?? "0")% cancellation rate.
                                </RadzenText>
                            </div>
                        </RadzenStack>
                    </RadzenCardContent>
                </RadzenCard>
            }
        }
    </RadzenStack>
</RadzenStack>

@code {
    private bool _loading = true;
    private bool _generatingReport = false;
    private string? _errorMessage;
    private BusinessAnalyticsData? _analyticsData;
    private InventoryDashboardData? _dashboardData;
    private ProfitAndLossReport? _profitAndLossReport;
    private InventoryValuationReport? _inventoryValuationReport;
    private COGSReport? _cogsReport;
    private InventoryTurnoverReport? _turnoverReport;
    private object? _currentReportData;
    private AnalyticalReportType _selectedReportType = AnalyticalReportType.ProfitAndLossStatement;
    private DateTime _startDate = DateTime.Now.AddMonths(-1);
    private DateTime _endDate = DateTime.Now;

    protected override async Task OnInitializedAsync()
    {
        await LoadReportsData();
    }

    private async Task LoadReportsData()
    {
        try
        {
            _loading = true;
            _errorMessage = null;
            StateHasChanged();

            // Load business analytics data
            _analyticsData = await BusinessAnalyticsService.GetBusinessAnalyticsAsync(_startDate, _endDate);
            
            // Load dashboard data
            _dashboardData = await InventoryDashboardService.GetDashboardDataAsync();
            
            // Load profit and loss report
            var request = new AnalyticalReportRequest
            {
                ReportType = AnalyticalReportType.ProfitAndLossStatement,
                StartDate = _startDate,
                EndDate = _endDate
            };
            _profitAndLossReport = await AnalyticalReportService.GenerateProfitAndLossReportAsync(request);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading reports: {ex.Message}";
            NotificationService.Notify(NotificationSeverity.Error, "Error", _errorMessage);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshReports()
    {
        await LoadReportsData();
        NotificationService.Notify(NotificationSeverity.Success, "Success", "Reports refreshed successfully");
    }

    private async Task OnDateRangeChanged()
    {
        await LoadReportsData();
    }

    private async Task GenerateAnalyticalReport()
    {
        try
        {
            _generatingReport = true;
            _currentReportData = null;
            StateHasChanged();

            var request = new AnalyticalReportRequest
            {
                ReportType = _selectedReportType,
                StartDate = _startDate,
                EndDate = _endDate
            };

            switch (_selectedReportType)
            {
                case AnalyticalReportType.InventoryValuation:
                    _inventoryValuationReport = await AnalyticalReportService.GenerateInventoryValuationReportAsync(request);
                    _currentReportData = _inventoryValuationReport;
                    break;
                case AnalyticalReportType.CostOfGoodsSold:
                    _cogsReport = await AnalyticalReportService.GenerateCOGSReportAsync(request);
                    _currentReportData = _cogsReport;
                    break;
                case AnalyticalReportType.InventoryTurnover:
                    _turnoverReport = await AnalyticalReportService.GenerateInventoryTurnoverReportAsync(request);
                    _currentReportData = _turnoverReport;
                    break;
                case AnalyticalReportType.ProfitAndLossStatement:
                    _profitAndLossReport = await AnalyticalReportService.GenerateProfitAndLossReportAsync(request);
                    _currentReportData = _profitAndLossReport;
                    break;
            }

            NotificationService.Notify(NotificationSeverity.Success, "Success", "Report generated successfully");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", $"Report generation failed: {ex.Message}");
        }
        finally
        {
            _generatingReport = false;
            StateHasChanged();
        }
    }

    private async Task PreviewReport()
    {
        if (_currentReportData == null)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Warning", "Please generate a report first");
            return;
        }

        // For now, just show a success message - preview functionality can be enhanced later
        NotificationService.Notify(NotificationSeverity.Info, "Preview", "Report preview functionality coming soon");
    }

    private async Task ExportToCrystalReports()
    {
        try
        {
            if (_currentReportData == null)
            {
                NotificationService.Notify(NotificationSeverity.Warning, "Warning", "Please generate a report first");
                return;
            }

            var request = new AnalyticalReportRequest
            {
                ReportType = _selectedReportType,
                StartDate = _startDate,
                EndDate = _endDate
            };

            var pdfBytes = await AnalyticalReportService.GenerateCrystalReportAsync(request);
            var fileName = $"{_selectedReportType}_Report_{DateTime.Now:yyyyMMdd_HHmmss}.pdf";
            
            await JSRuntime.InvokeVoidAsync("downloadFile", fileName, Convert.ToBase64String(pdfBytes));
            NotificationService.Notify(NotificationSeverity.Success, "Success", "Report exported successfully");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", $"Export failed: {ex.Message}");
        }
    }

    private async Task ExportToPdf()
    {
        await ExportToCrystalReports();
    }
}
