@using ModularSys.Data.Common.Entities.Inventory
@using ModularSys.Inventory.Interface
@using Radzen
@using Radzen.Blazor

@inject ICategoryService CategoryService
@inject Radzen.DialogService DialogService
@inject NotificationService NotificationService

<div style="width: 100%; max-height: 90vh; display: flex; flex-direction: column; background: white; border-radius: 12px; box-shadow: 0 4px 24px rgba(0, 0, 0, 0.12); overflow: hidden;">
    <!-- Header -->
    <div style="padding: 20px 24px; border-bottom: 1px solid #e5e7eb; flex-shrink: 0; background: white;">
        <div style="display: flex; align-items: center; gap: 12px;">
            <div style="width: 48px; height: 48px; border-radius: 12px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);">
                <RadzenIcon Icon="category" Style="color: white; font-size: 1.5rem;" />
            </div>
            <div>
                <h2 style="margin: 0; font-size: 1.5rem; font-weight: 600; color: #1f2937;">
                    @(Id.HasValue ? "Edit Category" : "New Category")
                </h2>
                <p style="margin: 4px 0 0 0; color: #6b7280; font-size: 0.875rem;">
                    @(Id.HasValue ? "Update category information and settings" : "Create a new product category")
                </p>
            </div>
        </div>
    </div>

    <!-- Form Content -->
    <div style="padding: 24px; flex: 1; background: white; overflow-y: auto;">
        <RadzenStack Gap="1.5rem">
            <!-- Basic Information Section -->
            <div>
                <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
                    <RadzenIcon Icon="info" Style="color: #10b981;" />
                    <h3 style="margin: 0; font-size: 1rem; font-weight: 600; color: #374151;">Basic Information</h3>
                </div>
                
                <RadzenStack Gap="1rem">
                    <RadzenFormField Text="Category Name" Variant="Variant.Outlined" Style="width: 100%;">
                        <RadzenTextBox @bind-Value="_model.CategoryName" 
                                      Placeholder="Enter category name"
                                      Style="width: 100%;" />
                    </RadzenFormField>

                    <RadzenFormField Text="Description" Variant="Variant.Outlined" Style="width: 100%;">
                        <RadzenTextArea @bind-Value="_model.Description" 
                                       Placeholder="Detailed category description"
                                       Rows="3"
                                       Style="width: 100%;" />
                    </RadzenFormField>

                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Icon" Variant="Variant.Outlined" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="_model.Icon" 
                                              Placeholder="category"
                                              Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Color" Variant="Variant.Outlined" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="_model.Color" 
                                              Placeholder="#1976d2"
                                              Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenStack>
            </div>

            <!-- Settings Section -->
            <div>
                <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
                    <RadzenIcon Icon="settings" Style="color: #f59e0b;" />
                    <h3 style="margin: 0; font-size: 1rem; font-weight: 600; color: #374151;">Settings</h3>
                </div>
                
                <RadzenStack Gap="1rem">
                    <RadzenFormField Text="Default Min Threshold" Variant="Variant.Outlined" Style="width: 100%;">
                        <RadzenNumeric TValue="int" 
                                     @bind-Value="_model.DefaultMinThreshold"
                                     ShowUpDown="false"
                                     Style="width: 100%;" />
                    </RadzenFormField>

                    <RadzenFormField Text="Parent Category" Variant="Variant.Outlined" Style="width: 100%;">
                        <RadzenDropDown Data="_parentCategories" 
                                       @bind-Value="_model.ParentCategoryId"
                                       TextProperty="CategoryName"
                                       ValueProperty="CategoryId"
                                       Placeholder="No Parent (Top Level)"
                                       AllowClear="true"
                                       Style="width: 100%;" />
                    </RadzenFormField>

                    <div style="display: flex; align-items: center; gap: 8px;">
                        <RadzenCheckBox @bind-Value="_model.IsActive" Name="active" />
                        <RadzenLabel Text="Active Category" Component="active" Style="cursor: pointer;" />
                    </div>
                </RadzenStack>
            </div>
        </RadzenStack>
    </div>

    <!-- Footer Actions -->
    <div style="padding: 16px 24px; border-top: 1px solid #e5e7eb; background: white; display: flex; justify-content: flex-end; gap: 12px; flex-shrink: 0;">
        <RadzenButton Text="Cancel" 
                     Icon="close"
                     ButtonStyle="ButtonStyle.Light" 
                     Click="Cancel"
                     Style="min-width: 100px;" />
        <RadzenButton Text="@(Id.HasValue ? "Update" : "Add Category")" 
                     Icon="@(Id.HasValue ? "save" : "add")"
                     ButtonStyle="ButtonStyle.Primary" 
                     Click="Save"
                     Style="min-width: 120px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); border: none;" />
    </div>
</div>

@code {
    [Parameter] public int? Id { get; set; }

    private Category _model = new();
    private List<Category> _parentCategories = new();

    protected override async Task OnInitializedAsync()
    {
        // Load all categories for parent selection (excluding current category if editing)
        var allCategories = await CategoryService.GetAllAsync();
        _parentCategories = allCategories.Where(c => Id == null || c.CategoryId != Id.Value).ToList();

        if (Id is int id)
        {
            var existing = await CategoryService.GetByIdAsync(id);
            if (existing is not null) 
            {
                _model = existing;
                // Remove current category and its descendants from parent options to prevent circular references
                _parentCategories = _parentCategories.Where(c => c.CategoryId != id && 
                    !IsDescendantOf(c, id)).ToList();
            }
        }
        else
        {
            // Set defaults for new category
            _model.Icon = "Category";
            _model.Color = "#1976d2";
            _model.IsActive = true;
            _model.DefaultMinThreshold = 10;
        }
    }

    private bool IsDescendantOf(Category category, int ancestorId)
    {
        var current = category;
        while (current.ParentCategoryId.HasValue)
        {
            if (current.ParentCategoryId.Value == ancestorId)
                return true;
            current = _parentCategories.FirstOrDefault(c => c.CategoryId == current.ParentCategoryId.Value);
            if (current == null) break;
        }
        return false;
    }

    private async Task Save()
    {
        if (_model.CategoryId == 0)
        {
            await CategoryService.CreateAsync(_model);
            NotificationService.Notify(NotificationSeverity.Success, "Success", "Category created successfully.");
        }
        else
        {
            await CategoryService.UpdateAsync(_model);
            NotificationService.Notify(NotificationSeverity.Success, "Success", "Category updated successfully.");
        }

        DialogService.Close(true);
    }

    private void Cancel() => DialogService.Close(false);
}