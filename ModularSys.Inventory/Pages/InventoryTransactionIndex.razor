@page "/inventory-transactions"
@using ModularSys.Inventory.Interface
@using Radzen.Blazor
@using InventoryTransactionEntity = ModularSys.Data.Common.Entities.Inventory.InventoryTransaction
@inject IInventoryService InventoryService
@inject NotificationService NotificationService

<div style="padding: 24px; background: #fafafa; min-height: 100vh;">
    <!-- Header -->
    <div style="margin-bottom: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h1 style="margin: 0; font-size: 2rem; font-weight: 600; color: #374151;">
                    <RadzenIcon Icon="swap_horiz" Style="margin-right: 12px; color: #3b82f6;" />
                    Inventory Transactions
                </h1>
                <p style="margin: 4px 0 0 0; color: #6b7280; font-size: 0.875rem;">
                    Track all inventory movements and stock changes
                </p>
            </div>
            <div style="display: flex; gap: 12px;">
                <RadzenButton Text="Refresh" 
                            Icon="refresh" 
                            ButtonStyle="ButtonStyle.Light"
                            Style="border-radius: 8px;" />
            </div>
        </div>
    </div>

    <!-- Quick Stats -->
    <RadzenRow Gap="16px" Style="margin-bottom: 24px;">
        <RadzenColumn Size="12" SizeMD="3">
            <RadzenCard Style="background: white; border-radius: 12px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                <div style="display: flex; align-items: center; justify-content: space-between;">
                    <div>
                        <RadzenText Style="font-size: 0.875rem; color: #6b7280; margin-bottom: 4px;">Total Transactions</RadzenText>
                        <RadzenText Style="font-size: 2rem; font-weight: 700; margin: 0; color: #374151;">@_totalTransactions</RadzenText>
                        <RadzenText Style="font-size: 0.75rem; color: #9ca3af; margin-top: 4px;">
                            This month
                        </RadzenText>
                    </div>
                    <RadzenIcon Icon="receipt_long" Style="font-size: 3rem; color: #3b82f6;" />
                </div>
            </RadzenCard>
        </RadzenColumn>
        
        <RadzenColumn Size="12" SizeMD="3">
            <RadzenCard Style="background: white; border-radius: 12px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                <div style="display: flex; align-items: center; justify-content: space-between;">
                    <div>
                        <RadzenText Style="font-size: 0.875rem; color: #6b7280; margin-bottom: 4px;">Stock In</RadzenText>
                        <RadzenText Style="font-size: 2rem; font-weight: 700; margin: 0; color: #374151;">@_stockInCount</RadzenText>
                        <RadzenText Style="font-size: 0.75rem; color: #9ca3af; margin-top: 4px;">
                            Incoming stock
                        </RadzenText>
                    </div>
                    <RadzenIcon Icon="add_circle" Style="font-size: 3rem; color: #10b981;" />
                </div>
            </RadzenCard>
        </RadzenColumn>
        
        <RadzenColumn Size="12" SizeMD="3">
            <RadzenCard Style="background: white; border-radius: 12px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                <div style="display: flex; align-items: center; justify-content: space-between;">
                    <div>
                        <RadzenText Style="font-size: 0.875rem; color: #6b7280; margin-bottom: 4px;">Stock Out</RadzenText>
                        <RadzenText Style="font-size: 2rem; font-weight: 700; margin: 0; color: #374151;">@_stockOutCount</RadzenText>
                        <RadzenText Style="font-size: 0.75rem; color: #9ca3af; margin-top: 4px;">
                            Outgoing stock
                        </RadzenText>
                    </div>
                    <RadzenIcon Icon="remove_circle" Style="font-size: 3rem; color: #f59e0b;" />
                </div>
            </RadzenCard>
        </RadzenColumn>
        
        <RadzenColumn Size="12" SizeMD="3">
            <RadzenCard Style="background: white; border-radius: 12px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                <div style="display: flex; align-items: center; justify-content: space-between;">
                    <div>
                        <RadzenText Style="font-size: 0.875rem; color: #6b7280; margin-bottom: 4px;">Net Movement</RadzenText>
                        <RadzenText Style="font-size: 2rem; font-weight: 700; margin: 0; color: #374151;">@(_stockInCount - _stockOutCount)</RadzenText>
                        <RadzenText Style="font-size: 0.75rem; color: #9ca3af; margin-top: 4px;">
                            Net change
                        </RadzenText>
                    </div>
                    <RadzenIcon Icon="trending_up" Style="font-size: 3rem; color: #8b5cf6;" />
                </div>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>

    <!-- Transactions Table -->
    <RadzenCard Style="border-radius: 12px; padding: 0; overflow: hidden;">
        <div style="padding: 20px; border-bottom: 1px solid #f0f0f0;">
            <RadzenText Style="font-size: 1.125rem; font-weight: 600; color: #374151;">
                <RadzenIcon Icon="list" Style="margin-right: 8px; color: #3b82f6;" />
                Recent Transactions
            </RadzenText>
        </div>
        
        @if (_isLoading)
        {
            <div style="padding: 40px; text-align: center;">
                <RadzenProgressBarCircular ShowValue="false" Size="ProgressBarCircularSize.Medium" />
                <RadzenText Style="margin-top: 16px; color: #6b7280;">Loading transactions...</RadzenText>
            </div>
        }
        else if (!_transactions.Any())
        {
            <div style="padding: 40px; text-align: center;">
                <RadzenIcon Icon="receipt_long" Style="font-size: 3rem; color: #6b7280; margin-bottom: 16px;" />
                <h3 style="margin: 0 0 8px 0; color: #374151;">No Transactions Found</h3>
                <p style="margin: 0; color: #6b7280;">Inventory transactions will appear here once you start managing stock.</p>
            </div>
        }
        else
        {
            <RadzenDataGrid Data="@_transactions" TItem="InventoryTransactionEntity" 
                          AllowPaging="true" PageSize="10" 
                          AllowSorting="true" AllowFiltering="true"
                          Style="border: none;">
                <Columns>
                    <RadzenDataGridColumn TItem="InventoryTransactionEntity" Property="TransactionNumber" Title="Transaction #" Width="150px" />
                    <RadzenDataGridColumn TItem="InventoryTransactionEntity" Property="TransactionType" Title="Type" Width="120px">
                        <Template Context="transaction">
                            <RadzenBadge Text="@transaction.TransactionType" 
                                       BadgeStyle="@(transaction.QuantityChange > 0 ? BadgeStyle.Success : BadgeStyle.Warning)" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="InventoryTransactionEntity" Property="Product.Name" Title="Product" />
                    <RadzenDataGridColumn TItem="InventoryTransactionEntity" Property="QuantityChange" Title="Quantity Change" Width="120px">
                        <Template Context="transaction">
                            <span style="color: @(transaction.QuantityChange > 0 ? "#10b981" : "#f59e0b");">
                                @(transaction.QuantityChange > 0 ? "+" : "")@transaction.QuantityChange
                            </span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="InventoryTransactionEntity" Property="UnitCost" Title="Unit Cost" Width="120px" FormatString="{0:C}" />
                    <RadzenDataGridColumn TItem="InventoryTransactionEntity" Property="TransactionDate" Title="Date" Width="150px" FormatString="{0:MMM dd, yyyy}" />
                    <RadzenDataGridColumn TItem="InventoryTransactionEntity" Property="Notes" Title="Notes" />
                </Columns>
            </RadzenDataGrid>
        }
    </RadzenCard>
</div>

@code {
    private List<InventoryTransactionEntity> _transactions = new();
    private bool _isLoading = true;
    private int _totalTransactions = 0;
    private int _stockInCount = 0;
    private int _stockOutCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadTransactions();
    }

    private async Task LoadTransactions()
    {
        try
        {
            _isLoading = true;
            StateHasChanged();

            // Load transactions from service
            var allTransactions = await InventoryService.GetAllAsync();
            _transactions = allTransactions.OrderByDescending(t => t.TransactionDate).Take(100).ToList();
            
            // Calculate stats
            _totalTransactions = _transactions.Count;
            _stockInCount = _transactions.Count(t => t.QuantityChange > 0);
            _stockOutCount = _transactions.Count(t => t.QuantityChange < 0);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", $"Failed to load transactions: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }
}
