@page "/inventory"
@using ModularSys.Inventory.Pages
@using ModularSys.Inventory.Interface
@using ModularSys.Inventory.Services
@using ModularSys.Data.Common.Entities.Inventory
@using ModularSys.Data.Common.Entities
@using Radzen.Blazor
@inject DialogService DialogService
@inject IInventoryDashboardService DashboardService
@inject IProductService ProductService
@inject ICategoryService CategoryService
@inject ISalesOrderService SalesOrderService
@inject IPurchaseOrderService PurchaseOrderService
@inject NotificationService NotificationService
@inject InventoryNavigationService NavService
@implements IDisposable

<div style="padding: 24px; background: #fafafa; min-height: 100vh;">
    <!-- Enhanced Header with Quick Stats -->
    <div style="margin-bottom: 32px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
            <div>
                <h1 style="margin: 0; font-size: 2rem; font-weight: 600; color: #374151;">
                    <RadzenIcon Icon="inventory" Style="margin-right: 12px; color: #3b82f6;" />
                    Inventory Management
                </h1>
                <p style="margin: 4px 0 0 0; color: #6b7280; font-size: 0.875rem;">
                    Comprehensive inventory operations and business intelligence
                </p>
            </div>
            @if (_selectedModule == "dashboard")
            {
                <div style="display: flex; gap: 12px;">
                    <RadzenButton Text="Quick Add Product" 
                                Icon="add_box" 
                                ButtonStyle="ButtonStyle.Primary"
                                Click="@(async () => await OpenProductFormDialog())"
                                Style="border-radius: 8px;" />
                    <RadzenButton Text="New Sales Order" 
                                Icon="receipt_long" 
                                ButtonStyle="ButtonStyle.Success"
                                Click="@(async () => await OpenSalesOrderFormDialog())"
                                Style="border-radius: 8px;" />
                    <RadzenButton Text="Refresh Data" 
                                Icon="refresh" 
                                ButtonStyle="ButtonStyle.Light"
                                Click="@(async () => await RefreshDashboard())"
                                Style="border-radius: 8px;" />
                </div>
            }
        </div>

        <!-- Quick Overview Cards -->
        @if (_isLoading)
        {
            <RadzenRow Gap="16px" Style="margin-bottom: 24px;">
                @for (int i = 0; i < 4; i++)
                {
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenCard Style="border-radius: 12px; padding: 20px; height: 120px; display: flex; align-items: center; justify-content: center;">
                            <RadzenProgressBarCircular ShowValue="false" Size="ProgressBarCircularSize.Medium" />
                        </RadzenCard>
                    </RadzenColumn>
                }
            </RadzenRow>
        }
        else if (_dashboardData != null)
        {
            <RadzenRow Gap="16px" Style="margin-bottom: 24px;">
                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenCard Style="background: white; border-radius: 12px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                        <div style="display: flex; align-items: center; justify-content: space-between;">
                            <div>
                                <RadzenText Style="font-size: 0.875rem; color: #6b7280; margin-bottom: 4px;">Total Products</RadzenText>
                                <RadzenText Style="font-size: 2rem; font-weight: 700; margin: 0; color: #374151;">@_dashboardData.TotalProducts</RadzenText>
                                <RadzenText Style="font-size: 0.75rem; color: #9ca3af; margin-top: 4px;">
                                    @_dashboardData.TotalCategories categories
                                </RadzenText>
                            </div>
                            <RadzenIcon Icon="inventory_2" Style="font-size: 3rem; color: #3b82f6;" />
                        </div>
                    </RadzenCard>
                </RadzenColumn>
                
                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenCard Style="background: white; border-radius: 12px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                        <div style="display: flex; align-items: center; justify-content: space-between;">
                            <div>
                                <RadzenText Style="font-size: 0.875rem; color: #6b7280; margin-bottom: 4px;">Inventory Value</RadzenText>
                                <RadzenText Style="font-size: 2rem; font-weight: 700; margin: 0; color: #374151;">₱@_dashboardData.TotalInventoryValue.ToString("N0")</RadzenText>
                                <RadzenText Style="font-size: 0.75rem; color: #9ca3af; margin-top: 4px;">
                                    Current valuation
                                </RadzenText>
                            </div>
                            <RadzenIcon Icon="account_balance_wallet" Style="font-size: 3rem; color: #10b981;" />
                        </div>
                    </RadzenCard>
                </RadzenColumn>
                
                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenCard Style="background: white; border-radius: 12px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                        <div style="display: flex; align-items: center; justify-content: space-between;">
                            <div>
                                <RadzenText Style="font-size: 0.875rem; color: #6b7280; margin-bottom: 4px;">Low Stock Alerts</RadzenText>
                                <RadzenText Style="font-size: 2rem; font-weight: 700; margin: 0; color: #374151;">@_dashboardData.LowStockCount</RadzenText>
                                <RadzenText Style="font-size: 0.75rem; color: #9ca3af; margin-top: 4px;">
                                    Need attention
                                </RadzenText>
                            </div>
                            <RadzenIcon Icon="warning" Style="font-size: 3rem; color: #f59e0b;" />
                        </div>
                    </RadzenCard>
                </RadzenColumn>
                
                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenCard Style="background: white; border-radius: 12px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                        <div style="display: flex; align-items: center; justify-content: space-between;">
                            <div>
                                <RadzenText Style="font-size: 0.875rem; color: #6b7280; margin-bottom: 4px;">Pending Orders</RadzenText>
                                <RadzenText Style="font-size: 2rem; font-weight: 700; margin: 0; color: #374151;">@(_dashboardData.PendingSalesOrders + _dashboardData.PendingPurchaseOrders)</RadzenText>
                                <RadzenText Style="font-size: 0.75rem; color: #9ca3af; margin-top: 4px;">
                                    Sales + Purchase
                                </RadzenText>
                            </div>
                            <RadzenIcon Icon="pending_actions" Style="font-size: 3rem; color: #8b5cf6;" />
                        </div>
                    </RadzenCard>
                </RadzenColumn>
            </RadzenRow>
        }
        else
        {
            <!-- No Data State -->
            <RadzenRow Gap="16px" Style="margin-bottom: 24px;">
                <RadzenColumn Size="12">
                    <RadzenCard Style="background: white; border-radius: 12px; padding: 40px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                        <RadzenIcon Icon="info" Style="font-size: 3rem; color: #6b7280; margin-bottom: 16px;" />
                        <RadzenText Style="font-size: 1.25rem; font-weight: 600; margin-bottom: 8px; color: #374151;">No Dashboard Data Available</RadzenText>
                        <RadzenText Style="color: #6b7280; margin-bottom: 16px;">Dashboard data will appear here once you start adding products and creating orders.</RadzenText>
                        <RadzenButton Text="Add Sample Data" 
                                    Icon="add" 
                                    ButtonStyle="ButtonStyle.Primary"
                                    Click="@(async () => await RefreshDashboard())"
                                    Style="border-radius: 8px;" />
                    </RadzenCard>
                </RadzenColumn>
            </RadzenRow>
        }

    </div>

    <!-- Main Content Area -->
    <RadzenCard Style="background: white; border-radius: 12px; border: 1px solid #e5e7eb; padding: 24px; min-height: 600px;">
        @switch (_selectedModule)
        {
            case "dashboard":
                <InventoryDashboard />
                break;
            case "products":
                <ProductIndex />
                break;
            case "categories":
                <CategoryIndex />
                break;
            case "sales-orders":
                <SalesOrderIndex />
                break;
            case "purchase-orders":
                <PurchaseOrderIndex />
                break;
            case "transactions":
                <InventoryTransactionIndex />
                break;
            case "stock-alerts":
                <StockAlerts />
                break;
            case "reports":
                <InventoryReports />
                break;
            default:
                <InventoryDashboard />
                break;
        }
    </RadzenCard>
</div>

@code {
    private InventoryDashboardData? _dashboardData;
    private bool _isLoading = true;
    private string _selectedModule = "dashboard";

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
        NavService.OnModuleChanged += HandleModuleChanged;
        _selectedModule = NavService.SelectedModule;
    }

    private void HandleModuleChanged(string module)
    {
        _selectedModule = module;
        StateHasChanged();
    }

    public void Dispose()
    {
        NavService.OnModuleChanged -= HandleModuleChanged;
    }

    private async Task LoadDashboardData()
    {
        try
        {
            _isLoading = true;
            _dashboardData = await DashboardService.GetDashboardDataAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", $"Failed to load dashboard data: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshDashboard()
    {
        NotificationService.Notify(NotificationSeverity.Info, "Refreshing", "Updating dashboard data...");
        await LoadDashboardData();
        NotificationService.Notify(NotificationSeverity.Success, "Success", "Dashboard data refreshed successfully");
    }

    private async Task OpenProductFormDialog()
    {
        var result = await DialogService.OpenAsync<ProductForm>("", 
            new Dictionary<string, object>(),
            new DialogOptions() 
            { 
                ShowTitle = false,
                Style = "border-radius: 12px; padding: 0; max-width: none; background: transparent;",
                CloseDialogOnEsc = true,
                Resizable = false,
                Draggable = true,
                Width = "700px"
            });

        if (result != null)
        {
            await RefreshDashboard();
            NotificationService.Notify(NotificationSeverity.Success, "Success", "Product added successfully");
        }
    }

    private async Task OpenSalesOrderFormDialog()
    {
        var result = await DialogService.OpenAsync<SalesOrderForm>("", 
            new Dictionary<string, object>(),
            new DialogOptions() 
            { 
                ShowTitle = false,
                Style = "border-radius: 12px; padding: 0; overflow: hidden; max-width: none;",
                CloseDialogOnEsc = true,
                Resizable = false,
                Draggable = true
            });

        if (result != null)
        {
            await RefreshDashboard();
            NotificationService.Notify(NotificationSeverity.Success, "Success", "Sales order created successfully");
        }
    }

    private async Task OpenPurchaseOrderFormDialog()
    {
        var result = await DialogService.OpenAsync<PurchaseOrderForm>("", 
            new Dictionary<string, object>(),
            new DialogOptions() 
            { 
                ShowTitle = false,
                Style = "border-radius: 12px; padding: 0; overflow: hidden; max-width: none;",
                CloseDialogOnEsc = true,
                Resizable = false,
                Draggable = true
            });

        if (result != null)
        {
            await RefreshDashboard();
            NotificationService.Notify(NotificationSeverity.Success, "Success", "Purchase order created successfully");
        }
    }
}
