@using ModularSys.Inventory.Interface
@inject IInventoryDashboardService DashboardService
@inject IProductService ProductService
@inject NotificationService NotificationService
@inject Radzen.DialogService DialogService

<RadzenStack Gap="1rem" Style="padding: 1rem;">
    <!-- Header -->
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <RadzenText Text="Stock Alerts" Style="font-size: 1.5rem; font-weight: 600;">
            <RadzenIcon Icon="notifications_active" Style="margin-right: 0.5rem;" />
        </RadzenText>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <RadzenButton Text="Refresh" 
                        ButtonStyle="ButtonStyle.Light" 
                        Icon="refresh" 
                        Click="RefreshAlerts"
                        Loading="_loading" />
            <RadzenButton Text="Add Product" 
                        ButtonStyle="ButtonStyle.Primary"
                        Icon="add" 
                        Click="CreateProduct" />
        </RadzenStack>
    </RadzenStack>

    <!-- Alert Summary Cards -->
    <RadzenRow Gap="1rem">
        <RadzenColumn Size="12" SizeMD="3">
            <RadzenCard>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                    <RadzenIcon Icon="error" Style="color: var(--rz-danger); font-size: 2rem;" />
                    <RadzenStack Gap="0">
                        <RadzenText Text="@_criticalAlerts.ToString()" Style="font-size: 1.5rem; font-weight: 600;" />
                        <RadzenText Text="Critical Alerts" Style="color: var(--rz-text-secondary);" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeMD="3">
            <RadzenCard>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                    <RadzenIcon Icon="warning" Style="color: var(--rz-warning); font-size: 2rem;" />
                    <RadzenStack Gap="0">
                        <RadzenText Text="@_warningAlerts.ToString()" Style="font-size: 1.5rem; font-weight: 600;" />
                        <RadzenText Text="Warning Alerts" Style="color: var(--rz-text-secondary);" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeMD="3">
            <RadzenCard>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                    <RadzenIcon Icon="schedule" Style="color: var(--rz-info); font-size: 2rem;" />
                    <RadzenStack Gap="0">
                        <RadzenText Text="@_expiringAlerts.ToString()" Style="font-size: 1.5rem; font-weight: 600;" />
                        <RadzenText Text="Expiring Soon" Style="color: var(--rz-text-secondary);" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeMD="3">
            <RadzenCard>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                    <RadzenIcon Icon="inventory" Style="color: var(--rz-success); font-size: 2rem;" />
                    <RadzenStack Gap="0">
                        <RadzenText Text="@($"{(_stockAlerts?.Count() ?? 0)}")" Style="font-size: 1.5rem; font-weight: 600;" />
                        <RadzenText Text="Total Alerts" Style="color: var(--rz-text-secondary);" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>

    <!-- Filters -->
    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
            <RadzenDropDown Data="@_alertTypes" Value="_selectedAlertType" ValueChanged="@((string value) => _selectedAlertType = value)" 
                          Placeholder="Alert Type" Style="min-width: 150px;" />
            <RadzenDropDown Data="@_severities" Value="_selectedSeverity" ValueChanged="@((string value) => _selectedSeverity = value)" 
                          Placeholder="Severity" Style="min-width: 150px;" />
            <RadzenTextBox Value="_searchText" ValueChanged="@((string value) => _searchText = value)" Placeholder="Search Products" 
                         Icon="search" Style="flex: 1;" />
        </RadzenStack>
    </RadzenCard>

    <!-- Alerts Table -->
    <RadzenCard>
        <RadzenText Text="Stock Alerts" Style="font-size: 1.25rem; font-weight: 600; margin-bottom: 1rem;" />
        
        @if (_loading)
        {
            <RadzenStack AlignItems="AlignItems.Center" Gap="0.5rem" Style="padding: 2rem;">
                <RadzenProgressBarCircular ShowValue="false" />
                <RadzenText Text="Loading alerts..." />
            </RadzenStack>
        }
        else if (_filteredAlerts?.Any() == true)
        {
            <RadzenDataGrid Data="_filteredAlerts" TItem="StockAlert" AllowColumnResize="true" AllowSorting="true" PageSize="25">
                <Columns>
                    <RadzenDataGridColumn TItem="StockAlert" Property="Severity" Title="Severity" Width="120px">
                        <Template Context="alert">
                            <RadzenBadge Text="@alert.Severity" BadgeStyle="@GetSeverityBadgeStyle(alert.Severity)" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="StockAlert" Property="ProductName" Title="Product" Width="200px" />
                    <RadzenDataGridColumn TItem="StockAlert" Property="SKU" Title="SKU" Width="120px" />
                    <RadzenDataGridColumn TItem="StockAlert" Property="AlertType" Title="Alert Type" Width="120px">
                        <Template Context="alert">
                            <RadzenBadge Text="@alert.AlertType" BadgeStyle="@GetAlertTypeBadgeStyle(alert.AlertType)" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="StockAlert" Property="Message" Title="Message" Width="300px">
                        <Template Context="alert">
                            <RadzenText Text="@alert.Message" />
                            @if (alert.ExpiryDate.HasValue)
                            {
                                <RadzenText Text="@($"Expires: {alert.ExpiryDate.Value:MMM dd, yyyy}")" 
                                          Style="color: var(--rz-text-secondary); font-size: 0.875rem;" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="StockAlert" Property="CurrentStock" Title="Current Stock" Width="120px" TextAlign="TextAlign.Right">
                        <Template Context="alert">
                            <RadzenBadge Text="@alert.CurrentStock.ToString()" 
                                       BadgeStyle="@(alert.CurrentStock == 0 ? BadgeStyle.Danger : alert.CurrentStock <= (alert.MinStockLevel ?? 0) ? BadgeStyle.Warning : BadgeStyle.Success)" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="StockAlert" Property="ReorderLevel" Title="Reorder Level" Width="120px" TextAlign="TextAlign.Right" />
                    <RadzenDataGridColumn TItem="StockAlert" Title="Actions" Width="120px" Sortable="false" Filterable="false">
                        <Template Context="alert">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" 
                                            Click="@(() => EditProduct(alert.ProductId))" />
                                @if (alert.AlertType == "LowStock" || alert.AlertType == "OutOfStock")
                                {
                                    <RadzenButton Icon="shopping_cart" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" 
                                                Click="@(() => CreatePurchaseOrder(alert.ProductId))" />
                                }
                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
        else
        {
            <RadzenStack AlignItems="AlignItems.Center" Gap="0.5rem" Style="padding: 2rem;">
                <RadzenIcon Icon="check_circle" Style="color: var(--rz-success); font-size: 3rem;" />
                <RadzenText Text="All Good!" Style="font-size: 1.25rem; font-weight: 600; color: var(--rz-success);" />
                <RadzenText Text="No stock alerts at this time." Style="color: var(--rz-text-secondary);" />
            </RadzenStack>
        }
    </RadzenCard>
</RadzenStack>

@code {
    private bool _loading = true;
    private IEnumerable<StockAlert>? _stockAlerts;
    private IEnumerable<StockAlert>? _filteredAlerts;
    private string _selectedAlertType = "All";
    private string _selectedSeverity = "All";
    private string _searchText = string.Empty;

    private int _criticalAlerts;
    private int _warningAlerts;
    private int _expiringAlerts;

    private readonly List<string> _alertTypes = new() { "All", "Out Of Stock", "Low Stock", "Expiring" };
    private readonly List<string> _severities = new() { "All", "Critical", "Error", "Warning", "Info" };

    protected override async Task OnInitializedAsync()
    {
        await LoadAlerts();
    }

    protected override void OnParametersSet()
    {
        FilterAlerts();
    }

    private async Task LoadAlerts()
    {
        try
        {
            _loading = true;
            StateHasChanged();

            _stockAlerts = await DashboardService.GetStockAlertsAsync();
            
            // Calculate summary counts
            _criticalAlerts = _stockAlerts.Count(a => a.Severity == "Error");
            _warningAlerts = _stockAlerts.Count(a => a.Severity == "Warning");
            _expiringAlerts = _stockAlerts.Count(a => a.AlertType == "Expiring");

            FilterAlerts();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", $"Error loading alerts: {ex.Message}");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void FilterAlerts()
    {
        if (_stockAlerts == null)
        {
            _filteredAlerts = Enumerable.Empty<StockAlert>();
            return;
        }

        var filtered = _stockAlerts.AsEnumerable();

        if (_selectedAlertType != "All")
        {
            filtered = filtered.Where(a => a.AlertType == _selectedAlertType);
        }

        if (_selectedSeverity != "All")
        {
            filtered = filtered.Where(a => a.Severity == _selectedSeverity);
        }

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            filtered = filtered.Where(a => 
                a.ProductName.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                (a.SKU?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        _filteredAlerts = filtered.OrderByDescending(a => GetSeverityOrder(a.Severity))
                                 .ThenBy(a => a.AlertType)
                                 .ThenBy(a => a.ProductName);

        StateHasChanged();
    }

    private async Task RefreshAlerts()
    {
        await LoadAlerts();
        NotificationService.Notify(NotificationSeverity.Success, "Success", "Alerts refreshed");
    }

    private async Task CreateProduct()
    {
        var result = await DialogService.OpenAsync<ProductForm>("Add Product", new Dictionary<string, object>(), new DialogOptions() { Width = "600px", Height = "700px" });
        if (result == true)
        {
            await LoadAlerts();
            NotificationService.Notify(NotificationSeverity.Success, "Success", "Product created successfully");
        }
    }

    private async Task EditProduct(int productId)
    {
        var result = await DialogService.OpenAsync<ProductForm>("Edit Product", new Dictionary<string, object>() { { "Id", productId } }, new DialogOptions() { Width = "600px", Height = "700px" });
        if (result == true)
        {
            await LoadAlerts();
            NotificationService.Notify(NotificationSeverity.Success, "Success", $"Product {productId} updated successfully");
        }
    }

    private async Task CreatePurchaseOrder(int productId)
    {
        // Create purchase order for the product
        NotificationService.Notify(NotificationSeverity.Info, "Info", $"Create purchase order for product {productId} feature coming soon");
    }

    private BadgeStyle GetSeverityBadgeStyle(string severity) => severity switch
    {
        "Critical" => BadgeStyle.Danger,
        "Error" => BadgeStyle.Danger,
        "Warning" => BadgeStyle.Warning,
        "Info" => BadgeStyle.Info,
        _ => BadgeStyle.Light
    };

    private BadgeStyle GetAlertTypeBadgeStyle(string alertType) => alertType switch
    {
        "OutOfStock" => BadgeStyle.Danger,
        "LowStock" => BadgeStyle.Warning,
        "Expiring" => BadgeStyle.Info,
        _ => BadgeStyle.Light
    };

    private int GetSeverityOrder(string severity) => severity switch
    {
        "Critical" => 4,
        "Error" => 3,
        "Warning" => 2,
        "Info" => 1,
        _ => 0
    };
}