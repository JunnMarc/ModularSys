@using Microsoft.AspNetCore.Components.Web
@using ModularSys.Data.Common.Entities.Inventory
@using ModularSys.Inventory.Interface
@using ModularSys.Inventory.Models
@using System.ComponentModel.DataAnnotations
@using Radzen
@using Radzen.Blazor

@inject IProductService ProductService
@inject ICategoryService CategoryService
@inject Radzen.DialogService DialogService
@inject NotificationService NotificationService

<div style="width: 100%; max-height: 90vh; display: flex; flex-direction: column; background: white; border-radius: 12px; box-shadow: 0 4px 24px rgba(0, 0, 0, 0.12);">
    <!-- Header -->
    <div style="padding: 20px 24px; border-bottom: 1px solid #e5e7eb; flex-shrink: 0; background: white;">
        <div style="display: flex; align-items: center; gap: 12px;">
            <div style="width: 48px; height: 48px; border-radius: 12px; background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);">
                <RadzenIcon Icon="inventory_2" Style="color: white; font-size: 1.5rem;" />
            </div>
            <div>
                <h2 style="margin: 0; font-size: 1.5rem; font-weight: 600; color: #1f2937;">
                    @(Id.HasValue ? "Edit Product" : "New Product")
                </h2>
                <p style="margin: 4px 0 0 0; color: #6b7280; font-size: 0.875rem;">
                    @(Id.HasValue ? "Update product information and inventory details" : "Add a new product to your inventory")
                </p>
            </div>
        </div>
    </div>

    <!-- Form Content -->
    <div style="padding: 24px; flex: 1; background: white; overflow-y: auto; overflow-x: visible;">
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" 
                        Shade="Shade.Lighter"
                        Variant="Variant.Flat"
                        Style="margin-bottom: 20px; border-radius: 8px;">
                <RadzenIcon Icon="error_outline" Style="margin-right: 8px;" />
                @_errorMessage
            </RadzenAlert>
        }

        <RadzenStack Gap="1.5rem">
            <!-- Basic Information Section -->
            <div>
                <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
                    <RadzenIcon Icon="info" Style="color: #3b82f6;" />
                    <h3 style="margin: 0; font-size: 1rem; font-weight: 600; color: #374151;">Basic Information</h3>
                </div>
                
                <RadzenStack Gap="1rem">
                    <div style="display: flex; flex-direction: column; gap: 6px;">
                        <label style="font-size: 14px; font-weight: 500; color: #374151;">Product Name</label>
                        <RadzenTextBox @bind-Value="_model.Name" 
                                      Placeholder="Enter product name"
                                      class="rz-textbox"
                                      Style="width: 100%;" />
                    </div>

                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="6">
                            <div style="display: flex; flex-direction: column; gap: 6px;">
                                <label style="font-size: 14px; font-weight: 500; color: #374151;">SKU</label>
                                <RadzenTextBox @bind-Value="_model.SKU" 
                                              Placeholder="Stock Keeping Unit"
                                              class="rz-textbox"
                                              Style="width: 100%;" />
                            </div>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <div style="display: flex; flex-direction: column; gap: 6px;">
                                <label style="font-size: 14px; font-weight: 500; color: #374151;">Barcode</label>
                                <RadzenTextBox @bind-Value="_model.Barcode" 
                                              Placeholder="Product barcode"
                                              class="rz-textbox"
                                              Style="width: 100%;" />
                            </div>
                        </RadzenColumn>
                    </RadzenRow>

                    <div style="display: flex; flex-direction: column; gap: 6px;">
                        <label style="font-size: 14px; font-weight: 500; color: #374151;">Description</label>
                        <RadzenTextArea @bind-Value="_model.Description" 
                                       Placeholder="Detailed product description"
                                       Rows="3"
                                       class="rz-textarea"
                                       Style="width: 100%;" />
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 6px;">
                        <label style="font-size: 14px; font-weight: 500; color: #374151;">Category</label>
                        <RadzenDropDown Data="_categories" 
                                       @bind-Value="_model.CategoryId"
                                       TextProperty="CategoryName" 
                                       ValueProperty="CategoryId"
                                       Placeholder="Select a category..."
                                       class="rz-dropdown"
                                       Style="width: 100%;" />
                    </div>
                </RadzenStack>
            </div>

            <!-- Pricing Section -->
            <div>
                <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
                    <RadzenIcon Icon="attach_money" Style="color: #10b981;" />
                    <h3 style="margin: 0; font-size: 1rem; font-weight: 600; color: #374151;">Pricing</h3>
                </div>
                
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="6">
                        <div style="display: flex; flex-direction: column; gap: 6px;">
                            <label style="font-size: 14px; font-weight: 500; color: #374151;">Unit Price (Selling)</label>
                            <RadzenNumeric TValue="decimal" 
                                         @bind-Value="_model.UnitPrice"
                                         Format="C"
                                         ShowUpDown="false"
                                         class="rz-numeric"
                                         Style="width: 100%;" />
                        </div>
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <div style="display: flex; flex-direction: column; gap: 6px;">
                            <label style="font-size: 14px; font-weight: 500; color: #374151;">Cost Price (Purchase)</label>
                            <RadzenNumeric TValue="decimal?" 
                                         @bind-Value="_model.CostPrice"
                                         Format="C"
                                         ShowUpDown="false"
                                         class="rz-numeric"
                                         Style="width: 100%;" />
                        </div>
                    </RadzenColumn>
                </RadzenRow>
            </div>

            <!-- Inventory Section -->
            <div>
                <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
                    <RadzenIcon Icon="warehouse" Style="color: #f59e0b;" />
                    <h3 style="margin: 0; font-size: 1rem; font-weight: 600; color: #374151;">Inventory Levels</h3>
                </div>
                
                <RadzenStack Gap="1rem">
                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="6">
                            <div style="display: flex; flex-direction: column; gap: 6px;">
                                <label style="font-size: 14px; font-weight: 500; color: #374151;">Quantity On Hand</label>
                                <RadzenNumeric TValue="int" 
                                             @bind-Value="_model.QuantityOnHand"
                                             ShowUpDown="false"
                                             class="rz-numeric"
                                             Style="width: 100%;" />
                            </div>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <div style="display: flex; flex-direction: column; gap: 6px;">
                                <label style="font-size: 14px; font-weight: 500; color: #374151;">Reorder Level</label>
                                <RadzenNumeric TValue="int" 
                                             @bind-Value="_model.ReorderLevel"
                                             ShowUpDown="false"
                                             class="rz-numeric"
                                             Style="width: 100%;" />
                            </div>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="6">
                            <div style="display: flex; flex-direction: column; gap: 6px;">
                                <label style="font-size: 14px; font-weight: 500; color: #374151;">Min Stock Level</label>
                                <RadzenNumeric TValue="int?" 
                                             @bind-Value="_model.MinStockLevel"
                                             ShowUpDown="false"
                                             class="rz-numeric"
                                             Style="width: 100%;" />
                            </div>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <div style="display: flex; flex-direction: column; gap: 6px;">
                                <label style="font-size: 14px; font-weight: 500; color: #374151;">Max Stock Level</label>
                                <RadzenNumeric TValue="int?" 
                                             @bind-Value="_model.MaxStockLevel"
                                             ShowUpDown="false"
                                             class="rz-numeric"
                                             Style="width: 100%;" />
                            </div>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenStack>
            </div>

            <!-- Additional Details Section -->
            <div>
                <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
                    <RadzenIcon Icon="description" Style="color: #8b5cf6;" />
                    <h3 style="margin: 0; font-size: 1rem; font-weight: 600; color: #374151;">Additional Details</h3>
                </div>
                
                <RadzenStack Gap="1rem">
                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="6">
                            <div style="display: flex; flex-direction: column; gap: 6px;">
                                <label style="font-size: 14px; font-weight: 500; color: #374151;">Batch Number</label>
                                <RadzenTextBox @bind-Value="_model.BatchNumber" 
                                              Placeholder="Manufacturing batch"
                                              class="rz-textbox"
                                              Style="width: 100%;" />
                            </div>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <div style="display: flex; flex-direction: column; gap: 6px;">
                                <label style="font-size: 14px; font-weight: 500; color: #374151;">Supplier</label>
                                <RadzenTextBox @bind-Value="_model.Supplier" 
                                              Placeholder="Primary supplier"
                                              class="rz-textbox"
                                              Style="width: 100%;" />
                            </div>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12">
                            <div style="display: flex; flex-direction: column; gap: 6px;">
                                <label style="font-size: 14px; font-weight: 500; color: #374151;">Expiry Date (Optional)</label>
                                <RadzenDatePicker TValue="DateTime?" 
                                                 @bind-Value="_model.ExpiryDate"
                                                 DateFormat="MM/dd/yyyy"
                                                 ShowTime="false"
                                                 Placeholder="Click to select date"
                                                 Style="width: 100%;" />
                            </div>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenStack>
            </div>
        </RadzenStack>
    </div>

    <!-- Footer Actions -->
    <div style="padding: 16px 24px; border-top: 1px solid #e5e7eb; background: white; display: flex; justify-content: flex-end; gap: 12px; flex-shrink: 0;">
        <RadzenButton Text="Cancel" 
                     Icon="close"
                     ButtonStyle="ButtonStyle.Light" 
                     Click="Cancel"
                     Style="min-width: 100px;" />
        <RadzenButton Text="@(Id.HasValue ? "Update" : "Add Product")" 
                     Icon="@(Id.HasValue ? "save" : "add")"
                     ButtonStyle="ButtonStyle.Primary" 
                     Click="Save"
                     Style="min-width: 120px; background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); border: none;" />
    </div>
</div>

@code {
    private ProductInputModel _model = new();
    private List<Category> _categories = new();
    private string _errorMessage = "";

    [Parameter] public int? Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _categories = (await CategoryService.GetAllAsync()).ToList();

        if (Id is int id)
        {
            var existing = await ProductService.GetByIdAsync(id);
            if (existing is not null)
            {
                _model = new ProductInputModel
                {
                    ProductId = existing.ProductId,
                    Name = existing.Name,
                    CategoryId = existing.CategoryId,
                    UnitPrice = existing.UnitPrice,
                    QuantityOnHand = existing.QuantityOnHand,
                    ReorderLevel = existing.ReorderLevel,
                };
            }
        }
        else if (_categories.Count > 0)
        {
            _model.CategoryId = _categories[0].CategoryId;
        }
    }

    private async Task Save()
    {
        _errorMessage = "";

        bool? confirm = await DialogService.Confirm($"Are you sure you want to {(_model.ProductId == 0 ? "add" : "update")} '{_model.Name}'?",
            Id == null ? "Add Product" : "Update Product",
            new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "Cancel" });

        if (confirm != true) return;

        try
        {
            if (_model.ProductId == 0)
            {
                await ProductService.CreateAsync(_model);
                NotificationService.Notify(NotificationSeverity.Success, "Success", "Product created successfully.");
            }
            else
            {
                await ProductService.UpdateAsync(_model);
                NotificationService.Notify(NotificationSeverity.Success, "Success", "Product updated successfully.");
            }

            DialogService.Close(true);
        }
        catch (ValidationException ex)
        {
            // Instead of crashing, show the error in the UI
            _errorMessage = ex.Message;
        }
    }

    private void Cancel() => DialogService.Close(false);
}