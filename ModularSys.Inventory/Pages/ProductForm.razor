@using Microsoft.AspNetCore.Components.Web
@using ModularSys.Data.Common.Entities.Inventory
@using ModularSys.Inventory.Interface
@using ModularSys.Inventory.Models
@using System.ComponentModel.DataAnnotations

@inject IProductService ProductService
@inject ICategoryService CategoryService
@inject Radzen.DialogService DialogService
@inject NotificationService NotificationService

<RadzenCard>
    <RadzenStack Gap="1rem" Style="padding: 1rem;">
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Title="@_errorMessage" />
        }

        <RadzenStack Gap="0.75rem">
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="6">
                    <RadzenTextBox Value="_model.SKU" ValueChanged="@((string value) => _model.SKU = value)"
                                  Placeholder="SKU (Stock Keeping Unit)"
                                  Style="width: 100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenTextBox Value="_model.Barcode" ValueChanged="@((string value) => _model.Barcode = value)"
                                  Placeholder="Product barcode for scanning"
                                  Style="width: 100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenTextBox Value="_model.Name" ValueChanged="@((string value) => _model.Name = value)"
                          Placeholder="Product Name"
                          Style="width: 100%;" />

            <RadzenTextArea Value="_model.Description" ValueChanged="@((string value) => _model.Description = value)"
                          Placeholder="Detailed product description"
                          Rows="3"
                          Style="width: 100%;" />

            <RadzenDropDown Data="_categories" Value="_model.CategoryId" ValueChanged="@((int value) => _model.CategoryId = value)" 
                          TextProperty="CategoryName" ValueProperty="CategoryId"
                          Placeholder="Select a category..."
                          Style="width: 100%;" />

            <RadzenRow Gap="1rem">
                <RadzenColumn Size="6">
                    <RadzenNumeric TValue="decimal" Value="_model.UnitPrice" ValueChanged="@((decimal value) => _model.UnitPrice = value)"
                                 Placeholder="Unit Price (Selling)"
                                 Format="C"
                                 Style="width: 100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenNumeric TValue="decimal?" Value="_model.CostPrice" ValueChanged="@((decimal? value) => _model.CostPrice = value)"
                                 Placeholder="Cost Price (Purchase)"
                                 Format="C"
                                 Style="width: 100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="1rem">
                <RadzenColumn Size="4">
                    <RadzenNumeric TValue="int" Value="_model.QuantityOnHand" ValueChanged="@((int value) => _model.QuantityOnHand = value)"
                                 Placeholder="Quantity On Hand"
                                 Style="width: 100%;" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenNumeric TValue="int" Value="_model.ReorderLevel" ValueChanged="@((int value) => _model.ReorderLevel = value)"
                                 Placeholder="Reorder Level"
                                 Style="width: 100%;" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenNumeric TValue="int?" Value="_model.MinStockLevel" ValueChanged="@((int? value) => _model.MinStockLevel = value)"
                                 Placeholder="Min Stock Level"
                                 Style="width: 100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="1rem">
                <RadzenColumn Size="6">
                    <RadzenNumeric TValue="int?" Value="_model.MaxStockLevel" ValueChanged="@((int? value) => _model.MaxStockLevel = value)"
                                 Placeholder="Max Stock Level"
                                 Style="width: 100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenDatePicker Value="_model.ExpiryDate" ValueChanged="@((DateTime? value) => _model.ExpiryDate = value)"
                                    Placeholder="Product expiration date (if applicable)"
                                    Style="width: 100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="1rem">
                <RadzenColumn Size="6">
                    <RadzenTextBox Value="_model.BatchNumber" ValueChanged="@((string value) => _model.BatchNumber = value)"
                                  Placeholder="Manufacturing batch identifier"
                                  Style="width: 100%;" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenTextBox Value="_model.Supplier" ValueChanged="@((string value) => _model.Supplier = value)"
                                  Placeholder="Primary supplier name"
                                  Style="width: 100%;" />
                </RadzenColumn>
            </RadzenRow>
        </RadzenStack>
    </RadzenStack>
</RadzenCard>

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" Style="padding: 1rem;">
    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="Cancel" />
    <RadzenButton Text="@(Id.HasValue ? "Update Product" : "Add Product")" 
                  ButtonStyle="ButtonStyle.Primary" 
                  Click="Save" />
</RadzenStack>

@code {
    private ProductInputModel _model = new();
    private List<Category> _categories = new();
    private string _errorMessage = "";

    [Parameter] public int? Id { get; set; }
    [Parameter] public EventCallback<bool> OnResult { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _categories = (await CategoryService.GetAllAsync()).ToList();

        if (Id is int id)
        {
            var existing = await ProductService.GetByIdAsync(id);
            if (existing is not null)
            {
                _model = new ProductInputModel
                {
                    ProductId = existing.ProductId,
                    Name = existing.Name,
                    CategoryId = existing.CategoryId,
                    UnitPrice = existing.UnitPrice,
                    QuantityOnHand = existing.QuantityOnHand,
                    ReorderLevel = existing.ReorderLevel,
                };
            }
        }
        else if (_categories.Count > 0)
        {
            _model.CategoryId = _categories[0].CategoryId;
        }
    }

    private async Task Save()
    {
        _errorMessage = "";

        bool? confirm = await DialogService.Confirm($"Are you sure you want to {(_model.ProductId == 0 ? "add" : "update")} '{_model.Name}'?",
            Id == null ? "Add Product" : "Update Product",
            new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "Cancel" });

        if (confirm != true) return;

        try
        {
            if (_model.ProductId == 0)
            {
                await ProductService.CreateAsync(_model);
                NotificationService.Notify(NotificationSeverity.Success, "Success", "Product created successfully.");
            }
            else
            {
                await ProductService.UpdateAsync(_model);
                NotificationService.Notify(NotificationSeverity.Success, "Success", "Product updated successfully.");
            }

            await OnResult.InvokeAsync(true);
        }
        catch (ValidationException ex)
        {
            // Instead of crashing, show the error in the UI
            _errorMessage = ex.Message;
        }
    }

    private async Task Cancel() => await OnResult.InvokeAsync(false);
}