@using Radzen.Blazor
@using ModularSys.Core.Interfaces
@using ModularSys.Core.Models

@inject NavigationManager Nav
@inject IDashboardService DashboardService
@inject IUserService UserService
@inject NotificationService NotificationService

<RadzenPanel Style="padding: 16px;">
    <!-- Header -->
    <div class="header">
        <div class="header-content">
            <RadzenText Style="font-weight: bold; font-size: 1.75rem;" Class="gradient-text">Dashboard</RadzenText>
            <RadzenText Style="color: rgba(0,0,0,0.6);" Class="mt-1">Welcome back! Here's what's happening with your business today.</RadzenText>
        </div>
        <div class="header-actions">
            <RadzenButton Icon="refresh"
                          Variant="Variant.Text"
                          Click="RefreshAsync"
                          Title="Refresh Dashboard Data"
                          Class="refresh-btn" />
        </div>
        <div class="header-decoration">
            <div class="decoration-circle circle-1"></div>
            <div class="decoration-circle circle-2"></div>
            <div class="decoration-circle circle-3"></div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <RadzenGrid Columns="12" Gap="8" Class="mb-4">
        <RadzenGridColumn Size="12" SizeSM="6" SizeMD="3">
            <RadzenCard Class="stat-card revenue-card">
                <div style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
                    <RadzenIcon Icon="people" Class="stat-icon mb-2" />
                    <RadzenText Style="text-align: center;">Total Users</RadzenText>
                    <RadzenText Style="font-size: 1.25rem; text-align: center;">@(_dashboardStats?.TotalUsers ?? 0)</RadzenText>
                </div>
            </RadzenCard>
        </RadzenGridColumn>

        <RadzenGridColumn Size="12" SizeSM="6" SizeMD="3">
            <RadzenCard Class="stat-card orders-card">
                <div style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
                    <RadzenIcon Icon="groups" Class="stat-icon mb-2" />
                    <RadzenText Style="text-align: center;">Active Users</RadzenText>
                    <RadzenText Style="font-size: 1.25rem; text-align: center;">@(_dashboardStats?.ActiveUsersToday ?? 0)</RadzenText>
                </div>
            </RadzenCard>
        </RadzenGridColumn>

        <RadzenGridColumn Size="12" SizeSM="6" SizeMD="3">
            <RadzenCard Class="stat-card users-card">
                <div style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
                    <RadzenIcon Icon="business" Class="stat-icon mb-2" />
                    <RadzenText Style="text-align: center;">Departments</RadzenText>
                    <RadzenText Style="font-size: 1.25rem; text-align: center;">@(_dashboardStats?.TotalDepartments ?? 0)</RadzenText>
                </div>
            </RadzenCard>
        </RadzenGridColumn>

        <RadzenGridColumn Size="12" SizeSM="6" SizeMD="3">
            <RadzenCard Class="stat-card growth-card">
                <div style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
                    <RadzenIcon Icon="trending_up" Class="stat-icon mb-2" />
                    <RadzenText Style="text-align: center;">Growth Rate</RadzenText>
                    <RadzenText Style="font-size: 1.25rem; text-align: center;">@((_dashboardStats?.UserGrowthPercentage ?? 0) >= 0 ? "+" : "")@(_dashboardStats?.UserGrowthPercentage ?? 0)%</RadzenText>
                </div>
            </RadzenCard>
        </RadzenGridColumn>
    </RadzenGrid>

    <!-- System Health & Quick Actions Row -->
    <RadzenGrid Columns="12" Gap="8" Class="mb-4">
        <!-- System Health Card -->
        <RadzenGridColumn Size="12" SizeMD="6">
            <RadzenCard Class="chart-card" Elevation="0" Style="border-left: 4px solid #10b981;">
                <div class="chart-header">
                    <div class="chart-title-group">
                        <RadzenIcon Icon="health_and_safety" Class="chart-icon" />
                        <RadzenText Style="font-weight: 500;">System Health</RadzenText>
                    </div>
                    <RadzenBadge Text="✓ All Systems Operational" Style="font-weight: 600;" />
                </div>
                <div style="padding: 16px;">
                    <div style="display: flex; flex-direction: column; gap: 12px;">
                        <RadzenCard Elevation="0" Style="background: #f0fdf4; border-left: 3px solid #10b981; padding: 12px;">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <RadzenIcon Icon="storage" />
                                    <div>
                                        <RadzenText Style="font-weight: 600;">Database</RadzenText>
                                        <RadzenText Style="color: rgba(0,0,0,0.6);">Connected & Healthy</RadzenText>
                                    </div>
                                </div>
                                <RadzenBadge Text="Online" Style="font-weight: 600;" />
                            </div>
                        </RadzenCard>
                        <RadzenCard Elevation="0" Style="background: #eff6ff; border-left: 3px solid #3b82f6; padding: 12px;">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <RadzenIcon Icon="devices" />
                                    <div>
                                        <RadzenText Style="font-weight: 600;">Active Sessions</RadzenText>
                                        <RadzenText Style="color: rgba(0,0,0,0.6);">Current user sessions</RadzenText>
                                    </div>
                                </div>
                                <RadzenText Style="font-size: 1.25rem;">@(_dashboardStats?.ActiveUsersToday ?? 0)</RadzenText>
                            </div>
                        </RadzenCard>
                        <RadzenCard Elevation="0" Style="background: #fef3c7; border-left: 3px solid #f59e0b; padding: 12px;">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <RadzenIcon Icon="schedule" />
                                    <div>
                                        <RadzenText Style="font-weight: 600;">System Uptime</RadzenText>
                                        <RadzenText Style="color: rgba(0,0,0,0.6);">Since last restart</RadzenText>
                                    </div>
                                </div>
                                <RadzenText Style="font-size: 1.25rem;">99.9%</RadzenText>
                            </div>
                        </RadzenCard>
                    </div>
                </div>
            </RadzenCard>
        </RadzenGridColumn>

        <!-- Quick Actions Card -->
        <RadzenGridColumn Size="12" SizeMD="6">
            <RadzenCard Class="chart-card" Elevation="0" Style="border-left: 4px solid #6366f1;">
                <div class="chart-header">
                    <div class="chart-title-group">
                        <RadzenIcon Icon="bolt" Class="chart-icon" />
                        <RadzenText Style="font-weight: 500;">Quick Actions</RadzenText>
                    </div>
                </div>
                <div style="padding: 16px;">
                    <RadzenGrid Columns="12" Gap="8">
                        <RadzenGridColumn Size="6">
                            <RadzenButton Variant="Variant.Outlined"
                                          Icon="person_add"
                                          Click='@(() => Nav.NavigateTo("/users"))'
                                          Style="width: 100%;">
                                New User
                            </RadzenButton>
                        </RadzenGridColumn>
                        <RadzenGridColumn Size="6">
                            <RadzenButton Variant="Variant.Outlined"
                                          Icon="security"
                                          Click='@(() => Nav.NavigateTo("/permissions"))'
                                          Style="width: 100%;">
                                Permissions
                            </RadzenButton>
                        </RadzenGridColumn>
                        <RadzenGridColumn Size="6">
                            <RadzenButton Variant="Variant.Outlined"
                                          Icon="business"
                                          Click='@(() => Nav.NavigateTo("/departments"))'
                                          Style="width: 100%;">
                                Departments
                            </RadzenButton>
                        </RadzenGridColumn>
                        <RadzenGridColumn Size="6">
                            <RadzenButton Variant="Variant.Outlined"
                                          Icon="settings"
                                          Click='@(() => Nav.NavigateTo("/settings"))'
                                          Style="width: 100%;">
                                Settings
                            </RadzenButton>
                        </RadzenGridColumn>
                        <RadzenGridColumn Size="12">
                            <RadzenButton Variant="Variant.Filled"
                                          Icon="assessment"
                                          Click='@(() => Nav.NavigateTo("/reports"))'
                                          Style="width: 100%;">
                                View Reports
                            </RadzenButton>
                        </RadzenGridColumn>
                    </RadzenGrid>
                </div>
            </RadzenCard>
        </RadzenGridColumn>
    </RadzenGrid>

    <!-- Module Status Cards -->
    <div class="section-header">
        <div class="section-title">
            <RadzenIcon Icon="extension" Class="section-icon" />
            <RadzenText Style="font-weight: 500; font-size: 1.25rem;">Installed Modules</RadzenText>
        </div>
    </div>

    <RadzenGrid Columns="12" Gap="8" Class="mb-4">
        <RadzenGridColumn Size="12" SizeSM="6" SizeMD="4">
            <RadzenCard Class="module-card" Style="border-left: 4px solid #10b981;">
                <div style="padding: 12px;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <RadzenAvatar Style="background-color: #10b981;">
                                <RadzenIcon Icon="inventory" />
                            </RadzenAvatar>
                            <div>
                                <RadzenText Style="font-weight: 600;">Inventory</RadzenText>
                                <RadzenText Style="color: rgba(0,0,0,0.6);">v1.0.0</RadzenText>
                            </div>
                        </div>
                        <RadzenBadge Text="Active" Style="font-weight: 600;" />
                    </div>
                </div>
            </RadzenCard>
        </RadzenGridColumn>

        <RadzenGridColumn Size="12" SizeSM="6" SizeMD="4">
            <RadzenCard Class="module-card" Style="border-left: 4px solid #3b82f6;">
                <div style="padding: 12px;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <RadzenAvatar Style="background-color: #3b82f6;">
                                <RadzenIcon Icon="people" />
                            </RadzenAvatar>
                            <div>
                                <RadzenText Style="font-weight: 600;">User Management</RadzenText>
                                <RadzenText Style="color: rgba(0,0,0,0.6);">v1.0.0</RadzenText>
                            </div>
                        </div>
                        <RadzenBadge Text="Active" Style="font-weight: 600;" />
                    </div>
                </div>
            </RadzenCard>
        </RadzenGridColumn>

        <RadzenGridColumn Size="12" SizeSM="6" SizeMD="4">
            <RadzenCard Class="module-card" Style="border-left: 4px solid #94a3b8;">
                <div style="padding: 12px;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <RadzenAvatar Style="background-color: #94a3b8;">
                                <RadzenIcon Icon="account_balance" />
                            </RadzenAvatar>
                            <div>
                                <RadzenText Style="font-weight: 600;">Accounting</RadzenText>
                                <RadzenText Style="color: rgba(0,0,0,0.6);">Coming Soon</RadzenText>
                            </div>
                        </div>
                        <RadzenBadge Text="Planned" Style="font-weight: 600;" />
                    </div>
                </div>
            </RadzenCard>
        </RadzenGridColumn>
    </RadzenGrid>

    <!-- Charts Section -->
    <div class="section-header">
        <div class="section-title">
            <RadzenIcon Icon="analytics" Class="section-icon" />
            <RadzenText Style="font-weight: 500; font-size: 1.25rem;">Analytics Overview</RadzenText>
        </div>
        <div class="filter-container">
            <RadzenText Style="color: rgba(0,0,0,0.6);" Class="mr-2">Time Period:</RadzenText>
            <RadzenDropDown @bind-Value="_selectedSalesPeriod"
                           ValueChanged="OnSalesPeriodChanged"
                           Data="@(new[] { "7d", "30d", "90d" })"
                           Style="width: 150px;"
                           Class="period-filter" />
        </div>
    </div>

    <RadzenGrid Columns="12" Gap="8">
        <!-- User Growth Trend -->
        <RadzenGridColumn Size="12" SizeMD="8">
            <RadzenCard Class="chart-card user-growth-chart" Elevation="0">
                <div class="chart-header">
                    <div class="chart-title-group">
                        <RadzenIcon Icon="trending_up" Class="chart-icon" />
                        <RadzenText Style="font-weight: 500;">User Growth Over Time</RadzenText>
                    </div>
                    <div class="chart-badge">
                        <RadzenBadge Text="@($"📈 {(_dashboardStats?.UserGrowthPercentage ?? 0)}% Growth")" Style="font-weight: 600;" />
                    </div>
                </div>
                <div class="chart-content">
                    <!-- Placeholder for chart - RadzenChart can be used if available -->
                    <div style="height: 240px; display: flex; align-items: center; justify-content: center; background: #f8fafc; border-radius: 8px;">
                        <RadzenText>Chart Placeholder - User Growth Trend</RadzenText>
                    </div>
                </div>
            </RadzenCard>
        </RadzenGridColumn>

        <!-- Department Distribution -->
        <RadzenGridColumn Size="12" SizeMD="4">
            <RadzenCard Class="chart-card department-chart" Elevation="0">
                <div class="chart-header">
                    <div class="chart-title-group">
                        <RadzenIcon Icon="business" Class="chart-icon" />
                        <RadzenText Style="font-weight: 500;">Users by Department</RadzenText>
                    </div>
                </div>
                <div class="chart-content">
                    <!-- Placeholder for chart -->
                    <div style="height: 240px; display: flex; align-items: center; justify-content: center; background: #f8fafc; border-radius: 8px;">
                        <RadzenText>Chart Placeholder - Department Distribution</RadzenText>
                    </div>
                </div>
            </RadzenCard>
        </RadzenGridColumn>

        <!-- User Activity & System Health -->
        <RadzenGridColumn Size="12" SizeMD="6">
            <RadzenCard Class="chart-card activity-chart" Elevation="0">
                <div class="chart-header">
                    <div class="chart-title-group">
                        <RadzenIcon Icon="people" Class="chart-icon" />
                        <RadzenText Style="font-weight: 500;">User Status Overview</RadzenText>
                    </div>
                </div>
                <div class="chart-content">
                    <!-- Placeholder for chart -->
                    <div style="height: 240px; display: flex; align-items: center; justify-content: center; background: #f8fafc; border-radius: 8px;">
                        <RadzenText>Chart Placeholder - User Status Overview</RadzenText>
                    </div>
                </div>
            </RadzenCard>
        </RadzenGridColumn>

        <!-- Recent Activity Feed -->
        <RadzenGridColumn Size="12">
            <RadzenCard Class="chart-card activity-feed" Elevation="0">
                <div class="chart-header">
                    <div class="chart-title-group">
                        <RadzenIcon Icon="timeline" Class="chart-icon" />
                        <RadzenText Style="font-weight: 500;">Recent Activity</RadzenText>
                    </div>
                    <div class="chart-badge">
                        <RadzenBadge Text="🔄 Live Feed" Style="font-weight: 600;" />
                    </div>
                </div>
                <div class="chart-content">
                    @if (_recentActivities?.Any() == true)
                    {
                        <ul style="list-style: none; padding: 0; margin: 0;">
                            @foreach (var activity in _recentActivities.Take(8))
                            {
                                <li style="padding: 8px; border-bottom: 1px solid #e2e8f0;">
                                    <div class="activity-content">
                                        <div class="activity-icon-wrapper">
                                            <RadzenAvatar Size="Size.Small" Style="@($"background-color: {GetActivityColor(activity.Color)};")">
                                                <RadzenIcon Icon="@GetActivityIcon(activity.Icon)" Size="Size.Small" />
                                            </RadzenAvatar>
                                        </div>
                                        <div class="activity-info">
                                            <div class="activity-header">
                                                <RadzenText Class="activity-title">@activity.Activity</RadzenText>
                                                <RadzenText Style="color: rgba(0,0,0,0.5);" Class="activity-timestamp">
                                                    @activity.Timestamp.ToString("MMM dd, HH:mm")
                                                </RadzenText>
                                            </div>
                                            <RadzenText Style="color: rgba(0,0,0,0.6);" Class="activity-description">
                                                @activity.Description
                                            </RadzenText>
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="no-activity">
                            <RadzenIcon Icon="inbox" Size="Size.Large" />
                            <RadzenText Style="color: rgba(0,0,0,0.6);">No recent activity</RadzenText>
                        </div>
                    }
                </div>
            </RadzenCard>
        </RadzenGridColumn>
    </RadzenGrid>

</RadzenPanel>
