@page "/dashboard"
@using Radzen
@using Radzen.Blazor
@using ModularSys.Core.Interfaces
@using ModularSys.Core.Loader
@using ModularSys.Data.Common.Entities

@inject IAuthService AuthService
@inject IUserService UserService
@inject IRoleService RoleService
@inject NavigationManager Nav
@inject NotificationService NotificationService

<PageTitle>Dashboard - ModularSys</PageTitle>

@if (_loading)
{
    <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Style="min-height: 400px;">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
        <RadzenText Text="Loading dashboard..." Style="margin-top: 1rem;" />
    </RadzenStack>
}
else
{
    <div style="padding: 24px; background: #fafafa; min-height: 100vh;">
        <!-- Page Header -->
        <div style="margin-bottom: 24px;">
            <h1 style="margin: 0; font-size: 2rem; font-weight: 600; color: #212121;">Dashboard</h1>
            <p style="margin: 4px 0 0 0; color: #757575; font-size: 0.875rem;">Welcome back, @AuthService.CurrentUser. Here's what's happening today.</p>
        </div>

        <!-- KPI Cards -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-bottom: 24px;">
            <RadzenCard Style="padding: 20px; border-radius: 12px; border: 1px solid #e0e0e0; background: white;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <p style="margin: 0; color: #757575; font-size: 0.875rem; font-weight: 500;">Total Users</p>
                        <h2 style="margin: 8px 0 0 0; font-size: 2rem; font-weight: 600; color: #212121;">@_totalUsers</h2>
                        <p style="margin: 4px 0 0 0; font-size: 0.75rem; color: #4caf50;">+@_newUsersThisMonth this month</p>
                    </div>
                    <div style="width: 56px; height: 56px; border-radius: 12px; background: #e3f2fd; display: flex; align-items: center; justify-content: center;">
                        <RadzenIcon Icon="group" Style="font-size: 2rem; color: #2196f3;" />
                    </div>
                </div>
            </RadzenCard>

            <RadzenCard Style="padding: 20px; border-radius: 12px; border: 1px solid #e0e0e0; background: white;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <p style="margin: 0; color: #757575; font-size: 0.875rem; font-weight: 500;">Active Users</p>
                        <h2 style="margin: 8px 0 0 0; font-size: 2rem; font-weight: 600; color: #212121;">@_activeUsers</h2>
                        <p style="margin: 4px 0 0 0; font-size: 0.75rem; color: #4caf50;">@($"{(_totalUsers > 0 ? (_activeUsers * 100.0 / _totalUsers):0):F1}% active rate")</p>
                    </div>
                    <div style="width: 56px; height: 56px; border-radius: 12px; background: #e8f5e9; display: flex; align-items: center; justify-content: center;">
                        <RadzenIcon Icon="check_circle" Style="font-size: 2rem; color: #4caf50;" />
                    </div>
                </div>
            </RadzenCard>

            <RadzenCard Style="padding: 20px; border-radius: 12px; border: 1px solid #e0e0e0; background: white;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <p style="margin: 0; color: #757575; font-size: 0.875rem; font-weight: 500;">Total Roles</p>
                        <h2 style="margin: 8px 0 0 0; font-size: 2rem; font-weight: 600; color: #212121;">@_totalRoles</h2>
                        <p style="margin: 4px 0 0 0; font-size: 0.75rem; color: #757575;">Role-based access control</p>
                    </div>
                    <div style="width: 56px; height: 56px; border-radius: 12px; background: #fff3e0; display: flex; align-items: center; justify-content: center;">
                        <RadzenIcon Icon="admin_panel_settings" Style="font-size: 2rem; color: #ff9800;" />
                    </div>
                </div>
            </RadzenCard>

            <RadzenCard Style="padding: 20px; border-radius: 12px; border: 1px solid #e0e0e0; background: white;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <p style="margin: 0; color: #757575; font-size: 0.875rem; font-weight: 500;">Modules</p>
                        <h2 style="margin: 8px 0 0 0; font-size: 2rem; font-weight: 600; color: #212121;">@ModuleLoader.Subsystems.Count</h2>
                        <p style="margin: 4px 0 0 0; font-size: 0.75rem; color: #757575;">Active subsystems</p>
                    </div>
                    <div style="width: 56px; height: 56px; border-radius: 12px; background: #e8eaf6; display: flex; align-items: center; justify-content: center;">
                        <RadzenIcon Icon="extension" Style="font-size: 2rem; color: #3f51b5;" />
                    </div>
                </div>
            </RadzenCard>
        </div>

        <!-- Recent Activity & Quick Actions -->
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeLG="8">
                <RadzenCard Style="border: 1px solid #e5e7eb; border-radius: 8px; padding: 1.5rem;">
                    <RadzenStack Gap="1rem">
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                            <RadzenText Text="Recent Users" Style="font-size: 1.125rem; font-weight: 600; color: #111827;" />
                            <RadzenButton Text="View All" Icon="arrow_forward" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" 
                                        Style="border-radius: 6px;" Click="@(() => Nav.NavigateTo("/users"))" />
                        </RadzenStack>
                        
                        @if (_recentUsers.Any())
                        {
                            <RadzenDataGrid Data="@_recentUsers" TItem="User" AllowPaging="false" AllowSorting="true" Style="height: 300px;">
                                <Columns>
                                    <RadzenDataGridColumn TItem="User" Title="User" Width="200px">
                                        <Template Context="user">
                                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                                <RadzenGravatar Email="@user.Username" Style="width: 32px; height: 32px;" />
                                                <RadzenStack Gap="0">
                                                    <RadzenText Text="@user.Username" Style="font-weight: 600;" />
                                                    <RadzenText Text="@user.Email" Style="font-size: 0.75rem; color: var(--rz-text-secondary-color);" />
                                                </RadzenStack>
                                            </RadzenStack>
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="User" Property="Role.RoleName" Title="Role" Width="120px">
                                        <Template Context="user">
                                            <RadzenBadge Text="@user.Role?.RoleName" BadgeStyle="BadgeStyle.Info" />
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="User" Property="CreatedAt" Title="Joined" FormatString="{0:MMM dd, yyyy}" Width="120px" />
                                    <RadzenDataGridColumn TItem="User" Title="Status" Width="100px">
                                        <Template Context="user">
                                            <RadzenBadge Text="@(user.IsDeleted ? "Inactive" : "Active")" 
                                                       BadgeStyle="@(user.IsDeleted ? BadgeStyle.Danger : BadgeStyle.Success)" />
                                        </Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>
                        }
                        else
                        {
                            <RadzenStack AlignItems="AlignItems.Center" Gap="1rem" Style="padding: 2rem;">
                                <RadzenIcon Icon="people_outline" Style="font-size: 3rem; color: var(--rz-text-secondary-color);" />
                                <RadzenText Text="No users found" Style="color: var(--rz-text-secondary-color);" />
                            </RadzenStack>
                        }
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeLG="4">
                <RadzenCard Style="border: 1px solid #e5e7eb; border-radius: 8px; padding: 1.5rem;">
                    <RadzenStack Gap="1rem">
                        <RadzenText Text="Quick Actions" Style="font-size: 1.125rem; font-weight: 600; color: #111827;" />
                        
                        <RadzenStack Gap="0.75rem">
                            <RadzenButton Text="Add New User" Icon="person_add" Click="@(() => Nav.NavigateTo("/users"))" 
                                        Style="width: 100%; justify-content: flex-start;" ButtonStyle="ButtonStyle.Light" />
                            <RadzenButton Text="Manage Roles" Icon="admin_panel_settings" Click="@(() => Nav.NavigateTo("/roles"))" 
                                        Style="width: 100%; justify-content: flex-start;" ButtonStyle="ButtonStyle.Light" />
                            <RadzenButton Text="View Permissions" Icon="security" Click="@(() => Nav.NavigateTo("/permissions"))" 
                                        Style="width: 100%; justify-content: flex-start;" ButtonStyle="ButtonStyle.Light" />
                            <RadzenButton Text="System Settings" Icon="settings" Click="@(() => Nav.NavigateTo("/settings"))" 
                                        Style="width: 100%; justify-content: flex-start;" ButtonStyle="ButtonStyle.Light" />
                        </RadzenStack>

                        <RadzenText Text="System Status" Style="font-size: 1.125rem; font-weight: 600; color: #111827; margin-top: 1rem;" />
                        
                        <RadzenStack Gap="0.75rem">
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                                <RadzenText Text="Database" Style="font-size: 0.875rem; color: #6b7280;" />
                                <RadzenBadge Text="Connected" BadgeStyle="BadgeStyle.Success" Style="border-radius: 4px;" />
                            </RadzenStack>
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                                <RadzenText Text="Modules" Style="font-size: 0.875rem; color: #6b7280;" />
                                <RadzenBadge Text="@($"{ModuleLoader.Subsystems.Count} Active")" BadgeStyle="BadgeStyle.Info" Style="border-radius: 4px;" />
                            </RadzenStack>
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                                <RadzenText Text="Version" Style="font-size: 0.875rem; color: #6b7280;" />
                                <RadzenBadge Text="v1.0.0" BadgeStyle="BadgeStyle.Secondary" Style="border-radius: 4px;" />
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>

        <!-- Modules Overview -->
        @if (ModuleLoader.Subsystems.Any())
        {
            <RadzenCard Style="border: 1px solid #e5e7eb; border-radius: 8px; padding: 1.5rem;">
                <RadzenStack Gap="1rem">
                    <RadzenText Text="Available Modules" Style="font-size: 1.125rem; font-weight: 600; color: #111827;" />
                    
                    <RadzenRow Gap="1rem">
                        @foreach (var module in ModuleLoader.Subsystems.OrderBy(s => s.Order))
                        {
                            <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                                <RadzenCard Style="border: 1px solid #e5e7eb; border-radius: 8px; padding: 1rem; cursor: pointer; transition: all 0.2s ease;" 
                                          @onclick="@(() => Nav.NavigateTo(module.Route))"
                                          @onmouseover="@((MouseEventArgs e) => {})"
                                          class="module-card">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                                        <div style="width: 48px; height: 48px; border-radius: 8px; background: #f3f4f6; display: flex; align-items: center; justify-content: center;">
                                            <span class="material-icons" style="font-size: 1.75rem; color: #667eea;">@module.Icon</span>
                                        </div>
                                        <RadzenStack Gap="0">
                                            <RadzenText Text="@module.Name" Style="font-weight: 600; color: #111827; margin: 0;" />
                                            <RadzenText Text="Click to open" Style="font-size: 0.75rem; color: #6b7280;" />
                                        </RadzenStack>
                                    </RadzenStack>
                                </RadzenCard>
                            </RadzenColumn>
                        }
                    </RadzenRow>
                </RadzenStack>
            </RadzenCard>
        }
    </div>
}

@code {
    private bool _loading = true;
    private int _totalUsers = 0;
    private int _activeUsers = 0;
    private int _newUsersThisMonth = 0;
    private int _totalRoles = 0;
    private List<User> _recentUsers = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        try
        {
            _loading = true;

            // Load users
            var users = await UserService.GetAllAsync();
            _totalUsers = users.Count();
            _activeUsers = users.Count(u => !u.IsDeleted);
            
            var firstDayOfMonth = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
            _newUsersThisMonth = users.Count(u => u.CreatedAt >= firstDayOfMonth);
            
            // Get recent users (last 5)
            _recentUsers = users.OrderByDescending(u => u.CreatedAt).Take(5).ToList();

            // Load roles
            var roles = await RoleService.GetAllAsync();
            _totalRoles = roles.Count();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", $"Failed to load dashboard data: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }
}
