@page "/roles"
@using ModularSys.Core.Interfaces
@using ModularSys.Core.Security
@using ModularSys.Data.Common.Entities
@using ModularSys.Components.Dialogs
@using Radzen
@using Radzen.Blazor
@inject IRoleService RoleService
@inject IPermissionService PermissionService
@inject IRolePermissionService RolePermissionService
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject NavigationManager Nav

<div style="padding: 24px; background: #fafafa; min-height: 100vh;">
    <!-- Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <div>
            <h1 style="margin: 0; font-size: 2rem; font-weight: 600; color: #212121;">Role Management</h1>
            <p style="margin: 4px 0 0 0; color: #757575; font-size: 0.875rem;">Manage system roles and their permissions</p>
        </div>
        <RadzenButton Text="Create Role"
                      Icon="add"
                      ButtonStyle="ButtonStyle.Primary"
                      Click="@(() => CreateRole())"
                      Style="background: #1976d2; border-radius: 8px; border: none;" />
    </div>

    <!-- Stats Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
        <RadzenCard Style="padding: 20px; border-radius: 12px; border: 1px solid #e0e0e0; background: white;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <p style="margin: 0; color: #757575; font-size: 0.875rem; font-weight: 500;">Total Roles</p>
                    <h2 style="margin: 8px 0 0 0; font-size: 2rem; font-weight: 600; color: #212121;">@_roles.Count</h2>
                </div>
                <div style="width: 56px; height: 56px; border-radius: 12px; background: #e3f2fd; display: flex; align-items: center; justify-content: center;">
                    <RadzenIcon Icon="admin_panel_settings" Style="font-size: 2rem; color: #2196f3;" />
                </div>
            </div>
        </RadzenCard>
        
        <RadzenCard Style="padding: 20px; border-radius: 12px; border: 1px solid #e0e0e0; background: white;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <p style="margin: 0; color: #757575; font-size: 0.875rem; font-weight: 500;">Total Permissions</p>
                    <h2 style="margin: 8px 0 0 0; font-size: 2rem; font-weight: 600; color: #212121;">@_permissions.Count</h2>
                </div>
                <div style="width: 56px; height: 56px; border-radius: 12px; background: #fff3e0; display: flex; align-items: center; justify-content: center;">
                    <RadzenIcon Icon="lock" Style="font-size: 2rem; color: #ff9800;" />
                </div>
            </div>
        </RadzenCard>
        
        <RadzenCard Style="padding: 20px; border-radius: 12px; border: 1px solid #e0e0e0; background: white;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <p style="margin: 0; color: #757575; font-size: 0.875rem; font-weight: 500;">Templates</p>
                    <h2 style="margin: 8px 0 0 0; font-size: 2rem; font-weight: 600; color: #212121;">@PermissionConstants.RoleTemplates.Count</h2>
                </div>
                <div style="width: 56px; height: 56px; border-radius: 12px; background: #f3e5f5; display: flex; align-items: center; justify-content: center;">
                    <RadzenIcon Icon="assignment" Style="font-size: 2rem; color: #9c27b0;" />
                </div>
            </div>
        </RadzenCard>
    </div>

    @if (_loading)
    {
        <div style="display: flex; justify-content: center; padding: 40px;">
            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
        </div>
    }
    else
    {
        <!-- Roles Table -->
        <RadzenCard Style="padding: 0; border-radius: 12px; border: 1px solid #e0e0e0; overflow: hidden; background: white;">
            <div style="padding: 20px; border-bottom: 1px solid #e0e0e0; background: #fafafa; border-radius: 12px 12px 0 0;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <h3 style="margin: 0; font-size: 1.125rem; font-weight: 600; color: #212121;">System Roles</h3>
                    <RadzenTextBox @bind-Value="_searchTerm"
                                  Placeholder="Search roles..."
                                  Style="width: 300px; border-radius: 6px;" />
                </div>
            </div>
            
            <RadzenDataGrid Data="@FilteredRoles" 
                           TItem="Role" 
                           AllowPaging="true" 
                           PageSize="10"
                           AllowSorting="true"
                           GridLines="DataGridGridLines.None"
                           Style="border: none; background: white;">
                <Columns>
                    <RadzenDataGridColumn TItem="Role" Property="RoleName" Title="Role Name" Sortable="true">
                        <Template Context="role">
                            <div style="display: flex; align-items: center; gap: 12px; padding: 8px 0;">
                                <div style="width: 40px; height: 40px; border-radius: 50%; background: #e3f2fd; display: flex; align-items: center; justify-content: center;">
                                    <RadzenIcon Icon="admin_panel_settings" Style="color: #2196f3;" />
                                </div>
                                <div>
                                    <div style="font-weight: 500; color: #212121;">@role.RoleName</div>
                                    <div style="font-size: 0.875rem; color: #757575;">@(role.Description ?? "No description")</div>
                                </div>
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                    
                    <RadzenDataGridColumn TItem="Role" Title="Permissions" Width="150px">
                        <Template Context="role">
                            <RadzenBadge Text="@GetRolePermissionCount(role.RoleId).ToString()" 
                                        Style="background: #e3f2fd; color: #1976d2; padding: 6px 12px; border-radius: 6px; font-weight: 500;" 
                                        BadgeStyle="BadgeStyle.Light" />
                        </Template>
                    </RadzenDataGridColumn>
                    
                    <RadzenDataGridColumn TItem="Role" Property="CreatedAt" Title="Created" FormatString="{0:MMM dd, yyyy}" Width="150px" Sortable="true" />
                    
                    <RadzenDataGridColumn TItem="Role" Title="Actions" Width="150px" Sortable="false">
                        <Template Context="role">
                            <div style="display: flex; gap: 8px;">
                                <RadzenButton Text="Edit" 
                                             Variant="Variant.Text" 
                                             Size="ButtonSize.Small" 
                                             Click="@(() => EditRole(role))"
                                             Style="color: #1976d2; padding: 6px 16px; border-radius: 6px;" />
                                <RadzenButton Text="Delete" 
                                             Variant="Variant.Text" 
                                             Size="ButtonSize.Small" 
                                             Click="@(() => DeleteRole(role))"
                                             Style="color: #d32f2f; padding: 6px 16px; border-radius: 6px;" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
    }
</div>

@code {
    private List<Role> _roles = new();
    private List<Permission> _permissions = new();
    private Dictionary<int, int> _rolePermissionCounts = new();
    private Dictionary<int, int> _roleUserCounts = new();
    private bool _loading = true;
    private string _searchTerm = string.Empty;

    private List<Role> FilteredRoles =>
        string.IsNullOrWhiteSpace(_searchTerm)
            ? _roles
            : _roles.Where(r => r.RoleName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase))
                   .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            _loading = true;
            
            _roles = await RoleService.GetAllAsync();
            _permissions = await PermissionService.GetAllAsync();
            
            // Load permission counts for each role
            foreach (var role in _roles)
            {
                var permissions = await RolePermissionService.GetPermissionsForRoleAsync(role.RoleId);
                _rolePermissionCounts[role.RoleId] = permissions.Count;
                
                // TODO: Get actual user count from UserService
                _roleUserCounts[role.RoleId] = 0; // Placeholder
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", $"Error loading roles: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private int GetRolePermissionCount(int roleId) =>
        _rolePermissionCounts.GetValueOrDefault(roleId, 0);

    private int GetRoleUserCount(int roleId) =>
        _roleUserCounts.GetValueOrDefault(roleId, 0);

    private async Task CreateRole()
    {
        var result = await DialogService.OpenAsync<RoleDialog>("Create New Role", null, 
            new DialogOptions() { Width = "600px", Height = "auto", Resizable = true, Draggable = true });

        if (result == true)
        {
            await LoadData();
            StateHasChanged();
        }
    }

    private async Task EditRole(Role role)
    {
        var parameters = new Dictionary<string, object> { { "ExistingRole", role } };
        var result = await DialogService.OpenAsync<RoleDialog>($"Edit Role: {role.RoleName}", parameters, 
            new DialogOptions() { Width = "600px", Height = "auto", Resizable = true, Draggable = true });

        if (result == true)
        {
            await LoadData();
            StateHasChanged();
        }
    }

    private async Task DeleteRole(Role role)
    {
        try
        {
            var confirmed = await DialogService.Confirm($"Are you sure you want to delete the role '{role.RoleName}'?", "Delete Role", new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });
            
            if (confirmed == true)
            {
                await RoleService.DeleteAsync(role.RoleId);
                NotificationService.Notify(NotificationSeverity.Success, "Success", $"Role '{role.RoleName}' deleted successfully");
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", $"Failed to delete role: {ex.Message}");
        }
    }
}
