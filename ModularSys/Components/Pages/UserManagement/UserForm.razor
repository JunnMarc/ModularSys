@page "/users/create"
@page "/users/edit/{Id:int}"
@using System.ComponentModel.DataAnnotations
@using System.Linq
@using ModularSys.Core.Interfaces
@using ModularSys.Core.Models
@using ModularSys.Data.Common.Entities
@using Radzen
@using Radzen.Blazor

@inject IUserService UserService
@inject IRoleService RoleService
@inject IDepartmentService DepartmentService
@inject NotificationService NotificationService
@inject NavigationManager Nav

<div style="padding: 24px; background: #fafafa; min-height: 100vh;">
    <div style="max-width: 800px; margin: 0 auto;">
        <RadzenCard Style="padding: 24px; border-radius: 12px; border: 1px solid #e0e0e0; background: white;">
            <!-- Header -->
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
                <RadzenButton Icon="arrow_back" 
                             Click="@(() => Nav.NavigateTo("/users"))" 
                             Variant="Variant.Text" 
                             Style="border-radius: 50%; width: 40px; height: 40px; min-width: 40px; padding: 0;" />
                <div>
                    <h1 style="margin: 0; font-size: 1.5rem; font-weight: 600; color: #212121;">
                        @(_model.IsEditMode ? "Edit User" : "Create New User")
                    </h1>
                    <p style="margin: 4px 0 0 0; color: #757575; font-size: 0.875rem;">
                        @(_model.IsEditMode ? "Update user information and permissions" : "Add a new user to the system")
                    </p>
                </div>
            </div>

            @if (_loading)
            {
                <div style="display: flex; justify-content: center; padding: 40px;">
                    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
                </div>
            }
        else
        {
            <EditForm Model="_model" OnValidSubmit="SaveUser">
                <DataAnnotationsValidator />
                
                <!-- Basic Information -->
                <h3 style="margin: 0 0 8px 0; font-size: 1.125rem; font-weight: 600; color: #212121;">Basic Information</h3>
                <hr style="margin: 0 0 24px 0; border: none; border-top: 1px solid #e0e0e0;" />
                
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px;">
                    <div>
                        <label style="display: block; margin-bottom: 8px; color: #757575; font-size: 0.875rem; font-weight: 500;">First Name *</label>
                        <RadzenTextBox @bind-Value="_model.FirstName"
                                      Placeholder="First Name"
                                      Style="width: 100%; border-radius: 6px;" />
                        <ValidationMessage For="@(() => _model.FirstName)" />
                    </div>

                    <div>
                        <label style="display: block; margin-bottom: 8px; color: #757575; font-size: 0.875rem; font-weight: 500;">Last Name *</label>
                        <RadzenTextBox @bind-Value="_model.LastName"
                                      Placeholder="Last Name"
                                      Style="width: 100%; border-radius: 6px;" />
                        <ValidationMessage For="@(() => _model.LastName)" />
                    </div>

                    <div>
                        <label style="display: block; margin-bottom: 8px; color: #757575; font-size: 0.875rem; font-weight: 500;">Username *</label>
                        <RadzenTextBox @bind-Value="_model.Username"
                                      Placeholder="Username"
                                      Style="width: 100%; border-radius: 6px;" />
                        <ValidationMessage For="@(() => _model.Username)" />
                    </div>

                    <div>
                        <label style="display: block; margin-bottom: 8px; color: #757575; font-size: 0.875rem; font-weight: 500;">Email Address *</label>
                        <RadzenTextBox @bind-Value="_model.Email"
                                      Placeholder="Email"
                                      Style="width: 100%; border-radius: 6px;" />
                        <ValidationMessage For="@(() => _model.Email)" />
                    </div>

                    <div>
                        <label style="display: block; margin-bottom: 8px; color: #757575; font-size: 0.875rem; font-weight: 500;">Contact Number</label>
                        <RadzenTextBox @bind-Value="_model.ContactNumber"
                                      Placeholder="Contact Number"
                                      Style="width: 100%; border-radius: 6px;" />
                        <ValidationMessage For="@(() => _model.ContactNumber)" />
                    </div>
                </div>

                <!-- Password Section (only for create) -->
                @if (!_model.IsEditMode)
                {
                    <h3 style="margin: 24px 0 8px 0; font-size: 1.125rem; font-weight: 600; color: #212121;">Password Setup</h3>
                    <hr style="margin: 0 0 24px 0; border: none; border-top: 1px solid #e0e0e0;" />
                    
                    <!-- Info Box -->
                    <div style="padding: 12px 16px; margin-bottom: 16px; background: #e3f2fd; border-left: 4px solid #2196f3; border-radius: 4px;">
                        <p style="margin: 0; color: #1565c0; font-size: 0.875rem;">
                            <strong>Password Options:</strong> Use a temporary password (less than 12 characters) for quick setup, or a permanent password (12+ characters). Users with temporary passwords must change them on first login.
                        </p>
                    </div>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px;">
                        <div>
                            <label style="display: block; margin-bottom: 8px; color: #757575; font-size: 0.875rem; font-weight: 500;">Password *</label>
                            <div style="display: flex; gap: 8px;">
                                <RadzenPassword @bind-Value="_model.Password"
                                              Placeholder="Enter password"
                                              Style="width: 100%; border-radius: 6px;" />
                                <RadzenButton Icon="refresh" 
                                             Click="GenerateTemporaryPassword"
                                             Variant="Variant.Text"
                                             Style="border-radius: 50%; width: 40px; height: 40px; min-width: 40px; padding: 0;"
                                             Title="Generate temporary password" />
                            </div>
                            <ValidationMessage For="@(() => _model.Password)" />
                            @if (_model.IsTemporaryPassword)
                            {
                                <p style="margin: 8px 0 0 0; color: #f57c00; font-size: 0.8rem;">
                                    ⚠️ Temporary password (less than 12 characters) - user must change on first login
                                </p>
                            }
                        </div>

                        <div>
                            <label style="display: block; margin-bottom: 8px; color: #757575; font-size: 0.875rem; font-weight: 500;">Confirm Password *</label>
                            <RadzenPassword @bind-Value="_model.ConfirmPassword"
                                          Placeholder="Confirm password"
                                          Style="width: 100%; border-radius: 6px;" />
                            <ValidationMessage For="@(() => _model.ConfirmPassword)" />
                        </div>
                    </div>
                }

                <!-- Role and Department -->
                <h3 style="margin: 24px 0 8px 0; font-size: 1.125rem; font-weight: 600; color: #212121;">Permissions & Access</h3>
                <hr style="margin: 0 0 24px 0; border: none; border-top: 1px solid #e0e0e0;" />
                
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px;">
                    <div>
                        <label style="display: block; margin-bottom: 8px; color: #757575; font-size: 0.875rem; font-weight: 500;">Role *</label>
                        <RadzenDropDown @bind-Value="_model.RoleId"
                                       Data="@_roles"
                                       TextProperty="RoleName"
                                       ValueProperty="RoleId"
                                       Placeholder="Select Role"
                                       Style="width: 100%; border-radius: 6px;" />
                        <ValidationMessage For="@(() => _model.RoleId)" />
                    </div>

                    <div>
                        <label style="display: block; margin-bottom: 8px; color: #757575; font-size: 0.875rem; font-weight: 500;">Department *</label>
                        <RadzenDropDown @bind-Value="_model.DepartmentId"
                                       Data="@_departments"
                                       TextProperty="DepartmentName"
                                       ValueProperty="DepartmentId"
                                       Placeholder="Select Department"
                                       Style="width: 100%; border-radius: 6px;" />
                        <ValidationMessage For="@(() => _model.DepartmentId)" />
                    </div>
                </div>

                <!-- Actions -->
                <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px;">
                    <RadzenButton Text="Cancel" 
                                 Variant="Variant.Text" 
                                 Click="@(() => Nav.NavigateTo("/users"))"
                                 Style="border-radius: 6px;" />
                    <RadzenButton Text="@(_model.IsEditMode ? "Update User" : "Create User")" 
                                 ButtonType="ButtonType.Submit" 
                                 ButtonStyle="ButtonStyle.Primary"
                                 Icon="save"
                                 Disabled="_saving"
                                 Style="background: #1976d2; border-radius: 6px; border: none;" />
                </div>
            </EditForm>
        }
        </RadzenCard>
    </div>
</div>

@code {
    [Parameter] public int? Id { get; set; }

    private UserInputModel _model = new();
    private List<Role>? _roles;
    private List<Department>? _departments;
    private bool _loading = true;
    private bool _saving = false;
    private bool _showPassword = false;
    private bool _showPasswordFields = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadLookupData();
        
        if (Id.HasValue)
        {
            await LoadUser(Id.Value);
        }
        
        _loading = false;
    }

    private async Task LoadLookupData()
    {
        _roles = await RoleService.GetAllAsync();
        _departments = await DepartmentService.GetAllAsync();
    }

    private async Task LoadUser(int id)
    {
        var user = await UserService.GetByIdAsync(id);
        if (user != null)
        {
            _model = new UserInputModel
            {
                Id = user.Id,
                Username = user.Username,
                FirstName = user.FirstName,
                LastName = user.LastName,
                Email = user.Email,
                ContactNumber = user.ContactNumber,
                RoleId = user.RoleId,
                DepartmentId = user.DepartmentId
            };
        }
        else
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", "User not found");
            Nav.NavigateTo("/users");
        }
    }

    private async Task SaveUser()
    {
        _saving = true;
        try
        {
            if (_model.IsEditMode)
            {
                var user = await UserService.GetByIdAsync(_model.Id);
                if (user != null)
                {
                    user.Username = _model.Username;
                    user.FirstName = _model.FirstName;
                    user.LastName = _model.LastName;
                    user.Email = _model.Email;
                    user.ContactNumber = _model.ContactNumber;
                    user.RoleId = _model.RoleId;
                    user.DepartmentId = _model.DepartmentId;

                    var success = await UserService.UpdateAsync(user);
                    if (success)
                    {
                        NotificationService.Notify(NotificationSeverity.Success, "Success", "User updated successfully");
                        Nav.NavigateTo("/users");
                    }
                    else
                    {
                        NotificationService.Notify(NotificationSeverity.Error, "Error", "Failed to update user");
                    }
                }
            }
            else
            {
                // Validate password before creating user
                if (string.IsNullOrWhiteSpace(_model.Password))
                {
                    NotificationService.Notify(NotificationSeverity.Error, "Validation Error", "Password is required");
                    return;
                }

                if (_model.Password.Length < 1)
                {
                    NotificationService.Notify(NotificationSeverity.Error, "Validation Error", "Password cannot be empty");
                    return;
                }

                if (_model.Password != _model.ConfirmPassword)
                {
                    NotificationService.Notify(NotificationSeverity.Error, "Validation Error", "Passwords do not match");
                    return;
                }

                // Show warning if temporary password is used
                if (_model.IsTemporaryPassword)
                {
                    NotificationService.Notify(NotificationSeverity.Warning, "Temporary Password", 
                        $"User created with temporary password ({_model.Password.Length} characters). They must change it on first login.");
                }

                var user = new User
                {
                    Username = _model.Username,
                    FirstName = _model.FirstName,
                    LastName = _model.LastName,
                    Email = _model.Email,
                    ContactNumber = _model.ContactNumber,
                    RoleId = _model.RoleId,
                    DepartmentId = _model.DepartmentId
                };

                await UserService.CreateAsync(user, _model.Password!);
                NotificationService.Notify(NotificationSeverity.Success, "Success", "User created successfully");
                Nav.NavigateTo("/users");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", $"Error: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    private void GenerateTemporaryPassword()
    {
        // Generate a random 8-character temporary password
        const string chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%";
        var random = new Random();
        var tempPassword = new string(Enumerable.Range(0, 8)
            .Select(_ => chars[random.Next(chars.Length)])
            .ToArray());
        
        _model.Password = tempPassword;
        _model.ConfirmPassword = tempPassword;
        
        NotificationService.Notify(NotificationSeverity.Info, "Generated", 
            $"Temporary password generated: {tempPassword} (8 characters)");
    }
}
