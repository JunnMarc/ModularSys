@page "/permissions"
@using Microsoft.Maui.Layouts
@using ModularSys.Core.Services
@using ModularSys.Data.Common.Entities
@using Radzen.Blazor
@using Radzen
@inject RoleService RoleService
@inject PermissionService PermissionService
@inject RolePermissionService RolePermissionService
@inject NotificationService NotificationService
@inject AuthService AuthService

<RadzenPanel Style="padding: 16px;">
    <!-- Enhanced Header -->
    <RadzenCard Style="padding: 16px; margin-bottom: 16px; background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); border-radius: 12px;">
        <div style="display: flex; flex-direction: column; gap: 12px;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div style="display: flex; flex-direction: column; gap: 4px;">
                    <RadzenText Style="font-weight: bold; font-size: 1.5rem; color: white;">
                        <RadzenIcon Icon="security" Style="margin-right: 8px;" />
                        Permission Matrix
                    </RadzenText>
                    <RadzenText Style="color: rgba(255,255,255,0.9);">
                        Manage role-permission assignments with real-time updates
                    </RadzenText>
                </div>
                <RadzenBadge Text="@($"{FilteredRoles.Count} roles • {FilteredPermissions.Count} permissions")" Style="font-weight: 600;" />
            </div>
            
            <!-- Quick Stats -->
            <RadzenGrid Columns="12" Gap="8px">
                <RadzenGridColumn Size="3">
                    <RadzenCard Style="padding: 12px; background: rgba(255,255,255,0.15); backdrop-filter: blur(10px); border-radius: 8px;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <RadzenAvatar Icon="group" Style="background-color: rgba(255,255,255,0.2);" />
                            <div style="display: flex; flex-direction: column; gap: 0;">
                                <RadzenText Style="font-size: 1.25rem; color: white;">@roles.Count</RadzenText>
                                <RadzenText Style="font-size: 0.75rem; color: rgba(255,255,255,0.8);">Total Roles</RadzenText>
                            </div>
                        </div>
                    </RadzenCard>
                </RadzenGridColumn>
                <RadzenGridColumn Size="3">
                    <RadzenCard Style="padding: 12px; background: rgba(255,255,255,0.15); backdrop-filter: blur(10px); border-radius: 8px;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <RadzenAvatar Icon="lock" Style="background-color: rgba(255,255,255,0.2);" />
                            <div style="display: flex; flex-direction: column; gap: 0;">
                                <RadzenText Style="font-size: 1.25rem; color: white;">@permissions.Count</RadzenText>
                                <RadzenText Style="font-size: 0.75rem; color: rgba(255,255,255,0.8);">Permissions</RadzenText>
                            </div>
                        </div>
                    </RadzenCard>
                </RadzenGridColumn>
                <RadzenGridColumn Size="3">
                    <RadzenCard Style="padding: 12px; background: rgba(255,255,255,0.15); backdrop-filter: blur(10px); border-radius: 8px;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <RadzenAvatar Icon="check_circle" Style="background-color: rgba(255,255,255,0.2);" />
                            <div style="display: flex; flex-direction: column; gap: 0;">
                                <RadzenText Style="font-size: 1.25rem; color: white;">@GetActiveAssignmentsCount()</RadzenText>
                                <RadzenText Style="font-size: 0.75rem; color: rgba(255,255,255,0.8);">Active</RadzenText>
                            </div>
                        </div>
                    </RadzenCard>
                </RadzenGridColumn>
                <RadzenGridColumn Size="3">
                    <RadzenCard Style="padding: 12px; background: rgba(255,255,255,0.15); backdrop-filter: blur(10px); border-radius: 8px;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <RadzenAvatar Icon="percent" Style="background-color: rgba(255,255,255,0.2);" />
                            <div style="display: flex; flex-direction: column; gap: 0;">
                                <RadzenText Style="font-size: 1.25rem; color: white;">@GetCoveragePercentage()%</RadzenText>
                                <RadzenText Style="font-size: 0.75rem; color: rgba(255,255,255,0.8);">Coverage</RadzenText>
                            </div>
                        </div>
                    </RadzenCard>
                </RadzenGridColumn>
            </RadzenGrid>
        </div>
    </RadzenCard>
    
    <!-- Filters Section -->
    <RadzenCard Style="padding: 16px; margin-bottom: 16px; border-radius: 12px;">
        <div style="display: flex; flex-direction: column; gap: 12px;">

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <RadzenText Style="font-size: 1.125rem;">
                <RadzenIcon Icon="filter_list" Style="margin-right: 8px; color: #3b82f6;" />
                Filters & Search
            </RadzenText>
            <div style="display: flex; gap: 8px;">
                <RadzenButton Variant="Variant.Text" 
                              Icon="done_all"
                              Click="GrantAllVisible"
                              Disabled="@isBusy"
                              ButtonStyle="ButtonStyle.Success"
                              Size="ButtonSize.Small">
                    Grant All Visible
                </RadzenButton>
                <RadzenButton Variant="Variant.Text" 
                              Icon="block"
                              Click="RevokeAllVisible"
                              Disabled="@isBusy"
                              ButtonStyle="ButtonStyle.Danger"
                              Size="ButtonSize.Small">
                    Revoke All Visible
                </RadzenButton>
            </div>
        </div>
        
        <RadzenGrid Columns="12" Gap="8px">
            <RadzenGridColumn Size="12" SizeSM="4">
                <RadzenTextBox @bind-Value="roleFilter" 
                              Placeholder="Filter roles" 
                              Style="width: 100%;"
                              Icon="manage_accounts"
                              Change="@(async (args) => await Task.Delay(200))"
                              ClearButton="true" />
            </RadzenGridColumn>
            <RadzenGridColumn Size="12" SizeSM="4">
                <RadzenTextBox @bind-Value="permissionFilter" 
                              Placeholder="Filter permissions" 
                              Style="width: 100%;"
                              Icon="lock"
                              Change="@(async (args) => await Task.Delay(200))"
                              ClearButton="true" />
            </RadzenGridColumn>
            <RadzenGridColumn Size="12" SizeSM="4" Style="display: flex; align-items: center; gap: 8px;">
                <RadzenButton Variant="Variant.Outlined" 
                              Click="ClearFilters"
                              Icon="clear"
                              Disabled="@(string.IsNullOrWhiteSpace(roleFilter) && string.IsNullOrWhiteSpace(permissionFilter))">
                    Clear Filters
                </RadzenButton>
                <RadzenButton ButtonStyle="ButtonStyle.Primary"
                              Icon="refresh"
                              Click="RefreshMatrix"
                              Disabled="@isLoading">
                    Refresh
                </RadzenButton>
            </RadzenGridColumn>
        </RadzenGrid>
        </div>
    </RadzenCard>
    
    <!-- Matrix Section -->
    <RadzenCard Style="padding: 16px; border-radius: 12px;">
        <div style="display: flex; flex-direction: column; gap: 8px;">

        @if (isLoading)
        {
            <div style="display: flex; align-items: center; justify-content: center; padding: 64px;">
                <RadzenProgressBarCircular Style="color: #3b82f6;" />
            </div>
        }
        else if (!roles.Any() || !permissions.Any())
        {
            <RadzenAlert Severity="Severity.Info" Variant="Variant.Outlined">
                No roles or permissions found. Add some to get started.
            </RadzenAlert>
        }
        else
        {
            <div style="overflow: auto;">
                <table style="border-collapse: collapse; border-radius: 8px; overflow: hidden;">
                    <thead>
                        <tr style="background: #f8fafc;">
                            <th style="position: sticky; left: 0; background: #f8fafc; font-weight: 600; padding: 8px;">
                                <div style="display: flex; gap: 4px; align-items: center;">
                                    <RadzenIcon Icon="group" Size="Size.Small" Style="color: #3b82f6;" />
                                    <RadzenText Style="font-weight: bold;">Role</RadzenText>
                                </div>
                            </th>
                            @foreach (var perm in FilteredPermissions)
                            {
                                <th style="position: sticky; top: 0; background: #f8fafc; min-width: 120px; padding: 8px;">
                                    <div style="display: flex; flex-direction: column; gap: 4px; align-items: center;">
                                        <div style="display: flex; align-items: center; gap: 4px;" title="@perm.Description">
                                            <RadzenIcon Icon="@GetPermissionIcon(perm.PermissionName)" Size="Size.Small" />
                                            <RadzenText Style="font-size: 0.75rem; font-weight: 600; writing-mode: vertical-rl; text-orientation: mixed; white-space: nowrap;">
                                                @GetShortPermissionName(perm.PermissionName)
                                            </RadzenText>
                                        </div>
                                        <div style="display: flex; gap: 4px; justify-content: center;">
                                            <RadzenButton Icon="done_all"
                                                          Size="ButtonSize.Small"
                                                          Disabled="@isBusy"
                                                          ButtonStyle="ButtonStyle.Success"
                                                          Title="Grant all for this permission"
                                                          Click="@(() => SetPermissionForAllRoles(perm.PermissionId, true))" />
                                            <RadzenButton Icon="block"
                                                          Size="ButtonSize.Small"
                                                          Disabled="@isBusy"
                                                          ButtonStyle="ButtonStyle.Danger"
                                                          Title="Revoke all for this permission"
                                                          Click="@(() => SetPermissionForAllRoles(perm.PermissionId, false))" />
                                        </div>
                                    </div>
                                </th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var role in FilteredRoles)
                        {
                            <tr style="border-bottom: 1px solid #e2e8f0;">
                                <td style="position: sticky; left: 0; background: #f8fafc; min-width: 200px; padding: 8px;">
                                    <div style="display: flex; gap: 8px; align-items: center;">
                                        <RadzenAvatar Style="@($"background-color: {GetRoleColor(role.RoleName)};")" Size="Size.Small">
                                            <RadzenIcon Icon="@GetRoleIcon(role.RoleName)" Size="Size.Small" />
                                        </RadzenAvatar>
                                        <div style="display: flex; flex-direction: column; gap: 0;">
                                            <RadzenText Style="font-weight: 500;">
                                                @role.RoleName
                                            </RadzenText>
                                            <RadzenText Style="font-size: 0.75rem; color: gray;">
                                                @GetActivePermissionsCount(role.RoleId) permissions
                                            </RadzenText>
                                        </div>
                                        <div style="display: flex; gap: 4px;">
                                            <RadzenButton Icon="done_all"
                                                          Size="ButtonSize.Small"
                                                          Disabled="@isBusy"
                                                          ButtonStyle="ButtonStyle.Success"
                                                          Title="Grant all for this role"
                                                          Click="@(() => SetAllPermissionsForRole(role.RoleId, true))" />
                                            <RadzenButton Icon="block"
                                                          Size="ButtonSize.Small"
                                                          Disabled="@isBusy"
                                                          ButtonStyle="ButtonStyle.Danger"
                                                          Title="Revoke all for this role"
                                                          Click="@(() => SetAllPermissionsForRole(role.RoleId, false))" />
                                        </div>
                                    </div>
                                </td>

                                @foreach (var perm in FilteredPermissions)
                                {
                                    <td style="text-align: center; vertical-align: middle; padding: 8px;">
                                        <RadzenCheckBox T="bool"
                                                        Value="@permissionMatrix[role.RoleId][perm.PermissionId]"
                                                        ValueChanged="@((bool value) => OnPermissionChanged(role.RoleId, perm.PermissionId, value))"
                                                        Style="color: #16a34a;"
                                                        Disabled="@isBusy"
                                                        Size="Size.Medium"
                                                        AriaLabel="@($"{role.RoleName} — {perm.PermissionName}")" />
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</RadzenCard>
</RadzenPanel>

<style>
    .matrix-container {
        overflow: auto;
    }
    .sticky-header {
        position: sticky;
        top: 0;
        background: var(--mud-palette-surface);
        z-index: 1;
    }

    .sticky-first {
        position: sticky;
        left: 0;
        background: var(--mud-palette-surface);
        z-index: 2;
    }

    .mw-250 {
        max-width: 250px;
    }
</style>

@code {
    // Data
    private List<Role> roles = new();
    private List<Permission> permissions = new();

    // Filters
    private string roleFilter = string.Empty;
    private string permissionFilter = string.Empty;

    // Matrix: RoleId → PermissionId → bool
    private readonly Dictionary<int, Dictionary<int, bool>> permissionMatrix = new();

    // UI State
    private bool isLoading = true;
    private bool isBusy = false; // disables controls during bulk/async ops

    // Computed
    private List<Role> FilteredRoles =>
        string.IsNullOrWhiteSpace(roleFilter)
            ? roles
            : roles.Where(r => r.RoleName.Contains(roleFilter, StringComparison.OrdinalIgnoreCase)).ToList();

    private List<Permission> FilteredPermissions =>
        string.IsNullOrWhiteSpace(permissionFilter)
            ? permissions
            : permissions.Where(p => p.PermissionName.Contains(permissionFilter, StringComparison.OrdinalIgnoreCase)
                                  || (!string.IsNullOrWhiteSpace(p.Description) && p.Description.Contains(permissionFilter, StringComparison.OrdinalIgnoreCase)))
                         .ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;

            // Load all roles and all permissions from their own sources
            roles = await RoleService.GetAllAsync(); // from Roles table
            permissions = await PermissionService.GetAllAsync(); // from Permissions table

            // Load existing role-permission links
            var rolePermissions = await RolePermissionService.GetAllAsync();

            // Initialize matrix with default false
            foreach (var role in roles)
            {
                permissionMatrix[role.RoleId] = new Dictionary<int, bool>();

                foreach (var perm in permissions)
                {
                    bool hasPermission = rolePermissions.Any(rp =>
                        rp.RoleId == role.RoleId &&
                        rp.PermissionId == perm.PermissionId);

                    permissionMatrix[role.RoleId][perm.PermissionId] = hasPermission;
                }
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error", Detail = $"Failed to load permissions: {ex.Message}" });
        }
        finally
        {
            isLoading = false;
        }
    }


    private void ClearFilters()
    {
        roleFilter = string.Empty;
        permissionFilter = string.Empty;
    }

    private async Task OnPermissionChanged(int roleId, int permissionId, bool isGranted)
    {
        var previous = permissionMatrix[roleId][permissionId];
        permissionMatrix[roleId][permissionId] = isGranted;

        try
        {
            await RolePermissionService.ToggleAsync(roleId, permissionId, isGranted);
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Permission Updated", Detail = $"Permission {(isGranted ? "granted" : "revoked")} • Role #{roleId}, Permission #{permissionId}" });

            // Defer claim refresh to avoid render conflict
            _ = InvokeAsync(async () =>
            {
                await Task.Delay(100); // let UI settle
                await AuthService.RefreshClaimsAsync();
            });
        }
        catch (Exception ex)
        {
            permissionMatrix[roleId][permissionId] = previous;
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error", Detail = $"Error updating permission: {ex.Message}" });
        }

        StateHasChanged();
    }


    private async Task SetAllPermissionsForRole(int roleId, bool grant)
    {
        if (!permissionMatrix.TryGetValue(roleId, out var row)) return;

        isBusy = true;
        StateHasChanged();

        // Optimistic row update
        var previous = row.ToDictionary(kv => kv.Key, kv => kv.Value);
        try
        {
            foreach (var permId in FilteredPermissions.Select(p => p.PermissionId))
            {
                if (row[permId] == grant) continue;
                row[permId] = grant;
                await RolePermissionService.ToggleAsync(roleId, permId, grant);
            }
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = "Bulk Update", Detail = $"{(grant ? "Granted" : "Revoked")} all for the role." });
        }
        catch (Exception ex)
        {
            // rollback
            foreach (var kv in previous) row[kv.Key] = kv.Value;
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error", Detail = $"Bulk update failed: {ex.Message}" });
        }
        finally
            { isBusy = false; StateHasChanged(); }
    }

    private async Task SetPermissionForAllRoles(int permissionId, bool grant)
    {
        isBusy = true;
        StateHasChanged();

        // Optimistic column update
        var prev = new Dictionary<int, bool>();
        foreach (var role in FilteredRoles)
            prev[role.RoleId] = permissionMatrix[role.RoleId][permissionId];

        try
        {
            foreach (var role in FilteredRoles)
            {
                var current = permissionMatrix[role.RoleId][permissionId];
                if (current == grant) continue;
                permissionMatrix[role.RoleId][permissionId] = grant;
                await RolePermissionService.ToggleAsync(role.RoleId, permissionId, grant);
            }
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = "Bulk Update", Detail = $"{(grant ? "Granted" : "Revoked")} for all roles on this permission." });
        }
        catch (Exception ex)
        {
            foreach (var role in FilteredRoles)
                permissionMatrix[role.RoleId][permissionId] = prev[role.RoleId];
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error", Detail = $"Bulk update failed: {ex.Message}" });
        }
        finally
            { isBusy = false; StateHasChanged(); }
    }

    // Helper methods for the enhanced UI
    private int GetActiveAssignmentsCount()
    {
        return permissionMatrix.Values.SelectMany(row => row.Values).Count(granted => granted);
    }

    private int GetCoveragePercentage()
    {
        if (roles.Count == 0 || permissions.Count == 0) return 0;
        var totalPossible = roles.Count * permissions.Count;
        var assigned = GetActiveAssignmentsCount();
        return (int)Math.Round((double)assigned / totalPossible * 100);
    }

    private int GetActivePermissionsCount(int roleId)
    {
        if (!permissionMatrix.TryGetValue(roleId, out var row)) return 0;
        return row.Values.Count(granted => granted);
    }

    private string GetRoleColor(string roleName) => roleName.ToLower() switch
    {
        var name when name.Contains("super") => "#dc2626",
        var name when name.Contains("admin") => "#f59e0b",
        var name when name.Contains("manager") => "#3b82f6",
        var name when name.Contains("user") => "#3b82f6",
        var name when name.Contains("read") => "#6b7280",
        _ => "#3b82f6"
    };

    private string GetRoleIcon(string roleName) => roleName.ToLower() switch
    {
        var name when name.Contains("super") => "shield",
        var name when name.Contains("admin") => "admin_panel_settings",
        var name when name.Contains("manager") => "manage_accounts",
        var name when name.Contains("user") => "person",
        var name when name.Contains("read") => "visibility",
        _ => "group"
    };

    private string GetPermissionIcon(string permissionName) => permissionName.ToLower() switch
    {
        var p when p.Contains("view") => "visibility",
        var p when p.Contains("create") => "add",
        var p when p.Contains("edit") => "edit",
        var p when p.Contains("delete") => "delete",
        var p when p.Contains("export") => "download",
        var p when p.Contains("import") => "upload",
        var p when p.Contains("manage") => "settings",
        var p when p.Contains("dashboard") => "dashboard",
        var p when p.Contains("reports") => "assessment",
        var p when p.Contains("system") => "admin_panel_settings",
        var p when p.Contains("audit") => "history",
        var p when p.Contains("backup") => "backup",
        _ => "lock"
    };

    private string GetShortPermissionName(string permissionName)
    {
        // Convert "Users.Create" to "Create"
        var parts = permissionName.Split('.');
        return parts.Length > 1 ? parts[1] : permissionName;
    }

    private async Task GrantAllVisible()
    {
        isBusy = true;
        StateHasChanged();

        try
        {
            foreach (var role in FilteredRoles)
            {
                foreach (var perm in FilteredPermissions)
                {
                    if (!permissionMatrix[role.RoleId][perm.PermissionId])
                    {
                        permissionMatrix[role.RoleId][perm.PermissionId] = true;
                        await RolePermissionService.ToggleAsync(role.RoleId, perm.PermissionId, true);
                    }
                }
            }
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Bulk Grant", Detail = "Granted all visible permissions" });
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error", Detail = $"Error granting permissions: {ex.Message}" });
        }
        finally
        {
            isBusy = false;
            StateHasChanged();
        }
    }

    private async Task RevokeAllVisible()
    {
        isBusy = true;
        StateHasChanged();

        try
        {
            foreach (var role in FilteredRoles)
            {
                foreach (var perm in FilteredPermissions)
                {
                    if (permissionMatrix[role.RoleId][perm.PermissionId])
                    {
                        permissionMatrix[role.RoleId][perm.PermissionId] = false;
                        await RolePermissionService.ToggleAsync(role.RoleId, perm.PermissionId, false);
                    }
                }
            }
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Bulk Revoke", Detail = "Revoked all visible permissions" });
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error", Detail = $"Error revoking permissions: {ex.Message}" });
        }
        finally
        {
            isBusy = false;
            StateHasChanged();
        }
    }

    private async Task RefreshMatrix()
    {
        await OnInitializedAsync();
        NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = "Refresh", Detail = "Permission matrix refreshed" });
    }
}
