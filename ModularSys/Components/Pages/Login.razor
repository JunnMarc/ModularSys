@page "/login"
@using ModularSys.Core.Interfaces
@using Radzen
@using Radzen.Blazor

@inject IAuthService AuthService
@inject NavigationManager Nav
@inject NotificationService NotificationService

<PageTitle>Login - ModularSys Enterprise</PageTitle>

<div style="min-height: 100vh; display: flex; background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);">
    <!-- Left Side - Branding -->
    <div style="flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 3rem; color: white;">
        <RadzenStack AlignItems="AlignItems.Center" Gap="2rem" Style="max-width: 500px;">
            <div style="width: 100px; height: 100px; border-radius: 20px; background: rgba(255,255,255,0.15); backdrop-filter: blur(10px); display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 32px rgba(0,0,0,0.1);">
                <RadzenIcon Icon="business" Style="font-size: 4rem; color: white;" />
            </div>
            <RadzenText TextStyle="TextStyle.H2" Text="ModularSys Enterprise" Style="color: white; font-weight: 700; text-align: center; font-size: 2.5rem;" />
            <RadzenText TextStyle="TextStyle.H6" Text="Modular Business Management Platform" Style="color: rgba(255,255,255,0.95); text-align: center; font-size: 1.125rem; font-weight: 400;" />
            
            <RadzenStack Gap="1.25rem" Style="margin-top: 2.5rem; width: 100%;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="padding: 1rem; background: rgba(255,255,255,0.1); backdrop-filter: blur(10px); border-radius: 12px;">
                    <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center;">
                        <RadzenIcon Icon="layers" Style="font-size: 1.25rem;" />
                    </div>
                    <RadzenText Text="Modular Architecture" Style="font-size: 1.125rem; font-weight: 500;" />
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="padding: 1rem; background: rgba(255,255,255,0.1); backdrop-filter: blur(10px); border-radius: 12px;">
                    <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center;">
                        <RadzenIcon Icon="security" Style="font-size: 1.25rem;" />
                    </div>
                    <RadzenText Text="Enterprise Security" Style="font-size: 1.125rem; font-weight: 500;" />
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="padding: 1rem; background: rgba(255,255,255,0.1); backdrop-filter: blur(10px); border-radius: 12px;">
                    <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center;">
                        <RadzenIcon Icon="analytics" Style="font-size: 1.25rem;" />
                    </div>
                    <RadzenText Text="Real-time Analytics" Style="font-size: 1.125rem; font-weight: 500;" />
                </RadzenStack>
            </RadzenStack>
        </RadzenStack>
    </div>

    <!-- Right Side - Login Form -->
    <div style="flex: 1; display: flex; justify-content: center; align-items: center; padding: 3rem; background: #fafafa;">
        <RadzenCard Style="width: 100%; max-width: 450px; box-shadow: 0 10px 40px rgba(0,0,0,0.1); border-radius: 16px; border: none;">
            <RadzenStack Gap="2rem" Style="padding: 1.5rem;">
                <!-- Header -->
                <RadzenStack AlignItems="AlignItems.Center" Gap="1rem">
                    <div style="width: 80px; height: 80px; border-radius: 50%; background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 24px rgba(139, 92, 246, 0.3);">
                        <RadzenIcon Icon="lock" Style="font-size: 2.5rem; color: white;" />
                    </div>
                    <RadzenText TextStyle="TextStyle.H4" Text="Sign In" Style="font-weight: 700; color: #1f2937;" />
                    <RadzenText Text="Enter your credentials to access your account" Style="color: #6b7280; text-align: center; font-size: 0.9375rem;" />
                </RadzenStack>
                
                @if (!string.IsNullOrEmpty(error))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" Variant="Variant.Flat" 
                               Title="Login Failed" Style="border-left: 4px solid var(--rz-danger);">
                        @error
                    </RadzenAlert>
                }
                
                <!-- Login Form -->
                <RadzenTemplateForm TItem="LoginModel" Data="@_model" Submit="@HandleLogin">
                    <RadzenStack Gap="1.5rem">
                        <RadzenFormField Text="Username" Variant="Variant.Outlined" Style="margin-bottom: 0;">
                            <ChildContent>
                                <RadzenTextBox @bind-Value="_model.Username" 
                                             Style="width: 100%; height: 48px; font-size: 1rem;" 
                                             Placeholder="Enter your username">
                                    <ChildContent>
                                        <RadzenIcon Icon="person" Style="margin-right: 8px; color: #6b7280;" />
                                    </ChildContent>
                                </RadzenTextBox>
                            </ChildContent>
                            <Helper>
                                <RadzenText TextStyle="TextStyle.Caption" Text="Your unique username" Style="color: #9ca3af; font-size: 0.8125rem;" />
                            </Helper>
                        </RadzenFormField>
                        
                        <RadzenFormField Text="Password" Variant="Variant.Outlined" Style="margin-bottom: 0;">
                            <ChildContent>
                                <RadzenPassword @bind-Value="_model.Password" 
                                              Style="width: 100%; height: 48px; font-size: 1rem;" 
                                              Placeholder="Enter your password">
                                    <ChildContent>
                                        <RadzenIcon Icon="lock" Style="margin-right: 8px; color: #6b7280;" />
                                    </ChildContent>
                                </RadzenPassword>
                            </ChildContent>
                            <Helper>
                                <RadzenText TextStyle="TextStyle.Caption" Text="Your secure password" Style="color: #9ca3af; font-size: 0.8125rem;" />
                            </Helper>
                        </RadzenFormField>
                        
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Style="margin-top: 0.5rem;">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <RadzenCheckBox @bind-Value="_model.RememberMe" Name="remember" />
                                <RadzenLabel Text="Remember me" Component="remember" Style="cursor: pointer; color: #374151; font-size: 0.9375rem;" />
                            </RadzenStack>
                        </RadzenStack>
                        
                        <RadzenButton Text="SIGN IN" 
                                    Icon="login"
                                    ButtonType="ButtonType.Submit" 
                                    ButtonStyle="ButtonStyle.Primary"
                                    Style="width: 100%; height: 52px; font-size: 1rem; font-weight: 600; background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); border: none; border-radius: 8px; margin-top: 0.5rem;" 
                                    IsBusy="@_isLoading"
                                    Disabled="@_isLoading" />
                                    
                        <RadzenButton Text="Create Account" 
                                    Icon="person_add"
                                    ButtonStyle="ButtonStyle.Base"
                                    Variant="Variant.Text"
                                    Style="width: 100%; margin-top: 0.5rem;"
                                    Click="@(() => Nav.NavigateTo("/register"))" />
                    </RadzenStack>
                </RadzenTemplateForm>

                <!-- Footer -->
                <RadzenStack AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid #e5e7eb;">
                    <RadzenText TextStyle="TextStyle.Caption" Text="ModularSys Enterprise v1.0.0" Style="color: #9ca3af; font-size: 0.8125rem;" />
                    <RadzenText TextStyle="TextStyle.Caption" Text="© 2025 All rights reserved" Style="color: #9ca3af; font-size: 0.8125rem;" />
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    </div>
</div>

@code {
    private LoginModel _model = new();
    private string error = "";
    private bool _isLoading = false;
    
    public class LoginModel
    {
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
        public bool RememberMe { get; set; } = false;
    }
    
    protected override void OnInitialized()
    {
        if (AuthService.IsAuthenticated)
        {
            RedirectToHome();
        }
    }

    private void RedirectToHome()
    {
        // Role-Based Redirection detection
        System.Diagnostics.Debug.WriteLine($"[Login] Redirecting User Role: {AuthService.CurrentUserRole}");
        
        if (string.Equals(AuthService.CurrentUserRole, "Customer", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo("portal/mytickets");
        }
        else
        {
            Nav.NavigateTo("dashboard");
        }
    }
    
    private async Task HandleLogin()
    {
        try
        {
            _isLoading = true;
            error = "";
            
            if (string.IsNullOrWhiteSpace(_model.Username) || string.IsNullOrWhiteSpace(_model.Password))
            {
                error = "Please enter both username and password";
                return;
            }
            
            var success = await AuthService.LoginAsync(_model.Username, _model.Password);
            if (success)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Welcome!", $"Successfully logged in as {_model.Username}");
                RedirectToHome();
            }
            else
            {
                error = "Invalid username or password. Please try again.";
            }
        }
        catch (Exception ex)
        {
            error = $"Login failed: {ex.Message}";
            NotificationService.Notify(NotificationSeverity.Error, "Error", "An error occurred during login");
        }
        finally
        {
            _isLoading = false;
        }
    }
}
