@page "/login"
@using ModularSys.Core.Interfaces
@using Radzen
@using Radzen.Blazor

@inject IAuthService AuthService
@inject NavigationManager Nav
@inject NotificationService NotificationService

<PageTitle>Login - Helpdesk Hero</PageTitle>

<div style="min-height: 100vh; display: flex; background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);">
    <!-- Left Side - Branding -->
    <div style="flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 3rem; color: white;">
        <RadzenStack AlignItems="AlignItems.Center" Gap="2rem" Style="max-width: 500px;">
            <div style="width: 100px; height: 100px; border-radius: 20px; background: rgba(255,255,255,0.15); backdrop-filter: blur(10px); display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 32px rgba(0,0,0,0.1);">
                <span style="font-size: 4rem; font-weight: 800; color: white;">H</span>
            </div>
            <div>
                 <RadzenText TextStyle="TextStyle.H2" Text="Helpdesk Hero" Style="color: white; font-weight: 700; text-align: center; font-size: 3rem; margin-bottom: 0.5rem;" />
                 <RadzenText TextStyle="TextStyle.H6" Text="Your Customer Success Platform" Style="color: rgba(255,255,255,0.95); text-align: center; font-size: 1.25rem; font-weight: 400; letter-spacing: 1px;" />
            </div>
           
            
            <RadzenStack Gap="1.25rem" Style="margin-top: 2.5rem; width: 100%;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="padding: 1rem; background: rgba(255,255,255,0.1); backdrop-filter: blur(10px); border-radius: 12px;">
                    <RadzenIcon Icon="support_agent" Style="font-size: 1.5rem;" />
                    <div>
                        <RadzenText Text="Ticket Management" Style="font-size: 1rem; font-weight: 600; color: white; margin: 0;" />
                        <RadzenText Text="Streamline your support workflow" Style="font-size: 0.8rem; color: rgba(255,255,255,0.8); margin: 0;" />
                    </div>
                </RadzenStack>
                
                 <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="padding: 1rem; background: rgba(255,255,255,0.1); backdrop-filter: blur(10px); border-radius: 12px;">
                    <RadzenIcon Icon="analytics" Style="font-size: 1.5rem;" />
                    <div>
                         <RadzenText Text="Real-time Analytics" Style="font-size: 1rem; font-weight: 600; color: white; margin: 0;" />
                         <RadzenText Text="Data-driven insights instantly" Style="font-size: 0.8rem; color: rgba(255,255,255,0.8); margin: 0;" />
                    </div>
                </RadzenStack>
            </RadzenStack>
        </RadzenStack>
    </div>

    <!-- Right Side - Login Form -->
    <div style="flex: 1; display: flex; justify-content: center; align-items: center; padding: 3rem; background: #fafafa;">
        <RadzenCard Style="width: 100%; max-width: 450px; box-shadow: 0 10px 40px rgba(0,0,0,0.1); border-radius: 16px; border: none;">
            <RadzenStack Gap="2rem" Style="padding: 1.5rem;">
                <!-- Header -->
                <RadzenStack AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenText TextStyle="TextStyle.H4" Text="Welcome Back" Style="font-weight: 800; color: #1f2937;" />
                    <RadzenText Text="Sign in to continue to Helpdesk Hero" Style="color: #6b7280; text-align: center; font-size: 0.9375rem;" />
                </RadzenStack>
                
                @if (!string.IsNullOrEmpty(error))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" Variant="Variant.Flat" 
                               Title="Login Failed" Style="border-left: 4px solid var(--rz-danger);">
                        @error
                    </RadzenAlert>
                }
                
                <!-- Login Form -->
                <RadzenTemplateForm TItem="LoginModel" Data="@_model" Submit="@HandleLogin">
                    <RadzenStack Gap="1.5rem">
                        
                         <!-- SSO Placeholder -->
                        <RadzenButton Text="Log in with SSO" 
                                    Icon="verified_user"
                                    ButtonStyle="ButtonStyle.Light"
                                    Variant="Variant.Outlined"
                                    Style="width: 100%; color: #374151; border-color: #d1d5db;"
                                    Click="@(() => NotificationService.Notify(NotificationSeverity.Info, "SSO", "SSO integration coming soon!"))" />

                        <div style="display: flex; align-items: center; gap: 1rem; color: #9ca3af;">
                            <div style="flex: 1; height: 1px; background: #e5e7eb;"></div>
                            <span style="font-size: 0.875rem;">OR</span>
                            <div style="flex: 1; height: 1px; background: #e5e7eb;"></div>
                        </div>

                        <RadzenFormField Text="Username" Variant="Variant.Outlined" Style="margin-bottom: 0;">
                            <ChildContent>
                                <RadzenTextBox @bind-Value="_model.Username" Style="width: 100%; height: 48px;" />
                            </ChildContent>
                        </RadzenFormField>
                        
                        <RadzenFormField Text="Password" Variant="Variant.Outlined" Style="margin-bottom: 0;">
                            <ChildContent>
                                <RadzenPassword @bind-Value="_model.Password" Style="width: 100%; height: 48px;" />
                            </ChildContent>
                        </RadzenFormField>
                        
                        <RadzenButton Text="SIGN IN" 
                                    ButtonType="ButtonType.Submit" 
                                    ButtonStyle="ButtonStyle.Primary"
                                    Style="width: 100%; height: 48px; font-weight: 700; background: #0284c7; border: none; border-radius: 8px;" 
                                    IsBusy="@_isLoading"
                                    Disabled="@_isLoading" />
                                    
                         <div style="text-align: center;">
                            <RadzenText TextStyle="TextStyle.Caption" Style="color: #6b7280;">
                                Don't have an account? 
                                <a href="/register" style="color: #0284c7; font-weight: 600; text-decoration: none;">Create Account</a>
                            </RadzenText>
                        </div>
                    </RadzenStack>
                </RadzenTemplateForm>

                <!-- Footer -->
                <div style="text-align: center; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #f3f4f6;">
                    <span style="color: #9ca3af; font-size: 0.75rem;">Powered by <b>ModularSys</b></span>
                </div>
            </RadzenStack>
        </RadzenCard>
    </div>
</div>

@code {
    private LoginModel _model = new();
    private string error = "";
    private bool _isLoading = false;
    
    public class LoginModel
    {
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
        public bool RememberMe { get; set; } = false;
    }
    
    protected override void OnInitialized()
    {
        if (AuthService.IsAuthenticated)
        {
            RedirectToHome();
        }
    }

    private void RedirectToHome()
    {
        if (string.Equals(AuthService.CurrentUserRole, "Customer", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo("portal/mytickets");
        }
        else
        {
            Nav.NavigateTo("dashboard");
        }
    }
    
    private async Task HandleLogin()
    {
        try
        {
            _isLoading = true;
            error = "";
            
            if (string.IsNullOrWhiteSpace(_model.Username) || string.IsNullOrWhiteSpace(_model.Password))
            {
                error = "Please enter both username and password";
                return;
            }
            
            var success = await AuthService.LoginAsync(_model.Username, _model.Password);
            if (success)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Welcome to Helpdesk Hero!", $"Successfully logged in as {_model.Username}");
                RedirectToHome();
            }
            else
            {
                error = "Invalid username or password.";
            }
        }
        catch (Exception ex)
        {
            error = $"Login failed: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
