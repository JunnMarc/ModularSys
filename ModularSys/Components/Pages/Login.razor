@page "/login"
@using ModularSys.Core.Interfaces
@using Radzen
@using Radzen.Blazor

@inject IAuthService AuthService
@inject NavigationManager Nav
@inject NotificationService NotificationService

<PageTitle>Login - ModularSys Enterprise</PageTitle>

<div style="min-height: 100vh; display: flex; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <!-- Left Side - Branding -->
    <div style="flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 3rem; color: white;">
        <RadzenStack AlignItems="AlignItems.Center" Gap="2rem" Style="max-width: 500px;">
            <RadzenIcon Icon="business" Style="font-size: 5rem; color: white;" />
            <RadzenText TextStyle="TextStyle.H2" Text="ModularSys Enterprise" Style="color: white; font-weight: 700; text-align: center;" />
            <RadzenText TextStyle="TextStyle.H6" Text="Modular Business Management Platform" Style="color: rgba(255,255,255,0.9); text-align: center;" />
            
            <RadzenStack Gap="1rem" Style="margin-top: 2rem;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                    <RadzenIcon Icon="check_circle" Style="font-size: 1.5rem;" />
                    <RadzenText Text="Modular Architecture" Style="font-size: 1.125rem;" />
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                    <RadzenIcon Icon="check_circle" Style="font-size: 1.5rem;" />
                    <RadzenText Text="Enterprise Security" Style="font-size: 1.125rem;" />
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                    <RadzenIcon Icon="check_circle" Style="font-size: 1.5rem;" />
                    <RadzenText Text="Real-time Analytics" Style="font-size: 1.125rem;" />
                </RadzenStack>
            </RadzenStack>
        </RadzenStack>
    </div>

    <!-- Right Side - Login Form -->
    <div style="flex: 1; display: flex; justify-content: center; align-items: center; padding: 3rem; background: white;">
        <RadzenCard Style="width: 100%; max-width: 450px; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
            <RadzenStack Gap="2rem" Style="padding: 1rem;">
                <!-- Header -->
                <RadzenStack AlignItems="AlignItems.Center" Gap="1rem">
                    <div style="width: 80px; height: 80px; border-radius: 50%; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center;">
                        <RadzenIcon Icon="lock" Style="font-size: 2.5rem; color: white;" />
                    </div>
                    <RadzenText TextStyle="TextStyle.H4" Text="Sign In" Style="font-weight: 700;" />
                    <RadzenText Text="Enter your credentials to access your account" Style="color: var(--rz-text-secondary-color); text-align: center;" />
                </RadzenStack>
                
                @if (!string.IsNullOrEmpty(error))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" Variant="Variant.Flat" 
                               Title="Login Failed" Style="border-left: 4px solid var(--rz-danger);">
                        @error
                    </RadzenAlert>
                }
                
                <!-- Login Form -->
                <RadzenTemplateForm TItem="LoginModel" Data="@_model" Submit="@HandleLogin">
                    <RadzenStack Gap="1.5rem">
                        <RadzenFormField Text="Username" Variant="Variant.Outlined">
                            <ChildContent>
                                <RadzenTextBox @bind-Value="_model.Username" Style="width: 100%;" Placeholder="Enter your username" />
                            </ChildContent>
                            <Helper>
                                <RadzenText TextStyle="TextStyle.Caption" Text="Your unique username" />
                            </Helper>
                        </RadzenFormField>
                        
                        <RadzenFormField Text="Password" Variant="Variant.Outlined">
                            <ChildContent>
                                <RadzenPassword @bind-Value="_model.Password" Style="width: 100%;" Placeholder="Enter your password" />
                            </ChildContent>
                            <Helper>
                                <RadzenText TextStyle="TextStyle.Caption" Text="Your secure password" />
                            </Helper>
                        </RadzenFormField>
                        
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                            <RadzenCheckBox @bind-Value="_model.RememberMe" Name="remember" />
                            <RadzenLabel Text="Remember me" Component="remember" Style="margin-left: 0.5rem; cursor: pointer;" />
                        </RadzenStack>
                        
                        <RadzenButton Text="Sign In" 
                                    ButtonType="ButtonType.Submit" 
                                    ButtonStyle="ButtonStyle.Primary"
                                    Style="width: 100%; height: 48px; font-size: 1.125rem; font-weight: 600;" 
                                    IsBusy="@_isLoading"
                                    Disabled="@_isLoading" />
                    </RadzenStack>
                </RadzenTemplateForm>

                <!-- Footer -->
                <RadzenStack AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-top: 1rem;">
                    <RadzenText TextStyle="TextStyle.Caption" Text="ModularSys Enterprise v1.0.0" Style="color: var(--rz-text-secondary-color);" />
                    <RadzenText TextStyle="TextStyle.Caption" Text="© 2025 All rights reserved" Style="color: var(--rz-text-secondary-color);" />
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    </div>
</div>

@code {
    private LoginModel _model = new();
    private string error = "";
    private bool _isLoading = false;
    
    public class LoginModel
    {
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
        public bool RememberMe { get; set; } = false;
    }
    
    protected override void OnInitialized()
    {
        if (AuthService.IsAuthenticated)
        {
            Nav.NavigateTo("/dashboard");
        }
    }
    
    private async Task HandleLogin()
    {
        try
        {
            _isLoading = true;
            error = "";
            
            if (string.IsNullOrWhiteSpace(_model.Username) || string.IsNullOrWhiteSpace(_model.Password))
            {
                error = "Please enter both username and password";
                return;
            }
            
            var success = await AuthService.LoginAsync(_model.Username, _model.Password);
            if (success)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Welcome!", $"Successfully logged in as {_model.Username}");
                Nav.NavigateTo("/dashboard", forceLoad: true);
            }
            else
            {
                error = "Invalid username or password. Please try again.";
            }
        }
        catch (Exception ex)
        {
            error = $"Login failed: {ex.Message}";
            NotificationService.Notify(NotificationSeverity.Error, "Error", "An error occurred during login");
        }
        finally
        {
            _isLoading = false;
        }
    }
}
