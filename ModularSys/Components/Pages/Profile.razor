@page "/profile"
@using ModularSys.Core.Interfaces
@using ModularSys.Data.Common.Entities
@using Radzen
@using Radzen.Blazor

@inject IAuthService AuthService
@inject IUserService UserService
@inject NavigationManager Nav
@inject NotificationService NotificationService

<PageTitle>Profile - ModularSys</PageTitle>

@if (_loading)
{
    <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Style="min-height: 400px;">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
        <RadzenText Text="Loading profile..." Style="margin-top: 1rem;" />
    </RadzenStack>
}
else if (_user != null)
{
    <RadzenStack Gap="1.5rem">
        <!-- Page Header -->
        <RadzenCard Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                <RadzenGravatar Email="@_user.Email" Style="width: 64px; height: 64px; border-radius: 50%; border: 3px solid white;" />
                <RadzenStack Gap="0">
                    <RadzenText TextStyle="TextStyle.H4" Text="@_user.Username" Style="color: white; font-weight: 600;" />
                    <RadzenText Text="@_user.Role?.RoleName" Style="color: rgba(255,255,255,0.9);" />
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>

        <RadzenRow Gap="1.5rem">
            <!-- Profile Information -->
            <RadzenColumn Size="12" SizeMD="8">
                <RadzenCard>
                    <RadzenStack Gap="1.5rem">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                            <RadzenText TextStyle="TextStyle.H6" Text="Profile Information" />
                            @if (!_isEditing)
                            {
                                <RadzenButton Text="Edit" Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => _isEditing = true)" />
                            }
                        </RadzenStack>
                        
                        @if (_isEditing)
                        {
                            <RadzenTemplateForm TItem="User" Data="@_user" Submit="@SaveProfile">
                                <RadzenStack Gap="1rem">
                                    <RadzenRow Gap="1rem">
                                        <RadzenColumn Size="12" SizeMD="6">
                                            <RadzenFormField Text="Username" Variant="Variant.Outlined">
                                                <RadzenTextBox @bind-Value="_user.Username" Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                        
                                        <RadzenColumn Size="12" SizeMD="6">
                                            <RadzenFormField Text="Email" Variant="Variant.Outlined">
                                                <RadzenTextBox @bind-Value="_user.Email" Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                        <RadzenButton Text="Save Changes" Icon="save" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" IsBusy="@_saving" />
                                        <RadzenButton Text="Cancel" Icon="cancel" ButtonStyle="ButtonStyle.Light" Click="@CancelEdit" Disabled="@_saving" />
                                    </RadzenStack>
                                </RadzenStack>
                            </RadzenTemplateForm>
                        }
                        else
                        {
                            <RadzenStack Gap="1rem">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                    <RadzenText Text="Username:" Style="font-weight: 600; width: 120px;" />
                                    <RadzenText Text="@_user.Username" />
                                </RadzenStack>
                                
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                    <RadzenText Text="Email:" Style="font-weight: 600; width: 120px;" />
                                    <RadzenText Text="@_user.Email" />
                                </RadzenStack>
                                
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                    <RadzenText Text="Role:" Style="font-weight: 600; width: 120px;" />
                                    <RadzenBadge Text="@_user.Role?.RoleName" BadgeStyle="BadgeStyle.Info" />
                                </RadzenStack>
                            </RadzenStack>
                        }
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>

            <!-- Account Stats -->
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenStack Gap="1.5rem">
                    <RadzenCard>
                        <RadzenStack Gap="1rem">
                            <RadzenText TextStyle="TextStyle.H6" Text="Account Statistics" />
                            
                            <RadzenStack Gap="0.75rem">
                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                                    <RadzenText Text="Member Since" Style="font-weight: 500;" />
                                    <RadzenText Text="@_user.CreatedAt.ToString("MMM dd, yyyy")" />
                                </RadzenStack>
                                
                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                                    <RadzenText Text="Last Updated" Style="font-weight: 500;" />
                                    <RadzenText Text="@(_user.UpdatedAt?.ToString("MMM dd, yyyy") ?? "Never")" />
                                </RadzenStack>
                                
                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                                    <RadzenText Text="Status" Style="font-weight: 500;" />
                                    <RadzenBadge Text="@(_user.IsDeleted ? "Inactive" : "Active")" 
                                               BadgeStyle="@(_user.IsDeleted ? BadgeStyle.Danger : BadgeStyle.Success)" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenCard>
                    
                    <RadzenCard>
                        <RadzenStack Gap="1rem">
                            <RadzenText TextStyle="TextStyle.H6" Text="Quick Actions" />
                            
                            <RadzenStack Gap="0.5rem">
                                <RadzenButton Text="Change Password" Icon="lock" ButtonStyle="ButtonStyle.Light" 
                                            Style="width: 100%; justify-content: flex-start;" Click="@ChangePassword" />
                                <RadzenButton Text="Security Settings" Icon="security" ButtonStyle="ButtonStyle.Light" 
                                            Style="width: 100%; justify-content: flex-start;" Click="@(() => Nav.NavigateTo("/settings"))" />
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenCard>
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenStack>
}

@code {
    private User? _user;
    private bool _loading = true;
    private bool _isEditing = false;
    private bool _saving = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadProfile();
    }

    private async Task LoadProfile()
    {
        try
        {
            _loading = true;
            var users = await UserService.GetAllAsync();
            _user = users.FirstOrDefault(u => u.Username == AuthService.CurrentUser);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", $"Failed to load profile: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveProfile()
    {
        try
        {
            _saving = true;
            // TODO: Implement profile update via UserService
            NotificationService.Notify(NotificationSeverity.Success, "Success", "Profile updated successfully");
            _isEditing = false;
            await LoadProfile();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", $"Failed to save profile: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    private async void CancelEdit()
    {
        _isEditing = false;
        await LoadProfile();
    }

    private void ChangePassword()
    {
        NotificationService.Notify(NotificationSeverity.Info, "Coming Soon", "Password change functionality will be implemented");
    }
}
