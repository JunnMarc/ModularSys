@using System.ComponentModel.DataAnnotations
@using ModularSys.Core.Interfaces
@using ModularSys.Data.Common.Entities

@inject IRoleService RoleService
@inject IPermissionService PermissionService
@inject IRolePermissionService RolePermissionService
@inject NotificationService NotificationService
@inject DialogService DialogService

<div style="padding: 24px;">
    <h3 style="margin: 0 0 24px 0; font-size: 1.5rem; font-weight: 600; color: #212121;">@(_isEditMode ? "Edit Role" : "Create Role")</h3>

    <EditForm Model="_roleModel" OnValidSubmit="HandleSave">
        <DataAnnotationsValidator />

        <div style="display: flex; flex-direction: column; gap: 16px;">
            <div>
                <label style="display: block; margin-bottom: 8px; color: #757575; font-size: 0.875rem; font-weight: 500;">Role Name *</label>
                <RadzenTextBox @bind-Value="_roleModel.RoleName" Placeholder="e.g., Content Manager" Style="width: 100%; border-radius: 6px;" Required="true" />
                <ValidationMessage For="@(() => _roleModel.RoleName)" />
            </div>

            <div>
                <label style="display: block; margin-bottom: 8px; color: #757575; font-size: 0.875rem; font-weight: 500;">Description</label>
                <RadzenTextArea @bind-Value="_roleModel.Description" Placeholder="A short description of the role's purpose" Style="width: 100%; border-radius: 6px;" />
            </div>
        </div>

        <hr style="margin: 24px 0; border: none; border-top: 1px solid #e0e0e0;" />

        <h4 style="margin: 0 0 16px 0; font-size: 1.125rem; font-weight: 600; color: #212121;">Assign Permissions</h4>

        @if (_allPermissions.Any())
        {
            <div style="max-height: 300px; overflow-y: auto; padding: 8px; border: 1px solid #e0e0e0; border-radius: 8px;">
                @foreach (var permissionGroup in _allPermissions.GroupBy(p => p.Category))
                {
                    <div style="margin-bottom: 12px;">
                        <p style="font-weight: 600; margin: 0 0 8px 0; color: #212121;">@permissionGroup.Key</p>
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 8px;">
                            @foreach (var permission in permissionGroup)
                            {
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <RadzenCheckBox @bind-Value="_selectedPermissionIds[permission.PermissionId]" TValue="bool" />
                                    <label>@permission.PermissionName</label>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p>No permissions found.</p>
        }

        <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px;">
            <RadzenButton Text="Cancel" Variant="Variant.Text" Click="Cancel" Style="border-radius: 6px;" />
            <RadzenButton Text="@(_isEditMode ? "Save Changes" : "Create Role")" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" Icon="save" Style="background: #1976d2; border-radius: 6px; border: none;" />
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public Role? ExistingRole { get; set; }

    private RoleInputModel _roleModel = new();
    
    public class RoleInputModel
    {
        [Required(ErrorMessage = "Role name is required")]
        public string RoleName { get; set; } = "";
        
        public string Description { get; set; } = "";
    }
    private List<Permission> _allPermissions = new();
    private Dictionary<int, bool> _selectedPermissionIds = new();
    private bool _isEditMode => ExistingRole != null;

    protected override async Task OnInitializedAsync()
    {
        _allPermissions = await PermissionService.GetAllAsync();
        foreach (var p in _allPermissions)
        {
            _selectedPermissionIds.Add(p.PermissionId, false);
        }

        if (_isEditMode)
        {
            _roleModel.RoleName = ExistingRole!.RoleName;
            _roleModel.Description = ExistingRole.Description;

            var currentPermissions = await RolePermissionService.GetPermissionsForRoleAsync(ExistingRole.RoleId);
            foreach (var p in currentPermissions)
            {
                if (_selectedPermissionIds.ContainsKey(p.PermissionId))
                {
                    _selectedPermissionIds[p.PermissionId] = true;
                }
            }
        }
    }

    private async Task HandleSave()
    {
        try
        {
            Role savedRole;
            if (_isEditMode)
            {
                var roleToUpdate = new Role
                {
                    RoleId = ExistingRole!.RoleId,
                    RoleName = _roleModel.RoleName,
                    Description = _roleModel.Description,
                    CreatedAt = ExistingRole.CreatedAt,
                    CreatedBy = ExistingRole.CreatedBy,
                    UpdatedAt = DateTime.Now
                };
                await RoleService.UpdateAsync(roleToUpdate);
                savedRole = roleToUpdate;
                NotificationService.Notify(NotificationSeverity.Success, "Success", "Role updated successfully.");
            }
            else
            {
                var newRole = new Role
                {
                    RoleName = _roleModel.RoleName,
                    Description = _roleModel.Description,
                    CreatedAt = DateTime.Now
                };
                savedRole = await RoleService.CreateAsync(newRole);
                NotificationService.Notify(NotificationSeverity.Success, "Success", "Role created successfully.");
            }

            var grantedPermissionIds = _selectedPermissionIds.Where(kvp => kvp.Value).Select(kvp => kvp.Key).ToList();
            await RolePermissionService.AssignPermissionsAsync(savedRole.RoleId, grantedPermissionIds);

            DialogService.Close(true);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", $"An error occurred: {ex.Message}");
        }
    }

    private void Cancel()
    {
        DialogService.Close(false);
    }
}
