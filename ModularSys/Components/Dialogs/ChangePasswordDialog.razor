@using ModularSys.Core.Interfaces
@using Radzen
@using Radzen.Blazor
@using System.ComponentModel.DataAnnotations

@inject IUserService UserService
@inject NotificationService NotificationService
@inject DialogService DialogService

<EditForm Model="_model">
    <DataAnnotationsValidator />
    
    <RadzenStack Gap="1.5rem">
        <RadzenStack Gap="1rem">
            <RadzenFormField Text="Current Password" Variant="Variant.Outlined">
                <RadzenPassword @bind-Value="_model.CurrentPassword" 
                              Placeholder="Enter your current password"
                              Style="width: 100%;" />
                <ValidationMessage For="@(() => _model.CurrentPassword)" />
            </RadzenFormField>

            <RadzenFormField Text="New Password" Variant="Variant.Outlined">
                <RadzenPassword @bind-Value="_model.NewPassword" 
                              Placeholder="Enter new password (minimum 12 characters)"
                              Style="width: 100%;" />
                <ValidationMessage For="@(() => _model.NewPassword)" />
                @if (!string.IsNullOrEmpty(_model.NewPassword))
                {
                    <p style="margin: 8px 0 0 0; font-size: 0.875rem; color: #757575;">
                        Password strength: <strong>@GetPasswordStrength(_model.NewPassword)</strong>
                    </p>
                }
            </RadzenFormField>

            <RadzenFormField Text="Confirm New Password" Variant="Variant.Outlined">
                <RadzenPassword @bind-Value="_model.ConfirmPassword" 
                              Placeholder="Confirm new password"
                              Style="width: 100%;" />
                <ValidationMessage For="@(() => _model.ConfirmPassword)" />
            </RadzenFormField>
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
            <RadzenButton Text="Cancel" 
                         ButtonStyle="ButtonStyle.Light" 
                         Click="@Cancel" 
                         Disabled="@_saving" />
            <RadzenButton Text="Change Password" 
                         ButtonStyle="ButtonStyle.Primary" 
                         Click="@ChangePassword" 
                         IsBusy="@_saving" />
        </RadzenStack>
    </RadzenStack>
</EditForm>

@code {
    [Parameter] public int UserId { get; set; }

    private ChangePasswordModel _model = new();
    private bool _saving = false;

    private class ChangePasswordModel
    {
        [Required(ErrorMessage = "Current password is required")]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "New password is required")]
        [StringLength(100, MinimumLength = 12, ErrorMessage = "New password must be at least 12 characters")]
        public string NewPassword { get; set; } = string.Empty;

        [Compare("NewPassword", ErrorMessage = "Passwords do not match")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private string GetPasswordStrength(string password)
    {
        if (string.IsNullOrEmpty(password)) return "None";
        
        int strength = 0;
        if (password.Length >= 12) strength++;
        if (password.Length >= 16) strength++;
        if (password.Any(char.IsUpper)) strength++;
        if (password.Any(char.IsLower)) strength++;
        if (password.Any(char.IsDigit)) strength++;
        if (password.Any(c => !char.IsLetterOrDigit(c))) strength++;

        return strength switch
        {
            0 or 1 => "Weak",
            2 or 3 => "Fair",
            4 or 5 => "Good",
            _ => "Strong"
        };
    }

    private async Task ChangePassword()
    {
        // Validate model
        if (string.IsNullOrWhiteSpace(_model.CurrentPassword))
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", "Current password is required");
            return;
        }

        if (string.IsNullOrWhiteSpace(_model.NewPassword))
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", "New password is required");
            return;
        }

        if (_model.NewPassword.Length < 12)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", "New password must be at least 12 characters");
            return;
        }

        if (_model.NewPassword != _model.ConfirmPassword)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", "Passwords do not match");
            return;
        }

        if (_model.CurrentPassword == _model.NewPassword)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Warning", "New password must be different from current password");
            return;
        }

        _saving = true;
        try
        {
            var success = await UserService.ChangePasswordAsync(UserId, _model.CurrentPassword, _model.NewPassword);
            
            if (success)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Success", "Password changed successfully");
                DialogService.Close(true);
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Error, "Error", "Failed to change password. Current password may be incorrect.");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", $"Error: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel()
    {
        DialogService.Close(false);
    }
}
